BeginPackage["LogSeriesFoundations`"];
ClearAll[LogSeriesFoundations`verifyCertificates];
If[!ValueQ[LogSeriesFoundations`$LibraryMode], LogSeriesFoundations`$LibraryMode=False];
Begin["`Private`"];
Block[{AnalysisProof`$LibraryMode=True}, Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "capitulo_02", "analise_geral.wl"}]]];
certificateGzipBase64 = "";
LogSeriesFoundations`verifyCertificates[] := Module[{report,check,results={}},
report=AnalysisProof`verifyProofGraph[ImportString[ImportByteArray[BaseDecode[certificateGzipBase64], {"GZIP", "Text"}], "RawJSON"]];
If[!TrueQ[report["passed"]],Return[report]];
check[id_,formula_,hypotheses_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[report["targets"][id]["formula"]===formula && Sort[report["targets"][id]["hypotheses"]]===Sort[hypotheses]],"formula"->formula,"hypotheses"->hypotheses|>];
check["logarithm_series_decomposition","|- -u ( log ` ( 1 - A ) ) = ( sum_ k e. ( 1 ... ( M - 1 ) ) ( ( A ^ k ) / k ) + sum_ k e. ( ZZ>= ` M ) ( ( A ^ k ) / k ) )",{"|- 0 <_ A","|- A < 1","|- A e. RR","|- M e. NN"}];
check["logarithm_series_tail_nonnegative","|- 0 <_ sum_ k e. ( ZZ>= ` M ) ( ( A ^ k ) / k )",{"|- 0 <_ A","|- A < 1","|- A e. RR","|- M e. NN"}];
check["logarithm_series_tail_bound","|- sum_ k e. ( ZZ>= ` M ) ( ( A ^ k ) / k ) <_ ( ( A ^ M ) / ( 1 - A ) )",{"|- 0 <_ A","|- A < 1","|- A e. RR","|- M e. NN"}];
AssociateTo[report,<|"checks"->Length[results],"results"->results,"passed"->And@@Lookup[results,"passed"]|>];report];
If[!TrueQ[LogSeriesFoundations`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName], report=LogSeriesFoundations`verifyCertificates[]; Print[ExportString[KeyDrop[report,{"targets"}],"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]]];
End[];
EndPackage[];
