ClearAll["Global`*"];
results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
logUnit[x_,n_:24]:=Module[{z,v},If[!TrueQ[1<=x<=2&&n>=1],Throw["log domain"]];z=(x-1)/(x+1);v=2 Sum[z^(2k+1)/(2k+1),{k,0,n-1}];{v,v+2z^(2n+1)/(1-z^2)}];
logBounds[input_]:=Module[{x=input,k=0,v,l2},If[!TrueQ[x>0],Throw["log domain"]];While[x<1,x=2x;k--];While[x>2,x=x/2;k++];v=logUnit[x];l2=logUnit[2];If[k<0,{v[[1]]+k l2[[2]],v[[2]]+k l2[[1]]},v+k l2]];
coarse[{a_,b_},n_:10]:={Floor[a 10^n]/10^n,Ceiling[b 10^n]/10^n};
expBounds[x_,n_:16]:=Module[{v,e},If[!TrueQ[Abs[x]<=1&&n>=1],Throw["exp domain"]];v=Sum[x^k/k!,{k,0,n-1}];e=Abs[x]^n (n+1)/(n! n);{v-e,v+e}];
atanBounds[x_,n_:20]:=Module[{v,w},If[!TrueQ[0<=x<1],Throw["atan domain"]];v=Sum[(-1)^k x^(2k+1)/(2k+1),{k,0,n-1}];w=v+(-1)^n x^(2n+1)/(2n+1);{Min[v,w],Max[v,w]}];
a5=atanBounds[1/5];a239=atanBounds[1/239];piInterval={16a5[[1]]-4a239[[2]],16a5[[2]]-4a239[[1]]};sqrtPi={250662827463100/10^14,250662827463101/10^14};
check["F02_sqrt_two_pi_interval",sqrtPi[[1]]^2<2piInterval[[1]]<2piInterval[[2]]<sqrtPi[[2]]^2];
densityBounds[t_]:=Module[{v,sq,e},If[!TrueQ[t>0],Throw["density domain"]];v=coarse[logBounds[t]]+268/100;sq={If[v[[1]]<=0<=v[[2]],0,Min[v^2]],Max[v^2]};e=coarse[{-sq[[2]]/(2(59/100)^2),-sq[[1]]/(2(59/100)^2)}];{expBounds[e[[1]]][[1]]/(t (59/100) sqrtPi[[2]]),expBounds[e[[2]]][[2]]/(t (59/100) sqrtPi[[1]])}];
intPoly[a_,b_,n_:12]:=Sum[(-1/2)^k/k! (b^(2k+1)-a^(2k+1))/(2k+1),{k,0,n-1}];
za=(logBounds[3/100]+268/100)/(59/100);zb=(logBounds[14/100]+268/100)/(59/100);
outer={-1400945589/10^9,1209978210/10^9};inner={-1400945588/10^9,1209978209/10^9};
check["F02_transformed_limits",outer[[1]]<za[[1]]<za[[2]]<inner[[1]]<inner[[2]]<zb[[1]]<zb[[2]]<outer[[2]]];
epsilon=13/(12! 12);
lower=((intPoly@@inner)-(inner[[2]]-inner[[1]])epsilon)/sqrtPi[[2]];
upper=((intPoly@@outer)+(outer[[2]]-outer[[1]])epsilon)/sqrtPi[[1]];
check["F02_interval_domain",And@@Thread[Abs[Join[inner,outer]]<=141/100]&&(141/100)^2/2<1];
check["F02_area_rounding",8062405/10^7<lower<upper<8062415/10^7];
check["F02_empirical_eighty_percent_distinct",lower>4/5];
poly=Sum[(-1/2)^k/k! x^(2k),{k,0,11}];primitive=Sum[(-1/2)^k/k! x^(2k+1)/(2k+1),{k,0,11}];
check["F02_polynomial_antiderivative",Expand[D[primitive,x]-poly]==0];
check["F02_polynomial_matches_exponential_terms",Expand[poly-Sum[(-x^2/2)^k/k!,{k,0,11}]]==0];
grid=a+j(b-a)/n;
check["F02_grid_endpoints",Together[(grid/.j->0)-a]==0&&Together[(grid/.j->n)-b]==0];
check["F02_grid_step",Together[(grid/.j->j+1)-grid-(b-a)/n]==0];
intervals=<||>;partitions=<||>;
Do[nn=pair[[1]];vv=pair[[2]];step=(11/100)/nn;points=Table[3/100+j step,{j,1,nn}];heights=densityBounds /@ points;bounds=step Total[heights];AssociateTo[intervals,ToString[nn]->bounds];AssociateTo[partitions,ToString[nn]->(Last[points]==14/100&&Length[points]==nn&&And@@((3/100<#<=14/100)& /@ points))],{pair,{{4,6941/10000},{8,7572/10000},{32,7953/10000}}}];
check["F02_right_sum_4",6941/10000-1/20000<intervals["4"][[1]]<intervals["4"][[2]]<6941/10000+1/20000];
check["F02_partition_4",partitions["4"]];
check["F02_right_sum_8",7572/10000-1/20000<intervals["8"][[1]]<intervals["8"][[2]]<7572/10000+1/20000];
check["F02_partition_8",partitions["8"]];
check["F02_right_sum_32",7953/10000-1/20000<intervals["32"][[1]]<intervals["32"][[2]]<7953/10000+1/20000];
check["F02_partition_32",partitions["32"]];
check["F02_displayed_errors_decrease",intervals["4"][[2]]<intervals["8"][[1]]<intervals["8"][[2]]<intervals["32"][[1]]<intervals["32"][[2]]<lower];
report=<|"backend"->"Wolfram exact interval certificates","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
