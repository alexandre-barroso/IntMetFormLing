InformationProof`runAsScript=!TrueQ[InformationProof`$LibraryMode];
Begin["InformationProof`"];
ProbabilityProof`$LibraryMode=True;
Get[FileNameJoin[{DirectoryName[$InputFileName],"..","capitulo_07","probabilidade_geral.wl"}]];
Block[{InformationFoundations`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"fundamentos_informacao.wl"}]]];
informationData=ImportString[ImportByteArray[BaseDecode[""],{"GZIP","Text"}],"RawJSON"];
informationAnalyticResult=.;
informationAnalyticBridge[name_]:=Module[{expected,actual},
 If[!KeyExistsQ[informationData["analytic_interfaces"],name],ProbabilityProof`pgFail["unknown analytic bridge"]];
 If[!AssociationQ[informationAnalyticResult],informationAnalyticResult=InformationFoundations`verifyCertificates[]];
 If[!TrueQ[informationAnalyticResult["passed"]],ProbabilityProof`pgFail["analytic proof graph rejected"]];
 expected=informationData["analytic_expected"][name];actual=informationAnalyticResult["targets"][name];
 If[actual["formula"]=!=expected["formula"]||Sort[actual["hypotheses"]]=!=Sort[expected["hypotheses"]],ProbabilityProof`pgFail["analytic bridge formula or hypotheses"]];
 <|"assumptions"->{},"conclusion"->informationData["analytic_interfaces"][name]|>];
ProbabilityProof`pgInfer[kernel_,{"analytic",name_},environment_:<||>]:=InformationProof`informationAnalyticBridge[name];
informationKernel[]:=Module[{kernel=ProbabilityProof`pgKernel[informationData["axioms"]]},Do[ProbabilityProof`pgTheorem[kernel,record[[1]],record[[2]],record[[3]]],{record,informationData["proofs"]}];kernel];
informationVerify[]:=Module[{kernel=informationKernel[],checks=<||>,record,formula,changed,replay,mutated,twiceHead,rejected=False},
 Do[AssociateTo[checks,name->ProbabilityProof`pgCertified[kernel,name,informationData["interfaces"][name]]],{name,Keys[informationData["interfaces"]]}];
 Do[record=ProbabilityProof`pgRecord[kernel,name];formula=record[[2]];
 changed=With[{replacement=Function[t,If[MemberQ[{"all","imp"},First[t]],{First[t],t[[2]],#0[t[[3]]]},If[First[t]==="eq",ProbabilityProof`pgEq[t[[2]],ProbabilityProof`pgC["zero_real","R"]],ProbabilityProof`pgEq[ProbabilityProof`pgC["one_real","R"],ProbabilityProof`pgC["zero_real","R"]]]]]},replacement[formula]];
 AssociateTo[checks,name<>"_false_target_rejected"->ProbabilityProof`pgRejects[ProbabilityProof`pgTheorem[kernel,name<>"_mutated",changed,record[[3]]]]],{name,{"finite_joint_mutual_information_nonnegative","color_expected_KL_equals_information_loss_bits"}}];
 twiceHead[t_]:=If[First[t]==="eq",With[{left=t[[2]],right=t[[3]],value=t[[3,2,3]],add=ProbabilityProof`pgC["real_add",ProbabilityProof`pgFT["R",ProbabilityProof`pgFT["R","R"]]]},ProbabilityProof`pgEq[left,ProbabilityProof`pgA[add,ProbabilityProof`pgA[add,value,value],right[[3]]]]],{First[t],t[[2]],twiceHead[t[[3]]]}];
 mutated=Join[informationData["axioms"],<|"sum_cons_M"->twiceHead[informationData["axioms"]["sum_cons_M"]]|>];replay=ProbabilityProof`pgKernel[mutated];
 Do[If[ProbabilityProof`pgRejects[ProbabilityProof`pgTheorem[replay,record[[1]],record[[2]],record[[3]]]],rejected=True;Break[]],{record,informationData["proofs"]}];
 AssociateTo[checks,"sum_recurrence_mutation_rejected"->rejected];If[!And@@Values[checks],ProbabilityProof`pgFail[checks]];
 <|"backend"->"Wolfram/independent typed natural deduction","proved"->Keys[kernel["verified"]],"checks"->checks,"analytic_foundations_verified"->True,"passed"->True,"foundational_axioms"->Keys[kernel["axioms"]]|>];
If[TrueQ[InformationProof`runAsScript],informationResult=Catch[informationVerify[],"ProbabilityKernelError",Function[{value,tag},<|"error"->ToString[value,InputForm],"passed"->False|>]];check[name_,condition_]:=If[!TrueQ[condition],ProbabilityProof`pgFail[{"catalogue assertion failed",name}]];
check["log_positive_quotient",MemberQ[informationResult["proved"],"log_positive_quotient"]];
check["log_positive_product",MemberQ[informationResult["proved"],"log_positive_product"]];
check["log_two_positive",MemberQ[informationResult["proved"],"log_two_positive"]];
