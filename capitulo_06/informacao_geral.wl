check["fixed_source_weak_distortion_information_order",MemberQ[informationResult["proved"],"fixed_source_weak_distortion_information_order"]];
Print[ExportString[informationResult,"RawJSON"]];Exit[If[TrueQ[informationResult["passed"]],0,1]]];
End[];
