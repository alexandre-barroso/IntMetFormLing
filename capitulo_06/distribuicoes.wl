results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
jointInformationTerm[p_,q_,w_]:=If[TrueQ[p*q==0],0,Piecewise[{{0,p*q==0}},p*q*Log[2,(p*q)/(p*w)]]];
conditionalInformationTerm[p_,q_,w_]:=If[TrueQ[p*q==0],0,Piecewise[{{0,p*q==0}},p*q*Log[2,q/w]]];
check["weighted_information_term",FullSimplify[jointInformationTerm[p,q,w]==conditionalInformationTerm[p,q,w],p>=0&&q>=0&&w>0]];
check["weighted_information_zero_terms",jointInformationTerm[0,q,w]==0&&conditionalInformationTerm[0,q,w]==0&&jointInformationTerm[p,0,w]==0&&conditionalInformationTerm[p,0,w]==0];
check["weighted_information_zero_column",jointInformationTerm[p,0,0]==0&&conditionalInformationTerm[p,0,0]==0&&jointInformationTerm[0,q,0]==0&&conditionalInformationTerm[0,q,0]==0];
summandDifference[i_,j_]:=FullSimplify[jointInformationTerm[probabilities[i],conditionals[i,j],marginals[j]]-conditionalInformationTerm[probabilities[i],conditionals[i,j],marginals[j]],probabilities[i]>=0&&conditionals[i,j]>=0&&marginals[j]>0];
check["weighted_information_sum",FullSimplify[Sum[summandDifference[i,j],{i,1,m},{j,1,n}]==0,Element[{m,n},Integers]&&m>=0&&n>=0]];
check["pattern_grouped_products",FullSimplify[Product[pp,{i,1,successes}]*Product[qq,{i,1,failures}]==pp^successes*qq^failures&&successes+failures-successes==failures,Element[{successes,failures},Integers]&&successes>=0&&failures>=0&&pp>0&&qq>0]];
check["pattern_reordering_laws",Expand[pp*qq-qq*pp]==0&&Expand[(pp*qq)*w-pp*(qq*w)]==0];
check["pattern_empty_products",Product[pp,{i,1,0}]==1&&Product[qq,{i,1,0}]==1];
check["pattern_boundary_products",FullSimplify[Product[0,{i,1,positiveCount}]==0&&Product[1,{i,1,positiveCount}]==1,Element[positiveCount,Integers]&&positiveCount>0]&&Product[0,{i,1,0}]==1];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
