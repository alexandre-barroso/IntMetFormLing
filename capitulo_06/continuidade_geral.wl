BeginPackage["LognormalConvergence`"];
ClearAll[LognormalConvergence`verifyCertificates];
If[!ValueQ[LognormalConvergence`$LibraryMode],LognormalConvergence`$LibraryMode=False];
Begin["`Private`"];
Block[{LognormalProof`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"continuidade_base.wl"}]]];
Block[{RiemannProof`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"..","capitulo_02","riemann_geral.wl"}]]];
fail[x_]:=Throw[<|"passed"->False,"error"->x|>,"LognormalFailure"];
vr[x_]:={"var",x};
aa=vr["a"];bb=vr["b"];ff=vr["f"];mm=vr["mean"];ss=vr["scale"];
densityTerm={"lognormal_restriction",mm,ss,aa,bb};
expectedDensity="( ( exp ` ( ( 0 - ( ( ( ( log ` x ) - M ) / S ) ^ 2 ) ) / 2 ) ) / ( x x. ( S x. ( sqrt ` ( 2 x. _pi ) ) ) ) )";
expectedFunction="( x e. ( A [,] B ) |-> "<>expectedDensity<>" )";
expectedContinuity="|- "<>expectedFunction<>" e. ( ( A [,] B ) -cn-> CC )";
expectedHypotheses=Sort[{"|- A e. RR+","|- B e. RR","|- M e. RR","|- S e. RR+"}];
continuousTerm={"continuous",densityTerm,aa,bb};
rawScope[raw_]:=TrueQ[raw["formula"]===expectedContinuity && Sort[raw["hypotheses"]]===expectedHypotheses];
LognormalConvergence`verifyCertificates[]:=Catch[Module[{results={},check,raw,graph,nodes,source,target,newTarget,conditional,required,translated,available,formula,parameters,values,value,valid,figureFormula,x,m,s,t,z,bad},
 check[id_,ok_,f_:Null,h_:{}]:=If[TrueQ[ok],AppendTo[results,<|"id"->id,"passed"->True,"formula"->f,"hypotheses"->h|>],fail[id]];
 raw=LognormalProof`verifyCertificates[];
 If[!TrueQ[raw["passed"]],fail[raw]];
 check["lognormal_continuous_on_every_positive_compact_interval",rawScope[raw["targets"]["density_continuity"]],expectedContinuity,expectedHypotheses];
 check["positive_endpoint_real_bridge",raw["targets"]["positive_endpoint_real"]["formula"]==="|- A e. RR" && raw["targets"]["positive_endpoint_real"]["hypotheses"]==={"|- A e. RR+"}];
 RiemannProof`Private`rawGraph=ImportString[ImportByteArray[BaseDecode[RiemannProof`Private`rawGraphGzipBase64],{"GZIP","Text"}],"RawJSON"];
 RiemannProof`Private`rawGraphResult=RiemannProof`verifyProofGraph[RiemannProof`Private`rawGraph];
 If[!TrueQ[RiemannProof`Private`rawGraphResult["passed"]],fail[RiemannProof`Private`rawGraphResult]];
 graph=ImportString[ImportByteArray[BaseDecode[RiemannProof`Private`analyticGraphGzipBase64],{"GZIP","Text"}],"RawJSON"];
 source=graph["targets"]["displayed_sum_limit"];
 If[source["formula"]=!=RiemannProof`Private`expectedRiemannFormula[] || Sort[source["hypotheses"]]=!=RiemannProof`Private`globalFacts,fail["riemann_source_scope"]];
 nodes=graph["nodes"];target=source["node"];
 AppendTo[nodes,{"imp",{"continuous",ff,aa,bb},target}];target=Length[nodes]-1;
 AppendTo[nodes,{"all","f",target}];target=Length[nodes]-1;
 AppendTo[nodes,{"instantiate",target,densityTerm}];target=Length[nodes]-1;
 formula=RiemannProof`Private`subF[RiemannProof`Private`expectedRiemannFormula[],"f",densityTerm];
 required=Complement[RiemannProof`Private`globalFacts,{{"continuous",ff,aa,bb}}];
 newTarget=<|"node"->target,"formula"->{"imp",continuousTerm,formula},"hypotheses"->required|>;
 AssociateTo[graph,{"nodes"->nodes,"targets"-><|"instantiated"->newTarget|>}];
 conditional=RiemannProof`verifyAnalyticGraph[graph];
 If[!TrueQ[conditional["passed"]],fail[conditional]];
 conditional=conditional["targets"]["instantiated"];
 translated=Sort[{{"positive",aa},{"real",bb},{"real",mm},{"positive",ss}}];
 available=Union[translated,{{"real",aa},{"lt",aa,bb}}];
 If[Complement[required,available]=!={},fail["undischarged_riemann_hypothesis"]];
 If[conditional["formula"]=!={"imp",continuousTerm,formula},fail["riemann_modus_ponens"]];
 translated=Union[translated,{{"lt",aa,bb}}];
 check["lognormal_right_riemann_limit_general",True,formula,translated];
 parameters=<|"a"->3/100,"b"->7/50,"mean"->-67/25,"scale"->59/100|>;
 value[term_]:=If[First[term]==="var" && KeyExistsQ[parameters,term[[2]]],parameters[term[[2]]],fail["rational_parameter"]];
 Do[valid=Switch[First[premise],"real",MatchQ[value[premise[[2]]],_Integer|_Rational],"positive",value[premise[[2]]]>0,"lt",value[premise[[2]]]<value[premise[[3]]],_,False];If[!TrueQ[valid],fail["rational_domain_obligation"]],{premise,translated}];
 figureFormula=formula;
 KeyValueMap[(figureFormula=RiemannProof`Private`subF[figureFormula,#1,{"rational",Numerator[#2],Denominator[#2]}])&,parameters];
 If[RiemannProof`Private`freeF[figureFormula]=!={},fail["unbound_parameter_after_specialization"]];
 check["density_expression_identity",Together[-((x-m)/s)^2/2+(x-m)^2/(2*s^2)]===0 && Together[1/(t*(s*z))-1/(t*s*z)]===0 && Expand[(x-m)/.m->-67/25]===x+268/100];
 check["lognormal_right_riemann_limit_parameters",True,figureFormula,{}];
 bad=raw["targets"]["density_continuity"];AssociateTo[bad,"formula"->StringReplace[bad["formula"]," / 2 "->" / 3 "]];
 check["changed_exponent_cannot_reuse_continuity",!rawScope[bad]];
 bad=raw["targets"]["density_continuity"];AssociateTo[bad,"hypotheses"->{expectedContinuity}];
 check["assumed_continuity_cannot_replace_proof",!rawScope[bad]];
 check["singleton_integral_zero_general",raw["targets"]["singleton_integral"]["formula"]==="|- ( ( x e. { A } |-> ( F ` x ) ) e. L^1 /\\ S. { A } ( F ` x ) _d x = 0 )" && Sort[raw["targets"]["singleton_integral"]["hypotheses"]]===Sort[{"|- A e. RR","|- F : RR --> RR"}]];
 <|"passed"->True,"checks"->Length[results],"results"->results|>
],"LognormalFailure"];
If[!TrueQ[LognormalConvergence`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName],
 report=LognormalConvergence`verifyCertificates[];Print[ExportString[report,"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]];
];
End[];
EndPackage[];
