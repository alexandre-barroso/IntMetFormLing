BeginPackage["LognormalProof`"];
ClearAll[LognormalProof`verifyCertificates];
If[!ValueQ[LognormalProof`$LibraryMode], LognormalProof`$LibraryMode=False];
Begin["`Private`"];
Block[{AnalysisProof`$LibraryMode=True}, Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "capitulo_02", "analise_geral.wl"}]]];
certificateGzipBase64 = "";
LognormalProof`verifyCertificates[] := Module[{report,check,results={}},
report=AnalysisProof`verifyProofGraph[ImportString[ImportByteArray[BaseDecode[certificateGzipBase64], {"GZIP", "Text"}], "RawJSON"]];
If[!TrueQ[report["passed"]],Return[report]];
check[id_,formula_,hypotheses_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[report["targets"][id]["formula"]===formula && Sort[report["targets"][id]["hypotheses"]]===Sort[hypotheses]],"formula"->formula,"hypotheses"->hypotheses|>];
check["density_continuity","|- ( x e. ( A [,] B ) |-> ( ( exp ` ( ( 0 - ( ( ( ( log ` x ) - M ) / S ) ^ 2 ) ) / 2 ) ) / ( x x. ( S x. ( sqrt ` ( 2 x. _pi ) ) ) ) ) ) e. ( ( A [,] B ) -cn-> CC )",{"|- A e. RR+","|- B e. RR","|- M e. RR","|- S e. RR+"}];
check["singleton_integral","|- ( ( x e. { A } |-> ( F ` x ) ) e. L^1 /\\ S. { A } ( F ` x ) _d x = 0 )",{"|- A e. RR","|- F : RR --> RR"}];
check["positive_endpoint_real","|- A e. RR",{"|- A e. RR+"}];
AssociateTo[report,{"checks"->Length[results],"results"->results,"passed"->And@@Lookup[results,"passed"]}];report];
If[!TrueQ[LognormalProof`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName], report=LognormalProof`verifyCertificates[]; Print[ExportString[KeyDrop[report,{"targets"}],"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]]];
End[];
EndPackage[];
