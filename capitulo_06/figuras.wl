ClearAll["Global`*"];
results={};
check[id_,value_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[value]|>];
density[t_]:=Exp[-(Log[t]+268/100)^2/(2*(59/100)^2)]/(t*(59/100)*Sqrt[2 Pi]);
check["density_endpoints",And@@(Abs[N[density[#[[1]]],80]-#[[2]]]<1/2000000&/@{{3/100,8447984/1000000},{14/100,2322823/1000000}})];
check["density_nonnegative",FullSimplify[density[t]>0,t>0]];
check["shaded_interval",0<3/100<14/100<8/10];
check["lognormal_model",FullSimplify[density[t]==PDF[LogNormalDistribution[-268/100,59/100],t],t>0]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->AllTrue[results,TrueQ[#["passed"]]&],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[TrueQ[report["passed"]],0,1]];
