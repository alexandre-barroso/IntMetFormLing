Begin["AreaIntervals`"];
Block[{$ContextPath={"System`"},AreaFoundations`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"fundamentos_area.wl"}]]];
Block[{$ContextPath={"System`"},LogSeriesFoundations`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"fundamentos_log.wl"}]]];
Block[{$ContextPath={"System`"},PiFoundations`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"fundamentos_pi.wl"}]]];
Block[{$ContextPath={"System`"},PolynomialIntegration`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"integracao_polinomial.wl"}]]];
Block[{$ContextPath={"System`"},InformationFoundations`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"fundamentos_informacao.wl"}]]];
Block[{$ContextPath={"System`"},LognormalSubstitution`$LibraryMode=True},Get[FileNameJoin[{DirectoryName[$InputFileName],"substituicao_geral.wl"}]]];
fail[value_]:=Throw[value,"IntervalCertificateError"];
rationalQ[value_]:=IntegerQ[value]||Head[value]===Rational;
valid[value_]:=ListQ[value]&&Length[value]===2&&And@@(rationalQ/@value)&&value[[1]]<=value[[2]];
iv[value_]:=If[valid[value],value,If[rationalQ[value],{value,value},fail["invalid rational interval"]]];
iadd[left_,right_]:=With[{x=iv[left],y=iv[right]},{x[[1]]+y[[1]],x[[2]]+y[[2]]}];
ineg[value_]:=With[{x=iv[value]},{-x[[2]],-x[[1]]}];
isub[left_,right_]:=iadd[left,ineg[right]];
imul[left_,right_]:=With[{values=Flatten[Outer[Times,iv[left],iv[right]]]},{Min[values],Max[values]}];
idiv[left_,right_]:=Module[{y=iv[right]},If[y[[1]]<=0<=y[[2]],fail["division interval contains zero"]];imul[left,{1/y[[2]],1/y[[1]]}]];
ipow[value_,n_]:=If[!IntegerQ[n]||n<0,fail["natural exponent required"],Nest[imul[#,value]&,{1,1},n]];
isquare[value_]:=With[{x=iv[value]},{If[x[[1]]<=0<=x[[2]],0,Min[x[[1]]^2,x[[2]]^2]],Max[x[[1]]^2,x[[2]]^2]}];
coarse[value_,digits_:12]:=With[{x=iv[value],scale=10^digits},{Floor[scale*x[[1]]]/scale,Ceiling[scale*x[[2]]]/scale}];
logUnit[value_,n_:48]:=Module[{q,p,e},If[!rationalQ[value]||!1<=value<=2||!IntegerQ[n]||n<1,fail["logarithm series domain"]];q=1-1/value;If[!0<=q<=1/2||1-q=!=1/value,fail["logarithm reciprocal substitution"]];p=Sum[q^k/k,{k,1,n}];e=q^(n+1)/(1-q);{p,p+e}];
logRescaling[value_]:=Module[{u=value,k=0,steps={},old},If[!rationalQ[value]||value<=0,fail["positive logarithm argument required"]];While[u<1,old=u;u=2*u;k--;If[!old>0||u=!=2*old||u*2^k=!=value,fail["positive logarithm product step"]];AppendTo[steps,<|"before"->ToString[old,InputForm],"after"->ToString[u,InputForm],"log_two_coefficient"->-1,"law"->"log_positive_product"|>]];While[u>2,old=u;u=u/2;k++;If[!u>0||old=!=2*u||u*2^k=!=value,fail["positive logarithm quotient step"]];AppendTo[steps,<|"before"->ToString[old,InputForm],"after"->ToString[u,InputForm],"log_two_coefficient"->1,"law"->"log_positive_quotient"|>]];If[u*2^k=!=value||Total[Lookup[steps,"log_two_coefficient",{}]]=!=k,fail["logarithm rescaling identity"]];{u,k,steps}];
logBound[value_]:=Module[{trace=logRescaling[value]},coarse[iadd[logUnit[trace[[1]]],imul[logUnit[2],trace[[2]]]]]];
expPoint[value_,n_:16]:=Module[{p,e},If[!rationalQ[value]||Abs[value]>1||!IntegerQ[n]||n<1,fail["exponential remainder domain"]];p=Sum[value^k/k!,{k,0,n-1}];e=Abs[value]^n*(n+1)/(n!*n);{p-e,p+e}];
expBound[value_]:=Module[{x=coarse[value]},If[x[[1]]< -1||x[[2]]>1,fail["exponential interval outside certified domain"]];{expPoint[x[[1]]][[1]],expPoint[x[[2]]][[2]]}];
atanBound[value_,n_:64]:=Module[{p,e},If[!rationalQ[value]||!0<=value<1||!IntegerQ[n]||n<0,fail["arctangent remainder domain"]];p=Sum[(-1)^k*value^(2*k+1)/(2*k+1),{k,0,n-1}];e=value^n/(1-value);{p-e,p+e}];
normalizerBound[]:=normalizerBound[]=Module[{pi=imul[iadd[atanBound[1/2],atanBound[1/3]],4],result={250662827463100/10^14,250662827463101/10^14}},If[!0<result[[1]]||!result[[1]]^2<2*pi[[1]]<=2*pi[[2]]<result[[2]]^2,fail["positive square-root enclosure"]];result];
densityBound[value_]:=Module[{z,e},If[!rationalQ[value]||value<=0,fail["positive density argument required"]];z=idiv[iadd[logBound[value],67/25],59/100];e=idiv[ineg[isquare[z]],2];idiv[expBound[e],imul[imul[value,59/100],normalizerBound[]]]];
primitive[value_,n_:12]:=Fold[iadd,{0,0},Table[imul[ipow[value,2*k+1],(-1/2)^k/(k!*(2*k+1))],{k,0,n-1}]];
gaussianAreaBound[lower_,upper_,n_:12]:=Module[{l=iv[lower],u=iv[upper],domain,exponent,tail,width,p},If[!IntegerQ[n]||n<1,fail["positive polynomial truncation order required"]];If[l[[2]]>u[[1]],fail["endpoint order not certified"]];domain={l[[1]],u[[2]]};exponent=idiv[ineg[isquare[domain]],2];If[exponent[[1]]< -1||exponent[[2]]>1,fail["uniform exponential remainder domain"]];tail=(n+1)/(n!*n);width=u[[2]]-l[[1]];p=isub[primitive[u,n],primitive[l,n]];iadd[p,{-width*tail,width*tail}]];
expectedAnalyticalInterfaces=ImportString["{\"exponential_series_decomposition\":{\"formula\":\"|- ( exp ` A ) = ( sum_ k e. ( 0 ... ( M - 1 ) ) ( ( n e. NN0 |-> ( ( A ^ n ) / ( ! ` n ) ) ) ` k ) + sum_ k e. ( ZZ>= ` M ) ( ( n e. NN0 |-> ( ( A ^ n ) / ( ! ` n ) ) ) ` k ) )\",\"hypotheses\":[\"|- A e. CC\",\"|- M e. NN\"]},\"exponential_series_tail_bound\":{\"formula\":\"|- ( abs ` sum_ k e. ( ZZ>= ` M ) ( ( n e. NN0 |-> ( ( A ^ n ) / ( ! ` n ) ) ) ` k ) ) <_ ( ( ( abs ` A ) ^ M ) x. ( ( M + 1 ) / ( ( ! ` M ) x. M ) ) )\",\"hypotheses\":[\"|- ( abs ` A ) <_ 1\",\"|- A e. CC\",\"|- M e. NN\"]},\"logarithm_series_decomposition\":{\"formula\":\"|- -u ( log ` ( 1 - A ) ) = ( sum_ k e. ( 1 ... ( M - 1 ) ) ( ( A ^ k ) / k ) + sum_ k e. ( ZZ>= ` M ) ( ( A ^ k ) / k ) )\",\"hypotheses\":[\"|- 0 <_ A\",\"|- A < 1\",\"|- A e. RR\",\"|- M e. NN\"]},\"logarithm_series_tail_nonnegative\":{\"formula\":\"|- 0 <_ sum_ k e. ( ZZ>= ` M ) ( ( A ^ k ) / k )\",\"hypotheses\":[\"|- 0 <_ A\",\"|- A < 1\",\"|- A e. RR\",\"|- M e. NN\"]},\"logarithm_series_tail_bound\":{\"formula\":\"|- sum_ k e. ( ZZ>= ` M ) ( ( A ^ k ) / k ) <_ ( ( A ^ M ) / ( 1 - A ) )\",\"hypotheses\":[\"|- 0 <_ A\",\"|- A < 1\",\"|- A e. RR\",\"|- M e. NN\"]},\"arctangent_addition_one\":{\"formula\":\"|- ( ( arctan ` A ) + ( arctan ` B ) ) = ( _pi / 4 )\",\"hypotheses\":[\"|- ( ( A + B ) / ( 1 - ( A x. B ) ) ) = 1\",\"|- ( A x. B ) =/= 1\",\"|- 0 < A\",\"|- 0 < B\",\"|- A < 1\",\"|- A e. RR\",\"|- B < 1\",\"|- B e. RR\"]},\"pi_two_arctangents\":{\"formula\":\"|- ( 4 x. ( ( arctan ` ( 1 / 2 ) ) + ( arctan ` ( 1 / 3 ) ) ) ) = _pi\",\"hypotheses\":[]},\"arctangent_series_decomposition\":{\"formula\":\"|- ( arctan ` A ) = ( sum_ k e. ( 0 ... ( M - 1 ) ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) ) + sum_ k e. ( ZZ>= ` M ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) ) )\",\"hypotheses\":[\"|- 0 <_ A\",\"|- A < 1\",\"|- A e. RR\",\"|- M e. NN0\"]},\"arctangent_series_tail_lower\":{\"formula\":\"|- ( -u 1 x. ( ( A ^ M ) / ( 1 - A ) ) ) <_ sum_ k e. ( ZZ>= ` M ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) )\",\"hypotheses\":[\"|- 0 <_ A\",\"|- A < 1\",\"|- A e. RR\",\"|- M e. NN0\"]},\"arctangent_series_tail_upper\":{\"formula\":\"|- sum_ k e. ( ZZ>= ` M ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) ) <_ ( ( A ^ M ) / ( 1 - A ) )\",\"hypotheses\":[\"|- 0 <_ A\",\"|- A < 1\",\"|- A e. RR\",\"|- M e. NN0\"]},\"gaussian_normalizer_positive\":{\"formula\":\"|- 0 < ( sqrt ` ( 2 x. _pi ) )\",\"hypotheses\":[]},\"gaussian_normalizer_real\":{\"formula\":\"|- ( sqrt ` ( 2 x. _pi ) ) e. RR\",\"hypotheses\":[]},\"gaussian_normalizer_square\":{\"formula\":\"|- ( ( sqrt ` ( 2 x. _pi ) ) ^ 2 ) = ( 2 x. _pi )\",\"hypotheses\":[]},\"finite_polynomial_integrable\":{\"formula\":\"|- ( x e. ( A [,] B ) |-> sum_ k e. I ( ( F ` k ) x. ( x ^ k ) ) ) e. L^1\",\"hypotheses\":[\"|- A e. RR\",\"|- B e. RR\",\"|- F : I --> CC\",\"|- I C_ NN0\",\"|- I e. Fin\"]},\"finite_polynomial_integral\":{\"formula\":\"|- S. ( A [,] B ) sum_ k e. I ( ( F ` k ) x. ( x ^ k ) ) _d x = sum_ k e. I ( ( F ` k ) x. ( ( ( B ^ ( k + 1 ) ) - ( A ^ ( k + 1 ) ) ) / ( k + 1 ) ) )\",\"hypotheses\":[\"|- A <_ B\",\"|- A e. RR\",\"|- B e. RR\",\"|- F : I --> CC\",\"|- I C_ NN0\",\"|- I e. Fin\"]},\"integral_approximation_sandwich\":{\"formula\":\"|- ( ( S. ( A [,] B ) ( F ` x ) _d x - ( E x. ( B - A ) ) ) <_ S. ( A [,] B ) ( G ` x ) _d x /\\\\ S. ( A [,] B ) ( G ` x ) _d x <_ ( S. ( A [,] B ) ( F ` x ) _d x + ( E x. ( B - A ) ) ) )\",\"hypotheses\":[\"|- ( x e. ( A [,] B ) |-> ( F ` x ) ) e. L^1\",\"|- ( x e. ( A [,] B ) |-> ( G ` x ) ) e. L^1\",\"|- A <_ B\",\"|- A e. RR\",\"|- A. x e. ( A [,] B ) ( ( ( F ` x ) e. RR /\\\\ ( G ` x ) e. RR ) /\\\\ ( ( ( F ` x ) - E ) <_ ( G ` x ) /\\\\ ( G ` x ) <_ ( ( F ` x ) + E ) ) )\",\"|- B e. RR\",\"|- E e. RR\"]},\"gaussian_continuous\":{\"formula\":\"|- ( x e. ( A [,] B ) |-> ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) ) e. ( ( A [,] B ) -cn-> CC )\",\"hypotheses\":[\"|- A e. RR\",\"|- B e. RR\"]},\"gaussian_integrable\":{\"formula\":\"|- ( x e. ( A [,] B ) |-> ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) ) e. L^1\",\"hypotheses\":[\"|- A e. RR\",\"|- B e. RR\"]},\"gaussian_normalizer_outside_integral\":{\"formula\":\"|- S. ( A [,] B ) ( ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) _d x = ( ( 1 / ( sqrt ` ( 2 x. _pi ) ) ) x. S. ( A [,] B ) ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) _d x )\",\"hypotheses\":[\"|- A e. RR\",\"|- B e. RR\"]},\"gaussian_standard_form_integral\":{\"formula\":\"|- S. ( A [,] B ) ( ( exp ` ( ( 0 - ( x ^ 2 ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) _d x = ( ( 1 / ( sqrt ` ( 2 x. _pi ) ) ) x. S. ( A [,] B ) ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) _d x )\",\"hypotheses\":[\"|- A e. RR\",\"|- B e. RR\"]},\"lognormal_change_of_variables\":{\"formula\":\"|- S. ( A [,] B ) ( ( exp ` ( ( 0 - ( ( ( ( log ` x ) - M ) / S ) ^ 2 ) ) / 2 ) ) / ( x x. ( S x. ( sqrt ` ( 2 x. _pi ) ) ) ) ) _d x = S. ( ( ( ( log ` A ) - M ) / S ) [,] ( ( ( log ` B ) - M ) / S ) ) ( ( exp ` ( ( 0 - ( u ^ 2 ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) _d u\",\"hypotheses\":[\"|- A <_ B\",\"|- A e. RR+\",\"|- B e. RR\",\"|- M e. RR\",\"|- S e. RR+\"]},\"log_positive_quotient\":{\"formula\":\"|- ( log ` ( A / B ) ) = ( ( log ` A ) - ( log ` B ) )\",\"hypotheses\":[\"|- A e. RR+\",\"|- B e. RR+\"]},\"log_positive_product\":{\"formula\":\"|- ( log ` ( A x. B ) ) = ( ( log ` A ) + ( log ` B ) )\",\"hypotheses\":[\"|- A e. RR+\",\"|- B e. RR+\"]},\"log_two_positive\":{\"formula\":\"|- 0 < ( log ` ( 1 + 1 ) )\",\"hypotheses\":[]},\"log_one_zero\":{\"formula\":\"|- ( log ` 1 ) = 0\",\"hypotheses\":[]},\"log_mean_value\":{\"formula\":\"|- E. x e. ( A (,) B ) ( 1 / x ) = ( ( ( log ` B ) - ( log ` A ) ) / ( B - A ) )\",\"hypotheses\":[\"|- A < B\",\"|- A e. RR+\",\"|- B e. RR\"]},\"exponential_increasing\":{\"formula\":\"|- ( ( A e. RR /\\\\ B e. RR ) -> ( A < B <-> ( exp ` A ) < ( exp ` B ) ) )\",\"hypotheses\":[]},\"real_exponential_positive\":{\"formula\":\"|- ( A e. RR -> ( exp ` A ) e. RR+ )\",\"hypotheses\":[]}}","RawJSON"];
validAnalyticalInterfaces[targets_]:=AssociationQ[targets]&&Sort[Keys[targets]]===Sort[Keys[expectedAnalyticalInterfaces]]&&And@@KeyValueMap[targets[#1]["formula"]===#2["formula"]&&Sort[targets[#1]["hypotheses"]]===Sort[#2["hypotheses"]]&,expectedAnalyticalInterfaces];
rejectedAnalyticalMutations[targets_,field_]:=And@@Table[Module[{changed=targets,row=targets[name]},Switch[field,"formula",AssociateTo[row,"formula"->"|- 0 = 1"],"hypotheses",AssociateTo[row,"hypotheses"->If[Length[row["hypotheses"]]>0,Rest[row["hypotheses"]],{"|- 0 = 1"}]],_,fail["unknown analytical interface field"]];AssociateTo[changed,name->row];!TrueQ[validAnalyticalInterfaces[changed]]],{name,Keys[targets]}];
foundations[]:=Module[{reports,targets,expected,x,polynomial,prefix,substitution},
 reports={AreaFoundations`verifyCertificates[],LogSeriesFoundations`verifyCertificates[],PiFoundations`verifyCertificates[],PolynomialIntegration`verifyCertificates[],InformationFoundations`verifyCertificates[]};
 If[!And@@(TrueQ[#["passed"]]&/@reports),fail["analytical proof graph rejected"]];
 targets=Join@@Lookup[reports,"targets"];
 substitution=LognormalSubstitution`verifyCertificates[];If[!TrueQ[substitution["passed"]],fail["lognormal substitution proof rejected"]];
 targets=Join[targets,KeyTake[substitution["targets"],{"lognormal_change_of_variables"}]];
 targets=Join[targets,<|"exponential_increasing"-><|"formula"->AnalysisProof`verifiedTheorem["eflt"]["statement"],"hypotheses"->{}|>,"real_exponential_positive"-><|"formula"->AnalysisProof`verifiedTheorem["rpefcl"]["statement"],"hypotheses"->{}|>|>];
 If[!TrueQ[validAnalyticalInterfaces[targets]],fail["analytic rule formula or hypotheses mismatch"]];
 polynomial=Sum[(-1/2)^k*x^(2*k)/k!,{k,0,11}];prefix=Sum[(-x*x/2)^k/k!,{k,0,11}];If[Expand[polynomial-prefix]=!=0,fail["polynomial is not exponential prefix"]];targets];
AreaIntervals`verifyCertificates[]:=Module[{analytic,lo,hi,area,sums=<||>,points,step,total,results={},check,rejected},
 analytic=foundations[];
 If[!3/100>0||!3/100<=7/50||!59/100>0,fail["change-of-variables parameter obligations"]];
 lo=idiv[iadd[logBound[3/100],67/25],59/100];hi=idiv[iadd[logBound[7/50],67/25],59/100];
 area=idiv[gaussianAreaBound[lo,hi],normalizerBound[]];
 Do[step=(11/100)/n;points=Table[3/100+j*step,{j,1,n}];If[Last[points]=!=7/50||!And@@(3/100<#<=7/50&/@points),fail["invalid right-endpoint partition"]];total=Fold[iadd,{0,0},imul[densityBound[#],step]&/@points];AssociateTo[sums,n->total],{n,{4,8,32}}];
 check[name_,condition_]:=If[!TrueQ[condition],fail[name],AppendTo[results,<|"id"->name,"passed"->True|>]];
 check["certified_scaled_gaussian_area_rounding",8062405/10^7<area[[1]]<=area[[2]]<8062415/10^7];
 check["certified_original_lognormal_area_rounding",8062405/10^7<area[[1]]<=area[[2]]<8062415/10^7&&KeyExistsQ[analytic,"lognormal_change_of_variables"]];
 check["certified_right_sum_4",6941/10000-1/20000<sums[4][[1]]<=sums[4][[2]]<6941/10000+1/20000];
 check["certified_right_sum_8",7572/10000-1/20000<sums[8][[1]]<=sums[8][[2]]<7572/10000+1/20000];
 check["certified_right_sum_32",7953/10000-1/20000<sums[32][[1]]<=sums[32][[2]]<7953/10000+1/20000];
 check["certified_displayed_error_decrease",sums[4][[2]]<sums[8][[1]]<=sums[8][[2]]<sums[32][[1]]<=sums[32][[2]]<area[[1]]];
 check["reject_wrong_area_rounding",!8062395/10^7<area[[1]]<=area[[2]]<8062405/10^7];
 check["reject_wrong_right_sum_rounding",!70005/100000<sums[4][[1]]<=sums[4][[2]]<70015/100000];
 check["reject_each_changed_analytic_formula",rejectedAnalyticalMutations[analytic,"formula"]];
 check["reject_each_changed_analytic_hypothesis",rejectedAnalyticalMutations[analytic,"hypotheses"]];
 <|"backend"->"Wolfram/exact-rational-interval-certificates","passed"->True,"results"->results,"area_interval"->(ToString[#,InputForm]&/@area),"right_sum_intervals"->Association@KeyValueMap[ToString[#1]->(ToString[#,InputForm]&/@#2)&,sums],"analytic_proofs"->Keys[analytic],"parameters"-><|"A"->"3/100","B"->"7/50","M"->"-67/25","S"->"59/100"|>,"scope"->"The original lognormal integral and right-endpoint sums, with analytic series, finite polynomial integration, uniform error bounds, normalization and change of variables verified independently of Lean."|>];
If[!TrueQ[AreaIntervals`$LibraryMode]&&Length[$ScriptCommandLine]>0&&ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName],result=Catch[AreaIntervals`verifyCertificates[],"IntervalCertificateError",Function[{value,tag},<|"passed"->False,"error"->ToString[value,InputForm]|>]];Print[ExportString[result,"RawJSON"]];Exit[If[TrueQ[result["passed"]],0,1]]];
End[];
