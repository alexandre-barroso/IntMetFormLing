results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
chain[v_]:=And@@Map[FullSimplify[#[[1]]==#[[2]]]&,Partition[v,2,1]];
check["posterior_from_product",FullSimplify[posterior==likelihood*prior/evidence,evidence>0&&posterior*evidence==likelihood*prior]];
s=q1/2+q2/3;
check["posterior_normalization_chain",FullSimplify[(q1/2)/s+(q2/3)/s==(q1/2+q2/3)/s&&(q1/2+q2/3)/s==s/s&&s/s==1,s>0]];
rsaMembership={{1,1,0,0},{1,0,1,0},{0,1,0,1}};
rsaExtensions=Total[rsaMembership];
rsaWeights=Table[rsaMembership[[i,j]]/rsaExtensions[[j]],{i,3},{j,4}];
rsaSpeaker=Table[rsaWeights[[i,j]]/Total[rsaWeights[[i]]],{i,3},{j,4}];
check["rsa_extension_weights",rsaExtensions=={2,2,1,1}&&rsaWeights=={{1/2,1/2,0,0},{1/2,0,1,0},{0,1/2,0,1}}];
check["rsa_speaker_blue",rsaSpeaker[[All,1]]=={1/2,1/3,0}];
check["rsa_speaker_circle_chain",chain[{(1/2)/(1/2+1),(1/2)/(3/2),(1/2)*(2/3),1/3}]&&1/(3/2)==2/3];
check["binomial_factorial",FullSimplify[Binomial[k+j,k]==(k+j)!/(k!j!),Element[{k,j},Integers]&&k>=0&&j>=0]];
check["bernoulli_mean",Expand[1p+0(1-p)-p]==0];
check["bernoulli_variance_chain",chain[{p(1-p)^2+(1-p)(0-p)^2,p(1-2p+p^2)+(1-p)p^2,p-2p^2+p^3+p^2-p^3,p-p^2,p(1-p)}]];
check["binomial_source_zero",Binomial[100,0]==1&&(1/1000)^0==1&&Binomial[100,0](1/1000)^0(1-1/1000)^100==(999/1000)^100];
check["log2_greek_reductions",chain[{Log[2,3/8],Log[2,3]-3}]&&chain[{Log[2,2/8],Log[2,1/4],-2}]&&Log[2,1/8]==-3&&FullSimplify[Log[2,2/3]==1-Log[2,3]]&&FullSimplify[Log[2,1/3]==-Log[2,3]]];
check["group_entropy_chain",chain[{-(2/3)Log[2,2/3]-(1/3)Log[2,1/3],-(2/3)(1-Log[2,3])-(1/3)(-Log[2,3]),-2/3+(2/3)Log[2,3]+(1/3)Log[2,3],Log[2,3]-2/3}]];
check["surprise_product_chain",chain[{-Log[2,(2/8)(1/2)],-Log[2,2/8]-Log[2,1/2],-Log[2,1/4]-Log[2,1/2],2+1,3}]];
check["surprise_graph_points",1/8==125/1000&&1/2==5/10&&-Log[2,125/1000]==3&&-Log[2,5/10]==1&&-Log[2,1]==0];
mu=-268/100;sigma=59/100;
model=Exp[-(Log[t]-mu)^2/(2sigma^2)]/(sigma t Sqrt[2Pi]);
plotted=Exp[-(Log[t]+268/100)^2/(2(59/100)^2)]/(t(59/100)Sqrt[2Pi]);
check["lognormal_source_model",FullSimplify[model==plotted&&Log[t]-mu==Log[t]+268/100,t>0]];
check["lognormal_source_domain",sigma>0&&0<2/1000<3/100<14/100<8/10&&FullSimplify[plotted>0,t>0]];
kappaTable={{20,20},{10,50}};
check["kappa_margins",Total/@kappaTable=={40,60}&&Total[kappaTable]=={30,70}&&Total[Flatten[kappaTable]]==100];
check["unequal_conditional_masses",2/3!=1/2&&1/3!=1/2];
check["surprisal_change_base",FullSimplify[-Log[2,p]==-Log[p]/Log[2],p>0]];
check["surprise_eighth_chain",2^-3==1/8&&Log[2,1/8]==-3&&-Log[2,1/8]==-(-3)&&-(-3)==3];
check["bernoulli_sum_means",FullSimplify[Sum[p,{index,1,size}]==size*p,Element[size,Integers]&&size>=0]];
check["posterior_joint_weight_chain",FullSimplify[(jointMass/evidence)*evidence==jointMass&&jointMass==(jointMass/prior)*prior&&jointMass/evidence==(jointMass/prior)*prior/evidence,evidence>0&&prior>0&&jointMass>=0]];
check["binomial_one_factorial_chain",chain[{Binomial[100,1],100!/(1!99!),(100*99!)/99!,100}]];
check["surprise_product_full_chain",FullSimplify[-Log[2,positiveA*positiveB]==-(Log[2,positiveA]+Log[2,positiveB])&&-(Log[2,positiveA]+Log[2,positiveB])==-Log[2,positiveA]-Log[2,positiveB],positiveA>0&&positiveB>0]];
pmiArguments={(fxy/n)/((fx/n)*(fy/n)),(fxy/n)*(n^2/(fx*fy)),fxy*n/(fx*fy)};
check["pmi_frequency_full_chain",FullSimplify[And@@Thread[pmiArguments>0]&&Log[2,pmiArguments[[1]]]==Log[2,pmiArguments[[2]]]&&Log[2,pmiArguments[[2]]]==Log[2,pmiArguments[[3]]],fxy>0&&fx>0&&fy>0&&n>0]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
