results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
finiteSum[nil,slot_,body_]:=0;
finiteSum[cons[head_,rest_],slot_,body_]:=(body/.slot->head)+finiteSum[rest,slot,body];
inductionIdentity[left_,right_]:=Module[{base,ihLeft,ihRight,stepLeft,stepRight},If[!FreeQ[{left,right},tail|hh],Return[False]];base=Expand[(left-right)/.xs->nil];ihLeft=left/.xs->tail;ihRight=right/.xs->tail;stepLeft=(left/.xs->cons[hh,tail])/.ihLeft->ihRight;stepRight=right/.xs->cons[hh,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
sumZero=inductionIdentity[finiteSum[xs,i,0],0];
sumAdd=inductionIdentity[finiteSum[xs,i,ff[i]+gg[i]],finiteSum[xs,i,ff[i]]+finiteSum[xs,i,gg[i]]];
sumScale=inductionIdentity[finiteSum[xs,i,cc*ff[i]],cc*finiteSum[xs,i,ff[i]]];
sumSubtract=inductionIdentity[finiteSum[xs,i,ff[i]-gg[i]],finiteSum[xs,i,ff[i]]-finiteSum[xs,i,gg[i]]];
linearize[expression_]:=Module[{value,sequence,slot,body,factors,factor,dependent},If[AtomQ[expression],Return[expression]];value=Map[linearize,expression];If[Head[value]=!=finiteSum,Return[value]];{sequence,slot,body}=List@@value;If[body===0,If[!sumZero,Throw["zero"]];Return[0]];If[Head[body]===Plus,If[!sumAdd,Throw["addition"]];Return[Total[linearize[finiteSum[sequence,slot,#]]&/@(List@@body)]]];factors=If[Head[body]===Times,List@@body,{body}];factor=Times@@Select[factors,FreeQ[#,slot]&];dependent=Times@@Select[factors,!FreeQ[#,slot]&];If[factor=!=1,If[!sumScale,Throw["scaling"]];Return[factor*finiteSum[sequence,slot,dependent]]];value];
fubiniInduction[]:=Module[{left,right,base,ihLeft,ihRight,stepLeft,stepRight},left=finiteSum[xs,i,finiteSum[ys,j,ff[i,j]]];right=finiteSum[ys,j,finiteSum[xs,i,ff[i,j]]];base=Expand[linearize[left/.xs->nil]-linearize[right/.xs->nil]];ihLeft=left/.xs->tail;ihRight=right/.xs->tail;stepLeft=linearize[left/.xs->cons[hh,tail]]/.ihLeft->ihRight;stepRight=linearize[right/.xs->cons[hh,tail]];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
sumExchange=fubiniInduction[];
sumNonnegativeInduction[]:=Module[{base,step,expected,constrained},base=finiteSum[nil,i,ff[i]];step=finiteSum[cons[hh,tail],i,ff[i]];expected=ff[hh]+finiteSum[tail,i,ff[i]];constrained=step/.{ff[hh]->headMass,finiteSum[tail,i,ff[i]]->tailMass};TrueQ[base==0&&step===expected&&FullSimplify[constrained>=0,headMass>=0&&tailMass>=0]]];
entryLeSumInduction[]:=Module[{total,headGap,recursiveGap},total=finiteSum[cons[hh,tail],i,ff[i]];headGap=Expand[total-ff[hh]];recursiveGap=Expand[(total-selected)/.finiteSum[tail,i,ff[i]]->selected+tailGap];TrueQ[sumNonnegativeInduction[]&&headGap===finiteSum[tail,i,ff[i]]&&FullSimplify[(headGap/.finiteSum[tail,i,ff[i]]->tailMass)>=0,tailMass>=0]&&recursiveGap===ff[hh]+tailGap&&FullSimplify[(recursiveGap/.ff[hh]->headMass)>=0,headMass>=0&&tailGap>=0]]];
safeLog2[0]=0;
safeLog2[value_]:=Log[value]/Log[2];
jointTerm[0,row_,column_]=0;
jointTerm[mass_,row_,column_]:=mass*Log[mass/(row*column)]/Log[2];
conditionalTerm[0,row_]=0;
conditionalTerm[mass_,row_]:=mass*Log[mass/row]/Log[2];
conditionalProbabilityTerm[0,row_]=0;
conditionalProbabilityTerm[mass_,row_]:=(mass/row)*Log[mass/row]/Log[2];
positiveIdentity=FullSimplify[jointTerm[p,r,y]==conditionalTerm[p,r]-p*safeLog2[y],p>0&&r>0&&y>0];
zeroIdentity=jointTerm[0,row,column]===conditionalTerm[0,row]-0*safeLog2[column]===0;
conditionalPositive=FullSimplify[r*conditionalProbabilityTerm[p,r]==conditionalTerm[p,r],p>0&&r>0];
conditionalZero=conditionalProbabilityTerm[0,row]===conditionalTerm[0,row]===0;
mapExpression[expression_,rule_,protected_:{}]:=If[AtomQ[expression]||MemberQ[protected,Head[expression]],rule[expression],rule[Map[mapExpression[#,rule,protected]&,expression]]];
pushScalar[expression_]:=Module[{sums,summation,sequence,slot,body,factors,factor},If[Head[expression]=!=Times,Return[expression]];factors=List@@expression;sums=Select[factors,Head[#]===finiteSum&];If[Length[sums]!=1,Return[expression]];summation=First[sums];{sequence,slot,body}=List@@summation;factor=Times@@DeleteCases[factors,summation];If[!FreeQ[factor,slot]||!sumScale,Return[expression]];finiteSum[sequence,slot,factor*body]];
pushAll[expression_]:=FixedPoint[mapExpression[#,pushScalar]&,expression];
exchangeNested[expression_]:=Module[{outerSequence,outerSlot,inner,innerSequence,innerSlot,body},If[Head[expression]=!=finiteSum||Head[expression[[3]]]=!=finiteSum||!sumExchange,Throw["exchange"]];{outerSequence,outerSlot,inner}=List@@expression;{innerSequence,innerSlot,body}=List@@inner;If[outerSlot===innerSlot||!FreeQ[innerSequence,outerSlot]||!FreeQ[outerSequence,innerSlot],Throw["capture"]];finiteSum[innerSequence,innerSlot,finiteSum[outerSequence,outerSlot,body]]];
expandMarginal[value_]:=If[value===cmargin[j],finiteSum[xs,i,pcell[i,j]],value];
marginalEntropyChain[]:=Module[{original,substituted,distributed,expectedDistributed,exchanged,expected},original=-finiteSum[ys,j,cmargin[j]*ll[cmargin[j]]];substituted=mapExpression[original,expandMarginal,{ll}];distributed=pushAll[substituted];expectedDistributed=finiteSum[ys,j,finiteSum[xs,i,-pcell[i,j]*ll[cmargin[j]]]];If[distributed=!=expectedDistributed,Throw["marginal scaling"]];exchanged=exchangeNested[distributed];expected=-finiteSum[xs,i,finiteSum[ys,j,pcell[i,j]*ll[cmargin[j]]]];If[Expand[linearize[exchanged]-linearize[expected]]=!=0,Throw["marginal exchange"]];{original,substituted,exchanged}];
cancelRow[value_]:=If[value===-rmargin[i]*qterm[i,j],If[!TrueQ[conditionalPositive&&conditionalZero],Throw["conditional term"]];-cterm[i,j],value];
conditionalEntropyChain[]:=Module[{original,distributed,cancelled,expected},original=-finiteSum[xs,i,rmargin[i]*finiteSum[ys,j,qterm[i,j]]];distributed=pushAll[original];cancelled=mapExpression[distributed,cancelRow];expected=-finiteSum[xs,i,finiteSum[ys,j,cterm[i,j]]];If[Expand[linearize[cancelled]-linearize[expected]]=!=0,Throw["conditional scaling"]];{original,distributed,cancelled}];
marginalEntropyExpansion[]:=(marginalEntropyChain[];TrueQ[sumExchange&&sumScale]);
conditionalEntropyExpansion[]:=(conditionalEntropyChain[];TrueQ[sumScale&&conditionalPositive&&conditionalZero]);
pointwiseInformation[value_]:=If[value===iterm[i,j],If[!TrueQ[positiveIdentity&&zeroIdentity&&entryLeSumInduction[]],Throw["pointwise identity"]];cterm[i,j]-pcell[i,j]*ll[cmargin[j]],value];
informationEntropyComposition[]:=Module[{source,derived,hy,hygivenx},source=finiteSum[xs,i,finiteSum[ys,j,iterm[i,j]]];derived=mapExpression[source,pointwiseInformation];hy=Last[marginalEntropyChain[]];hygivenx=Last[conditionalEntropyChain[]];TrueQ[sumSubtract&&Expand[linearize[derived]-linearize[hy-hygivenx]]==0]];
check["finite_sum_zero_induction",sumZero];
check["finite_sum_addition_induction",sumAdd];
check["finite_sum_scaling_induction",sumScale];
check["finite_sum_subtraction_induction",sumSubtract];
check["finite_sum_exchange_induction",sumExchange];
check["finite_sum_nonnegative_induction",sumNonnegativeInduction[]];
check["entry_le_finite_sum_induction",entryLeSumInduction[]];
check["positive_cell_positive_marginals",Resolve[ForAll[{cell,remaining},Implies[cell>0&&remaining>=0,cell+remaining>0]],Reals]];
check["zero_marginal_zero_cells",Resolve[ForAll[{cell,remaining},Implies[cell>=0&&remaining>=0&&cell+remaining==0,cell==0]],Reals]];
check["information_positive_term_identity",positiveIdentity];
check["information_zero_term_identity",zeroIdentity&&safeLog2[0]===0];
check["marginal_entropy_expansion_induction",marginalEntropyExpansion[]];
check["conditional_entropy_expansion_induction",conditionalEntropyExpansion[]];
check["information_entropy_composition_induction",informationEntropyComposition[]];
check["wrong_sum_scaling_rejected",!inductionIdentity[finiteSum[xs,i,cc*ff[i]],2cc*finiteSum[xs,i,ff[i]]]];
check["wrong_information_sign_rejected",FullSimplify[jointTerm[p,r,y]-(conditionalTerm[p,r]+p*safeLog2[y]),p>0&&r>0&&y>0]=!=0];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
