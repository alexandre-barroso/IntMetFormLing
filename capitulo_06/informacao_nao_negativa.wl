ClearAll[check, results, r, p, q, a, b, x, y];
results = {};
check[id_, condition_] := AppendTo[results, <|"id" -> id, "passed" -> TrueQ[condition]|>];
phi[r_] := r - 1 - Log[r];
check["log_upper_bound_global", First[Minimize[{phi[r], r > 0}, r, Reals]] == 0];
check["log_bound_derivative", Simplify[D[phi[r], r] == (r - 1)/r]];
check["log_bound_equality_at_one", phi[1] == 0];
check["positive_mass_log_bound_identity", FullSimplify[p Log[p/q] - (p - q) == p phi[q/p], p > 0 && q > 0]];
check["zero_mass_lower_bound", Resolve[ForAll[q, q >= 0, 0 >= 0 - q], Reals]];
check["zero_reference_allowed_at_zero_mass", 0 >= 0 - 0];
check["positive_joint_implies_positive_reference", Resolve[ForAll[{p, a, b}, p > 0 && a >= 0 && b >= 0, (p + a) (p + b) > 0], Reals]];
check["nonnegative_reference", Resolve[ForAll[{a, b}, a >= 0 && b >= 0, a b >= 0], Reals]];
check["sum_inequalities_induction", Resolve[ForAll[{x, y, a, b}, x >= y && a >= b, x + a >= y + b], Reals]];
check["normalized_reference_total", Resolve[ForAll[{x, y}, x == 1 && y == 1, x y == 1], Reals]];
check["base_two_preserves_sign", Log[2] > 0];
check["change_base_identity", FullSimplify[p Log[2, p/q] == p Log[p/q]/Log[2], p > 0 && q > 0]];
report = <|"backend" -> "Wolfram Language", "checks" -> Length[results], "passed" -> And @@ Lookup[results, "passed"], "results" -> results|>;
Print[ExportString[report, "RawJSON"]];
If[!TrueQ[report["passed"]], Exit[1]];
