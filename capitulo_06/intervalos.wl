results = {};
check[id_, condition_] := If[TrueQ[condition], AppendTo[results, <|"id" -> id, "passed" -> True|>], Print[id]; Exit[1]];
exponentialBounds[value_, terms_:40] := Module[{lower, upper, partial, first, ratio},
If[!TrueQ[(IntegerQ[value] || Head[value] === Rational) && IntegerQ[terms] && terms >= 1], Return[$Failed]];
If[value == 0, Return[{1, 1}]];
If[value < 0, {lower, upper} = exponentialBounds[-value, terms]; Return[{1/upper, 1/lower}]];
If[value >= terms+2, Return[$Failed]];
partial = Sum[value^i/i!, {i, 0, terms}];
first = value^(terms+1)/(terms+1)!;
ratio = value/(terms+2);
{partial, partial+first/(1-ratio)}];
unitLogarithmBounds[value_, terms_:30] := Module[{z, partial, error},
If[!TrueQ[(IntegerQ[value] || Head[value] === Rational) && 1 <= value <= 2 && IntegerQ[terms] && terms >= 1], Return[$Failed]];
z = (value-1)/(value+1);
partial = Sum[z^(2i+1)/(2i+1), {i, 0, terms-1}];
error = z^(2terms+1)/(1-z^2);
{2partial, 2(partial+error)}];
logarithmBounds[value_] := Module[{scaled = value, power = 0, lower, upper, l2, u2},
If[!TrueQ[(IntegerQ[value] || Head[value] === Rational) && value > 0], Return[$Failed]];
While[scaled > 2, scaled /= 2; power += 1];
While[scaled < 1, scaled *= 2; power -= 1];
{lower, upper} = unitLogarithmBounds[scaled];
{l2, u2} = unitLogarithmBounds[2];
If[power < 0, {lower+power u2, upper+power l2}, {lower+power l2, upper+power u2}]];
negativeLogarithmBounds[value_] := -Reverse[logarithmBounds[value]];
sigmoidBounds[value_] := Map[#/(1+#)&, exponentialBounds[value]];
softplusLossBounds[value_] := Module[{lower, upper}, {lower, upper} = exponentialBounds[value]; {logarithmBounds[1+lower][[1]]-value, logarithmBounds[1+upper][[2]]-value}];
enclosesRounding[interval_, printed_, halfPlace_] := TrueQ[halfPlace > 0 && printed-halfPlace < interval[[1]] <= interval[[2]] < printed+halfPlace];
check["exponential_term_ratio", FullSimplify[(q^(k+1)/(k+1)!)/(q^k/k!) == q/(k+1), q > 0 && Element[k, Integers] && k >= 0]];
check["exponential_tail_ratio_majorant", Resolve[ForAll[{q, n, s}, Implies[q > 0 && n >= 0 && s >= 0, q/(n+2+s) <= q/(n+2)]], Reals]];
partialExp = Sum[x^i/i!, {i, 0, 40}];
check["exponential_taylor_remainder_identity", Together[D[Exp[x]-partialExp, x]-(Exp[x]-partialExp)-x^40/40!] == 0];
check["exponential_taylor_initial_value", (Exp[x]-partialExp /. x -> 0) == 0];
check["exponential_geometric_tail", FullSimplify[Sum[r^k, {k, 0, Infinity}] == 1/(1-r), 0 <= r < 1]];
check["negative_exponential_reciprocal", FullSimplify[Exp[-x] Exp[x] == 1]];
partialLog = Sum[x^(2i+1)/(2i+1), {i, 0, 29}];
check["logarithm_remainder_derivative", Together[D[Log[(1+x)/(1-x)]-2partialLog, x]-2x^60/(1-x^2)] == 0];
check["logarithm_remainder_origin", (Log[(1+x)/(1-x)]-2partialLog /. x -> 0) == 0];
check["logarithm_majorant_nonnegative", Resolve[ForAll[{t, z}, Implies[0 <= t <= z < 1, 1/(1-t^2) <= 1/(1-z^2)]], Reals]];
check["logarithm_integrated_majorant", FullSimplify[Integrate[2t^60/(1-z^2), {t, 0, z}, Assumptions -> 0 <= z < 1] == 2z^61/(61(1-z^2)), 0 <= z < 1]];
check["logarithm_scale_identity", FullSimplify[Log[u 2^k] == Log[u]+k Log[2], u > 0 && Element[k, Integers]]];
check["sigmoid_increasing", FullSimplify[D[u/(1+u), u] == 1/(1+u)^2 && 1/(1+u)^2 > 0, u > 0]];
check["logarithm_increasing", FullSimplify[D[Log[u], u] == 1/u && 1/u > 0, u > 0]];
log2Bounds[value_] := Module[{lower,upper,l2,u2}, {lower,upper}=logarithmBounds[value]; {l2,u2}=logarithmBounds[2]; If[lower<0,Return[$Failed]]; {lower/u2,upper/l2}];
coarseBounds[interval_,precision_:15] := {Floor[interval[[1]] 10^precision]/10^precision,Ceiling[interval[[2]] 10^precision]/10^precision};
arctangentBounds[value_,terms_:20] := Module[{partial,nextTerm}, If[!TrueQ[(IntegerQ[value] || Head[value]===Rational)&&0<=value<1&&IntegerQ[terms]&&terms>=1],Return[$Failed]]; partial=Sum[(-1)^i value^(2i+1)/(2i+1),{i,0,terms-1}];nextTerm=(-1)^terms value^(2terms+1)/(2terms+1);{Min[partial,partial+nextTerm],Max[partial,partial+nextTerm]}];
forward = log2Bounds[450000000/266305];
reverse = log2Bounds[90000000/266305];
three = log2Bounds[3];
check["pmi_forward_rounding",enclosesRounding[forward,107/10,1/20]];
check["pmi_reverse_rounding",enclosesRounding[reverse,84/10,1/20]];
check["log2_three_interval",3169/2000<three[[1]]<=three[[2]]<317/200];
conditional = (3/8)three;
initial = {11/4-(3/8)three[[2]],11/4-(3/8)three[[1]]};
classConditional = three-2/3;
check["conditional_entropy_rounding",enclosesRounding[conditional,594/1000,1/2000]];
check["initial_entropy_rounding",enclosesRounding[initial,2156/1000,1/2000]];
check["within_class_entropy_rounding",enclosesRounding[classConditional,918/1000,1/2000]];
atanPartial = Sum[(-1)^i x^(2i+1)/(2i+1),{i,0,19}];
check["arctangent_remainder_derivative",Together[D[ArcTan[x]-atanPartial,x]-x^40/(1+x^2)]==0];
check["arctangent_remainder_origin",(ArcTan[x]-atanPartial/.x->0)==0];
check["arctangent_remainder_majorant",Resolve[ForAll[x,Implies[x>=0,0<=x^40/(1+x^2)<=x^40]],Reals]];
check["arctangent_integrated_majorant",Integrate[x^40,{x,0,z}]==z^41/41];
check["arctangent_positive_lower_bound",Resolve[ForAll[{t,z},Implies[0<=t<=z,1/(1+t^2)>=1/(1+z^2)]],Reals]];
angle = 4ArcTan[1/5]-ArcTan[1/239];
check["machin_tangent_identity",FullSimplify[Tan[angle]]==1];
check["machin_principal_range",4(1/5)/(1+(1/5)^2)-1/239>0&&4/5<1];
check["pi_quarter_arctangent",ArcTan[1]==Pi/4];
check["pi_half_greater_than_one",D[ArcTan[x],x]==1/(1+x^2)&&Resolve[ForAll[x,Implies[0<=x<1,1/(1+x^2)>1/2]],Reals]];
{a5,b5}=arctangentBounds[1/5];
{a239,b239}=arctangentBounds[1/239];
piBounds={16a5-4b239,16b5-4a239};
sqrtTwoPi={250662827463100/100000000000000,250662827463101/100000000000000};
check["sqrt_two_pi_enclosure",0<sqrtTwoPi[[1]]<sqrtTwoPi[[2]]&&sqrtTwoPi[[1]]^2<2piBounds[[1]]&&2piBounds[[2]]<sqrtTwoPi[[2]]^2];
densityBounds[time_] := Module[{lower,upper,squared,variance,exponent,numerator,denominator}, If[!TrueQ[(IntegerQ[time]||Head[time]===Rational)&&time>0],Return[$Failed]];
{lower,upper}=coarseBounds[logarithmBounds[time]];
lower+=268/100;upper+=268/100;
squared={If[lower<=0<=upper,0,Min[lower^2,upper^2]],Max[lower^2,upper^2]};
variance=2(59/100)^2;
exponent=coarseBounds[{-squared[[2]]/variance,-squared[[1]]/variance}];
numerator={exponentialBounds[exponent[[1]]][[1]],exponentialBounds[exponent[[2]]][[2]]};
denominator=time (59/100)sqrtTwoPi;
{numerator[[1]]/denominator[[2]],numerator[[2]]/denominator[[1]]}];
check["density_endpoint0",enclosesRounding[densityBounds[3/100],8447984/1000000,1/2000000]];
check["density_endpoint1",enclosesRounding[densityBounds[7/50],2322823/1000000,1/2000000]];
Print[ExportString[<|"backend"->"Wolfram","arithmetic"->"exact rational enclosures with geometric and alternating remainders","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
