BeginPackage["PolynomialIntegration`"];
ClearAll[PolynomialIntegration`verifyCertificates];
If[!ValueQ[PolynomialIntegration`$LibraryMode], PolynomialIntegration`$LibraryMode=False];
Begin["`Private`"];
Block[{AnalysisProof`$LibraryMode=True}, Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "capitulo_02", "analise_geral.wl"}]]];
certificateGzipBase64 = "";
PolynomialIntegration`verifyCertificates[] := Module[{report,check,results={}},
report=AnalysisProof`verifyProofGraph[ImportString[ImportByteArray[BaseDecode[certificateGzipBase64], {"GZIP", "Text"}], "RawJSON"]];
If[!TrueQ[report["passed"]],Return[report]];
check[id_,formula_,hypotheses_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[report["targets"][id]["formula"]===formula && Sort[report["targets"][id]["hypotheses"]]===Sort[hypotheses]],"formula"->formula,"hypotheses"->hypotheses|>];
check["finite_polynomial_integrable","|- ( x e. ( A [,] B ) |-> sum_ k e. I ( ( F ` k ) x. ( x ^ k ) ) ) e. L^1",{"|- A e. RR","|- B e. RR","|- F : I --> CC","|- I C_ NN0","|- I e. Fin"}];
check["finite_polynomial_integral","|- S. ( A [,] B ) sum_ k e. I ( ( F ` k ) x. ( x ^ k ) ) _d x = sum_ k e. I ( ( F ` k ) x. ( ( ( B ^ ( k + 1 ) ) - ( A ^ ( k + 1 ) ) ) / ( k + 1 ) ) )",{"|- A <_ B","|- A e. RR","|- B e. RR","|- F : I --> CC","|- I C_ NN0","|- I e. Fin"}];
check["integral_approximation_sandwich","|- ( ( S. ( A [,] B ) ( F ` x ) _d x - ( E x. ( B - A ) ) ) <_ S. ( A [,] B ) ( G ` x ) _d x /\\ S. ( A [,] B ) ( G ` x ) _d x <_ ( S. ( A [,] B ) ( F ` x ) _d x + ( E x. ( B - A ) ) ) )",{"|- ( x e. ( A [,] B ) |-> ( F ` x ) ) e. L^1","|- ( x e. ( A [,] B ) |-> ( G ` x ) ) e. L^1","|- A <_ B","|- A e. RR","|- A. x e. ( A [,] B ) ( ( ( F ` x ) e. RR /\\ ( G ` x ) e. RR ) /\\ ( ( ( F ` x ) - E ) <_ ( G ` x ) /\\ ( G ` x ) <_ ( ( F ` x ) + E ) ) )","|- B e. RR","|- E e. RR"}];
check["gaussian_continuous","|- ( x e. ( A [,] B ) |-> ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) ) e. ( ( A [,] B ) -cn-> CC )",{"|- A e. RR","|- B e. RR"}];
check["gaussian_integrable","|- ( x e. ( A [,] B ) |-> ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) ) e. L^1",{"|- A e. RR","|- B e. RR"}];
check["gaussian_normalizer_outside_integral","|- S. ( A [,] B ) ( ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) _d x = ( ( 1 / ( sqrt ` ( 2 x. _pi ) ) ) x. S. ( A [,] B ) ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) _d x )",{"|- A e. RR","|- B e. RR"}];
check["gaussian_standard_form_integral","|- S. ( A [,] B ) ( ( exp ` ( ( 0 - ( x ^ 2 ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) _d x = ( ( 1 / ( sqrt ` ( 2 x. _pi ) ) ) x. S. ( A [,] B ) ( exp ` ( ( 0 - ( x x. x ) ) / 2 ) ) _d x )",{"|- A e. RR","|- B e. RR"}];
AssociateTo[report,{"checks"->Length[results],"results"->results,"passed"->And@@Lookup[results,"passed"]}];report];
If[!TrueQ[PolynomialIntegration`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName], report=PolynomialIntegration`verifyCertificates[]; Print[ExportString[KeyDrop[report,{"targets"}],"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]]];
End[];
EndPackage[];
