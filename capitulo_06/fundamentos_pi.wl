BeginPackage["PiFoundations`"];
ClearAll[PiFoundations`verifyCertificates];
If[!ValueQ[PiFoundations`$LibraryMode], PiFoundations`$LibraryMode=False];
Begin["`Private`"];
Block[{AnalysisProof`$LibraryMode=True}, Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "capitulo_02", "analise_geral.wl"}]]];
certificateGzipBase64 = "";
PiFoundations`verifyCertificates[] := Module[{report,check,results={}},
report=AnalysisProof`verifyProofGraph[ImportString[ImportByteArray[BaseDecode[certificateGzipBase64], {"GZIP", "Text"}], "RawJSON"]];
If[!TrueQ[report["passed"]],Return[report]];
check[id_,formula_,hypotheses_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[report["targets"][id]["formula"]===formula && Sort[report["targets"][id]["hypotheses"]]===Sort[hypotheses]],"formula"->formula,"hypotheses"->hypotheses|>];
check["arctangent_addition_one","|- ( ( arctan ` A ) + ( arctan ` B ) ) = ( _pi / 4 )",{"|- ( ( A + B ) / ( 1 - ( A x. B ) ) ) = 1","|- ( A x. B ) =/= 1","|- 0 < A","|- 0 < B","|- A < 1","|- A e. RR","|- B < 1","|- B e. RR"}];
check["pi_two_arctangents","|- ( 4 x. ( ( arctan ` ( 1 / 2 ) ) + ( arctan ` ( 1 / 3 ) ) ) ) = _pi",{}];
check["arctangent_series_decomposition","|- ( arctan ` A ) = ( sum_ k e. ( 0 ... ( M - 1 ) ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) ) + sum_ k e. ( ZZ>= ` M ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) ) )",{"|- 0 <_ A","|- A < 1","|- A e. RR","|- M e. NN0"}];
check["arctangent_series_tail_lower","|- ( -u 1 x. ( ( A ^ M ) / ( 1 - A ) ) ) <_ sum_ k e. ( ZZ>= ` M ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) )",{"|- 0 <_ A","|- A < 1","|- A e. RR","|- M e. NN0"}];
check["arctangent_series_tail_upper","|- sum_ k e. ( ZZ>= ` M ) ( ( -u 1 ^ k ) x. ( ( A ^ ( ( 2 x. k ) + 1 ) ) / ( ( 2 x. k ) + 1 ) ) ) <_ ( ( A ^ M ) / ( 1 - A ) )",{"|- 0 <_ A","|- A < 1","|- A e. RR","|- M e. NN0"}];
check["gaussian_normalizer_positive","|- 0 < ( sqrt ` ( 2 x. _pi ) )",{}];
check["gaussian_normalizer_real","|- ( sqrt ` ( 2 x. _pi ) ) e. RR",{}];
check["gaussian_normalizer_square","|- ( ( sqrt ` ( 2 x. _pi ) ) ^ 2 ) = ( 2 x. _pi )",{}];
AssociateTo[report,{"checks"->Length[results],"results"->results,"passed"->And@@Lookup[results,"passed"]}];report];
If[!TrueQ[PiFoundations`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName], report=PiFoundations`verifyCertificates[]; Print[ExportString[KeyDrop[report,{"targets"}],"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]]];
End[];
EndPackage[];
