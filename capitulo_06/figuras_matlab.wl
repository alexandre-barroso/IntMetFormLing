ClearAll["Global`*"];
results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
acc={"us","es","es","is","a","a","i","a"};gen={"u","zero","s","s","u","u","us","os"};origins={"us","es","is","a","i"};
groups=(Flatten[Position[acc,#]]&) /@ origins;
weights=Length[#]/8& /@ groups;
probs=Table[Map[#/Length[groups[[i]]]& ,Counts[gen[[groups[[i]]]]]],{i,5}];
check["F07_class_partition",groups=={{1},{2,3},{4},{5,6,8},{7}}&&Sort[Flatten[groups]]==Range[8]];
check["F07_group_weights",weights=={1/8,2/8,1/8,3/8,1/8}&&Total[weights]==1];
check["F07_conditional_edges",probs=={<|"u"->1|>,<|"zero"->1/2,"s"->1/2|>,<|"s"->1|>,<|"u"->2/3,"os"->1/3|>,<|"us"->1|>}];
entropy[p_]:=FullSimplify[-Total[(# Log[2,#]&) /@ Select[p,Positive]]];
h=entropy[Values[#]]& /@ probs;
check["F07_group_entropies",FullSimplify[h=={0,1,0,Log[2,3]-2/3,0}]];
conditional=FullSimplify[weights.h];initial=entropy[Values[Counts[gen]]/8];
check["F07_conditional_entropy",FullSimplify[conditional==3/8 Log[2,3]]];
check["F07_initial_entropy",FullSimplify[initial==11/4-3/8 Log[2,3]]];
check["F07_decimals",FullSimplify[9175/10000<h[[4]]<9185/10000&&5935/10000<conditional<5945/10000&&21555/10000<initial<21565/10000]];
check["F07_unweighted_mean_rejected",FullSimplify[Total[h]/5!=conditional]];
report=<|"backend"->"Wolfram Language","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
