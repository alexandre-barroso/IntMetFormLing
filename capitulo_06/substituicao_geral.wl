BeginPackage["LognormalSubstitution`"];
ClearAll[LognormalSubstitution`verifyCertificates];
If[!ValueQ[LognormalSubstitution`$LibraryMode], LognormalSubstitution`$LibraryMode=False];
Begin["`Private`"];
Block[{AnalysisProof`$LibraryMode=True}, Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "capitulo_02", "analise_geral.wl"}]]];
certificateGzipBase64 = "";
LognormalSubstitution`verifyCertificates[] := Module[{report,check,results={}},
report=AnalysisProof`verifyProofGraph[ImportString[ImportByteArray[BaseDecode[certificateGzipBase64], {"GZIP", "Text"}], "RawJSON"]];
If[!TrueQ[report["passed"]],Return[report]];
check[id_,formula_,hypotheses_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[report["targets"][id]["formula"]===formula && Sort[report["targets"][id]["hypotheses"]]===Sort[hypotheses]],"formula"->formula,"hypotheses"->hypotheses|>];
check["standardized_log_derivative","|- ( RR _D ( x e. RR+ |-> ( ( ( log ` x ) - M ) / S ) ) ) = ( x e. RR+ |-> ( 1 / ( S x. x ) ) )",{"|- M e. RR","|- S e. RR+"}];
check["gaussian_continuity","|- ( u e. RR |-> ( ( exp ` ( ( 0 - ( u ^ 2 ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) ) e. ( RR -cn-> CC )",{}];
check["standardized_log_closed_derivative","|- ( RR _D ( x e. ( A [,] B ) |-> ( ( ( log ` x ) - M ) / S ) ) ) = ( x e. ( A (,) B ) |-> ( 1 / ( S x. x ) ) )",{"|- A e. RR+","|- B e. RR","|- M e. RR","|- S e. RR+"}];
check["reciprocal_continuity_integrability","|- ( x e. ( A (,) B ) |-> ( 1 / ( S x. x ) ) ) e. ( ( ( A (,) B ) -cn-> CC ) i^i L^1 )",{"|- A e. RR+","|- B e. RR","|- S e. RR+"}];
check["change_of_variables_oriented","|- S_ [ ( ( ( log ` A ) - M ) / S ) -> ( ( ( log ` B ) - M ) / S ) ] ( ( exp ` ( ( 0 - ( u ^ 2 ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) _d u = S_ [ A -> B ] ( ( ( exp ` ( ( 0 - ( ( ( ( log ` x ) - M ) / S ) ^ 2 ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) x. ( 1 / ( S x. x ) ) ) _d x",{"|- A <_ B","|- A e. RR+","|- B e. RR","|- M e. RR","|- S e. RR+"}];
check["lognormal_change_of_variables","|- S. ( A [,] B ) ( ( exp ` ( ( 0 - ( ( ( ( log ` x ) - M ) / S ) ^ 2 ) ) / 2 ) ) / ( x x. ( S x. ( sqrt ` ( 2 x. _pi ) ) ) ) ) _d x = S. ( ( ( ( log ` A ) - M ) / S ) [,] ( ( ( log ` B ) - M ) / S ) ) ( ( exp ` ( ( 0 - ( u ^ 2 ) ) / 2 ) ) / ( sqrt ` ( 2 x. _pi ) ) ) _d u",{"|- A <_ B","|- A e. RR+","|- B e. RR","|- M e. RR","|- S e. RR+"}];
AssociateTo[report,{"checks"->Length[results],"results"->results,"passed"->And@@Lookup[results,"passed"]}];report];
If[!TrueQ[LognormalSubstitution`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName], report=LognormalSubstitution`verifyCertificates[]; Print[ExportString[KeyDrop[report,{"targets"}],"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]]];
End[];
EndPackage[];
