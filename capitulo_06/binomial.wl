ClearAll["Global`*"];
naturalAssumptions=Element[{n,k,j},Integers]&&n>=0&&k>=0&&j>=0;
monomialEqual[left_,right_]:=TrueQ[Simplify[left[[2]]==right[[2]]&&left[[3]]==right[[3]]]]&&TrueQ[FullSimplify[left[[1]]==right[[1]],naturalAssumptions]];
monomialShift[term_,pd_,qd_]:={term[[1]],term[[2]]+pd,term[[3]]+qd};
monomialAdd[left_,right_]:=If[TrueQ[Simplify[left[[2]]==right[[2]]&&left[[3]]==right[[3]]]],{left[[1]]+right[[1]],left[[2]],left[[3]]},$Failed];
binomialTerm[size_,index_]:={Binomial[size,index],index,size-index};
coefficientInduction[term_]:=monomialEqual[term[0,0],{1,0,0}]&&monomialEqual[term[n+1,0],monomialShift[term[n,0],0,1]]&&monomialEqual[term[n+1,n+1],monomialShift[term[n,n],1,0]]&&monomialEqual[term[k+j+2,k+1],monomialAdd[monomialShift[term[k+j+1,k],1,0],monomialShift[term[k+j+1,k+1],0,1]]];
transition[nil,prev_]:=cons[p*prev,nil];
transition[cons[weight_,rest_],prev_]:=cons[q*weight+p*prev,transition[rest,weight]];
length[nil]=0;
length[cons[weight_,rest_]]:=1+length[rest];
fold[nil,start_,body_]:=0;
fold[cons[weight_,rest_],start_,body_]:=weight*(body/.k->start)+fold[rest,start+1,body];
foldInduction[left_,right_]:=Module[{base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},If[!FreeQ[{left,right},tail|h],Return[False]];base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.{xs->tail,i->i+1};hypothesisRight=right/.{xs->tail,i->i+1};stepLeft=(left/.xs->cons[h,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[h,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
rowLengthInduction[]:=Module[{left,right,base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},left=length[transition[xs,previous]];right=length[xs]+1;base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.{xs->tail,previous->h};hypothesisRight=right/.xs->tail;stepLeft=(left/.xs->cons[h,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[h,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0&&length[cons[1,nil]]==1]];
weightedTransitionInduction[]:=Module[{left,right,base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},left=fold[transition[xs,previous],i,ff[k]];right=q*fold[xs,i,ff[k]]+p*fold[xs,i+1,ff[k]]+p*previous*ff[i];base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.{xs->tail,previous->h,i->i+1};hypothesisRight=right/.{xs->tail,previous->h,i->i+1};stepLeft=(left/.xs->cons[h,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[h,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
shiftBodyCertificate[power_]:=Module[{shifted,right},shifted=Expand[(k+1)^power];right=Sum[Coefficient[shifted,k,r]*fold[xs,i,k^r],{r,0,power}];foldInduction[fold[xs,i,shifted],right]];
momentInduction[closedForms_]:=Module[{base,nextMoment,coefficients},If[!coefficientInduction[binomialTerm]||!rowLengthInduction[]||!weightedTransitionInduction[]||!foldInduction[fold[xs,i+1,ff[k]],fold[xs,i,ff[k+1]]]||Length[closedForms]!=3,Return[False]];And@@Table[base=fold[cons[1,nil],0,k^order];coefficients=Expand[(k+1)^order];nextMoment=(q*closedForms[[order+1]]+p*Sum[Coefficient[coefficients,k,r]*closedForms[[r+1]],{r,0,order}])/.q->1-p;shiftBodyCertificate[order]&&TrueQ[Expand[(closedForms[[order+1]]/.n->0)-base]==0]&&TrueQ[Expand[nextMoment-(closedForms[[order+1]]/.n->n+1)]==0],{order,0,2}]];
endpointRecurrences[]:=Module[{zeroBase,zeroLeft,zeroRight,oneBase,oneLeft,oneRight},zeroBase=(transition[nil,previous]/.{p->0,q->1})===cons[0,nil];zeroLeft=(transition[cons[h,tail],previous]/.{p->0,q->1})/.transition[tail,h]->pad[tail];zeroRight=cons[h,pad[tail]];oneBase=(transition[nil,previous]/.{p->1,q->0})===cons[previous,nil];oneLeft=(transition[cons[h,tail],previous]/.{p->1,q->0})/.transition[tail,h]->cons[h,tail];oneRight=cons[previous,cons[h,tail]];zeroBase&&zeroLeft===zeroRight&&oneBase&&oneLeft===oneRight];
naturalPower[base_,0]:=1;
naturalPower[base_,exponent_Integer?Positive]:=base*naturalPower[base,exponent-1];
singleCoefficientBoundInduction[]:=Module[{stepTotal,definition,headGap,tailGap},stepTotal=fold[cons[h,tail],i,1];definition=stepTotal===h+fold[tail,i+1,1];headGap=Expand[(h+tailTotal)-h]/.tailTotal->rest;tailGap=Expand[(h+tailTotal)-selected]/.{h->un,tailTotal->selected+rest};definition&&TrueQ[FullSimplify[headGap>=0&&tailGap>=0,Element[{un,rest,selected},Reals]&&un>=0&&rest>=0]]];
moments={1,n*p,(n*p)^2+n*p*(1-p)};
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["binomial_pascal_interior",FullSimplify[Binomial[k+j+2,k+1]==Binomial[k+j+1,k]+Binomial[k+j+1,k+1],naturalAssumptions]];
check["binomial_boundary_coefficients",FullSimplify[Binomial[n,0]==1&&Binomial[n,n]==1,naturalAssumptions]];
check["binomial_coefficient_induction",coefficientInduction[binomialTerm]];
check["binomial_zero_extension",FullSimplify[Binomial[n,-1]==0&&Binomial[n,n+1]==0,naturalAssumptions]];
check["natural_power_zero_convention",naturalPower[0,0]==1&&naturalPower[p,0]==1&&naturalPower[q,0]==1];
check["binomial_row_support_induction",rowLengthInduction[]];
check["weighted_sum_transition_induction",weightedTransitionInduction[]];
check["weighted_sum_linearity_induction",foldInduction[fold[xs,i,a*ff[k]+b*gg[k]],a*fold[xs,i,ff[k]]+b*fold[xs,i,gg[k]]]];
check["weighted_sum_index_shift_induction",foldInduction[fold[xs,i+1,ff[k]],fold[xs,i,ff[k+1]]]];
check["moment_shift_polynomials",And@@Table[shiftBodyCertificate[order],{order,0,2}]];
check["binomial_normalization_mean_second_moment_induction",momentInduction[moments]];
check["centered_square_linearity_induction",foldInduction[fold[xs,i,(k-mu)^2],fold[xs,i,k^2]-2*mu*fold[xs,i,k]+mu^2*fold[xs,i,1]]];
check["binomial_variance_from_pmf",momentInduction[moments]&&foldInduction[fold[xs,i,(k-mu)^2],fold[xs,i,k^2]-2*mu*fold[xs,i,k]+mu^2*fold[xs,i,1]]&&Expand[moments[[3]]-2*n*p*moments[[2]]+(n*p)^2*moments[[1]]-n*p*(1-p)]==0];
check["binomial_parameter_domain",Resolve[ForAll[p,Equivalent[p>=0&&1-p>=0,0<=p<=1]],Reals]];
check["binomial_mass_nonnegative_induction",1>=0&&FullSimplify[qn*un+pn*vn>=0&&pn*un>=0,Element[{pn,qn,un,vn},Reals]&&pn>=0&&qn>=0&&un>=0&&vn>=0]];
check["sum_nonnegative_induction",0>=0&&FullSimplify[un+rest>=0,Element[{un,rest},Reals]&&un>=0&&rest>=0]];
check["single_coefficient_le_total_induction",singleCoefficientBoundInduction[]];
check["binomial_mass_at_most_one",singleCoefficientBoundInduction[]&&momentInduction[moments]&&Simplify[1-(1-rest)-rest]==0&&FullSimplify[rest>=0,Element[rest,Reals]&&rest>=0]];
check["endpoint_distribution_induction",endpointRecurrences[]];
check["endpoint_moments",Expand[(moments/.p->0)-{1,0,0}]=={0,0,0}&&Expand[(moments/.p->1)-{1,n,n^2}]=={0,0,0}];
check["wrong_coefficient_rejected",!coefficientInduction[Function[{size,index},{1,index,size-index}]]];
check["wrong_mean_rejected",!momentInduction[{1,n*p+1,moments[[3]]}]];
check["wrong_variance_moment_rejected",!momentInduction[{1,n*p,(n*p)^2+n*p}]];
check["outside_probability_counterexample",Binomial[1,0]*naturalPower[2,0]*naturalPower[1-2,1]==-1];
Print[ExportString[<|"backend"->"Wolfram","scope"->"n is an arbitrary natural number, 0<=p<=1, q=1-p. The row {1} advances by q times each old coefficient plus p times its predecessor, extended by zero. Pascal, both edges and the n=0 base certify each coefficient as binomial(n,k)*p^k*q^(n-k); monomials are polynomial natural powers, with power zero equal to one even at zero. Structural induction on finite rows derives the weighted-sum recurrence. Induction on n then proves normalization, mean and second moment from this actual recurrence, and finite-fold linearity gives variance. No finite sample of n, no generator assumed equal to the PMF, and no division by p or q are used. Endpoint recurrences retain p=0,1 and n=0.","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
