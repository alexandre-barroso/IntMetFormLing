ClearAll["Global`*"];
names={countTotal,len,laplaceRaw,laplaceNormalized,exponentialTotal,exponentialNormalized,shiftedExponentialTotal,dot,normSquared,updatedDot,generatedTotal,copiedTotal,mixtureTotal};
terms={count[head],1,count[head]+1,(count[head]+1)/den,Exp[score[head]],Exp[score[head]]/den,Exp[score[head]+shift],u[head]v[head],v[head]^2,(u[head]-rate(prob-target)v[head])v[head],g[head],c[head],weight g[head]+(1-weight)c[head]};
rules=Join[Table[names[[i]][nil]->0,{i,Length[names]}],Table[names[[i]][cons[head,tail]]->terms[[i]]+names[[i]][tail],{i,Length[names]}]];
unfold[expression_]:=expression/.rules;
assumptions=den>0&&count[head]>=0&&g[head]>=0&&c[head]>=0&&Element[{score[head],u[head],v[head],shift,rate,prob,target,weight},Reals];
structuralInduction[left_,right_]:=Module[{baseLeft,baseRight,hypothesisLeft,hypothesisRight,stepLeft,stepRight},If[!FreeQ[{left,right},head|tail],Return[False]];baseLeft=unfold[left/.xs->nil];baseRight=unfold[right/.xs->nil];If[!TrueQ[FullSimplify[baseLeft==baseRight,assumptions]],Return[False]];hypothesisLeft=left/.xs->tail;hypothesisRight=right/.xs->tail;stepLeft=unfold[left/.xs->cons[head,tail]]/.hypothesisLeft->hypothesisRight;stepRight=unfold[right/.xs->cons[head,tail]]/.hypothesisLeft->hypothesisRight;TrueQ[FullSimplify[stepLeft==stepRight,assumptions]]];
nonnegativeInduction[f_]:=If[unfold[f[nil]]=!=0,False,TrueQ[FullSimplify[(unfold[f[cons[head,tail]]]/.f[tail]->tailTotal)>=0,assumptions&&tailTotal>=0]]];
positiveNonempty[f_]:=nonnegativeInduction[f]&&TrueQ[FullSimplify[(unfold[f[cons[head,tail]]]/.f[tail]->tailTotal)>0,assumptions&&tailTotal>=0]];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["finite_fold_empty_definitions",And@@Table[unfold[f[nil]]==0,{f,names}]];
check["finite_fold_cons_definitions",And@@Table[unfold[names[[i]][cons[head,tail]]]==terms[[i]]+names[[i]][tail],{i,Length[names]}]];
check["laplace_numerator_induction",structuralInduction[laplaceRaw[xs],countTotal[xs]+len[xs]]];
check["laplace_division_induction",structuralInduction[laplaceNormalized[xs],(countTotal[xs]+len[xs])/den]];
check["laplace_nonempty_denominator",positiveNonempty[laplaceRaw]];
check["laplace_denominator_cancellation",FullSimplify[den/den==1,den>0]];
check["softmax_division_induction",structuralInduction[exponentialNormalized[xs],exponentialTotal[xs]/den]];
check["softmax_nonempty_denominator",positiveNonempty[exponentialTotal]];
check["softmax_component_positive",FullSimplify[Exp[score[head]]/den>0,assumptions]];
check["softmax_denominator_cancellation",FullSimplify[den/den==1,den>0]];
check["softmax_shift_induction",structuralInduction[shiftedExponentialTotal[xs],Exp[shift]exponentialTotal[xs]]];
check["softmax_shift_cancellation",FullSimplify[Exp[score[head]+shift]/(Exp[shift]den)==Exp[score[head]]/den&&Exp[shift]>0,assumptions]];
check["word2vec_dot_update_induction",structuralInduction[updatedDot[xs],dot[xs]-rate(prob-target)normSquared[xs]]];
check["norm_squared_induction",nonnegativeInduction[normSquared]];
check["mixture_sum_induction",structuralInduction[mixtureTotal[xs],weight generatedTotal[xs]+(1-weight)copiedTotal[xs]]];
check["mixture_unit_totals",Expand[weight 1+(1-weight)1]==1];
check["mixture_nonnegative",Resolve[ForAll[{weight,gg,cc},Implies[0<=weight<=1&&gg>=0&&cc>=0,weight gg+(1-weight)cc>=0]],Reals]];
check["false_base_rejected",!structuralInduction[exponentialNormalized[xs],exponentialTotal[xs]/den+1]];
check["false_step_rejected",!structuralInduction[updatedDot[xs],dot[xs]+rate(prob-target)normSquared[xs]]];
check["nonfresh_parameter_rejected",!structuralInduction[exponentialTotal[xs],exponentialTotal[xs]+head]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"induction on finite lists from explicit nil/cons recursions; positive denominators; nonnegative counts and component distributions","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
