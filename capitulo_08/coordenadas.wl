ClearAll["Global`*"];
assumptions=Element[{n,dk,dv,d,width},Integers]&&n>0&&dk>0&&dv>0&&d>0&&width>0;
matrixProductEntry[a_,b_,inner_,row_,column_]:=Module[{slot},Sum[a[row,slot]b[slot,column],{slot,1,inner}]];
transposeEntry[a_][row_,column_]:=a[column,row];
scaledScore[row_,column_]:=matrixProductEntry[query,transposeEntry[key],dk,row,column]/Sqrt[dk];
rowSoftmax[row_,column_]:=Module[{position},Exp[scaledScore[row,column]]/Sum[Exp[scaledScore[row,position]],{position,1,n}]];
attentionOutput[row_,coordinate_]:=matrixProductEntry[rowSoftmax,value,n,row,coordinate];
ffnHidden[coordinate_]:=Max[0,matrixProductEntry[input,firstWeight,d,1,coordinate]+firstBias[coordinate]];
ffnHiddenRow[row_,coordinate_]:=ffnHidden[coordinate];
ffnOutput[coordinate_]:=matrixProductEntry[ffnHiddenRow,secondWeight,width,1,coordinate]+secondBias[coordinate];
canonical[expr_]:=If[!FreeQ[expr,s_Symbol/;StringStartsQ[SymbolName[s],"proofIndex"]],Throw[$Failed],canonical[expr,0]];
canonical[expr_,depth_]:=If[AtomQ[expr],expr,If[Head[expr]===Sum,If[Length[expr]!=2||Length[expr[[2]]]!=3,Throw[$Failed]];Module[{variable=expr[[2,1]],index=Symbol["proofIndex"<>ToString[depth]],lower=expr[[2,2]],upper=expr[[2,3]],body},body=expr[[1]]/.variable->index;Inactive[Sum][canonical[body,depth+1],{index,lower,upper}]],Map[canonical[#,depth]&,expr]]];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["transpose_coordinate",transposeEntry[key][r,j]===key[j,r]];
check["scaled_score_composed_coordinate",canonical[scaledScore[i,j]]===canonical[Sum[query[i,r]key[j,r],{r,1,dk}]/Sqrt[dk]]];
check["scaled_score_positive_dimension",FullSimplify[Sqrt[dk]>0&&Sqrt[dk]!=0,assumptions]];
check["softmax_own_row_denominator",canonical[rowSoftmax[i,j]]===canonical[Exp[Sum[query[i,r]key[j,r],{r,1,dk}]/Sqrt[dk]]/Sum[Exp[Sum[query[i,r]key[m,r],{r,1,dk}]/Sqrt[dk]],{m,1,n}]]];
check["attention_composed_arbitrary_coordinate",canonical[attentionOutput[i,k]]===canonical[Sum[(Exp[Sum[query[i,r]key[j,r],{r,1,dk}]/Sqrt[dk]]/Sum[Exp[Sum[query[i,r]key[m,r],{r,1,dk}]/Sqrt[dk]],{m,1,n}])value[j,k],{j,1,n}]]];
check["ffn_hidden_arbitrary_coordinate",canonical[ffnHidden[j]]===canonical[Max[0,Sum[input[1,r]firstWeight[r,j],{r,1,d}]+firstBias[j]]]];
check["ffn_composed_arbitrary_coordinate",canonical[ffnOutput[k]]===canonical[Sum[Max[0,Sum[input[1,r]firstWeight[r,j],{r,1,d}]+firstBias[j]]secondWeight[j,k],{j,1,width}]+secondBias[k]]];
check["public_dimension_domains",FullSimplify[assumptions/.{d->512,dk->64,dv->64,width->2048},Element[n,Integers]&&n>0]];
check["bound_index_capture_rejected",Catch[canonical[proofIndex0+Sum[query[i,r],{r,1,dk}]]]===$Failed];
check["wrong_softmax_row_rejected",canonical[rowSoftmax[i,j]]=!=canonical[Exp[scaledScore[i,j]]/Sum[Exp[scaledScore[j,m]],{m,1,n}]]];
check["omitted_relu_rejected",canonical[ffnOutput[k]]=!=canonical[Sum[(Sum[input[1,r]firstWeight[r,j],{r,1,d}]+firstBias[j])secondWeight[j,k],{j,1,width}]+secondBias[k]]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"matrices represented by indexed real entries; multiplication defined by finite contraction and transposition by swapped indices; positive integer dimensions; capture-free bound-index normalization","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
