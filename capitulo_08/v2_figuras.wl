ClearAll[a, b, u, v, eta, check];
results = {};
check[name_, condition_] := If[TrueQ[condition], AppendTo[results, name], Print[name]; Exit[1]];
response = {233, 204, 242, 130, 112, 142};
loss = Total[(#-a)^2 & /@ Take[response,3]]+Total[(#-a-b)^2 & /@ Drop[response,3]];
excess = 3 u^2+3 (u+v)^2;
check["F11_loss_centering", Expand[(loss /. {a->u+679/3,b->v-295/3})-3734/3-excess]===0];
check["F11_optimum_sum",679/3-295/3===128];
check["F11_second_predictor", Expand[a+b-128-((a-679/3)+(b+295/3))]===0];
check["F11_nonnegative_and_unique_zero", Resolve[ForAll[{u,v}, excess>=0 && (excess==0 \[Equivalent] (u==0 && v==0))],Reals]];
gradient = {D[excess,u],D[excess,v]};
check["F11_gradient", (Expand /@ gradient)==={12 u+6 v,6 u+6 v}];
new = excess /. {u->u-eta gradient[[1]],v->v-eta gradient[[2]]};
qg = excess /. {u->gradient[[1]],v->gradient[[2]]};
check["F11_exact_step", Expand[new-excess+eta gradient.gradient-eta^2 qg]===0];
check["F11_general_local_descent", Resolve[ForAll[{aa,bb,tt}, tt>0 && tt bb<aa \[Implies] -tt aa+tt^2 bb<0],Reals]];
check["F11_plotted_values", (excess /. {u->-8,v->14})===300 && (gradient /. {u->-8,v->14})==={-12,36}];
check["F11_step_bound", 0<8/Sqrt[1440]<2/3];
check["F11_plotted_endpoint_decreases", FullSimplify[(new-excess)/.{u->-8,v->14,eta->8/Sqrt[1440]}]<0];
check["zero_context_no_update", Expand[z-alpha (p-y) 0]===z];
route={{0,0},{1,0},{2,1},{3,2},{4,3},{5,4},{5,5},{6,6},{7,7},{8,8},{9,9}};
sourceWord=Characters["intention"];
targetWord=Characters["execution"];
hops=Partition[route,2,1];
check["F09_adjacent_path",And@@(MemberQ[{{1,0},{0,1},{1,1}},#[[2]]-#[[1]]]&/@hops)];
cost=Total[If[#[[2]]-#[[1]]==={1,1},If[sourceWord[[#[[2,1]]]]===targetWord[[#[[2,2]]]],0,2],1]&/@hops];
check["F09_path_cost",First[route]==={0,0}&&Last[route]==={9,9}&&cost===8];
Print[ExportString[<|"passed"->True,"checks"->Length[results],"results"->results|>,"RawJSON"]];
