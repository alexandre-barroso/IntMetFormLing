ClearAll["Global`*"];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[<|"failed"->name,"value"->value|>];Exit[1]];
rules={dot[nil]->0,norm[nil]->0,updated[nil]->0,dot[cons[head,tail]]->u[head]v[head]+dot[tail],norm[cons[head,tail]]->v[head]^2+norm[tail],updated[cons[head,tail]]->(u[head]-rate(p-y)v[head])v[head]+updated[tail]};
unfold[x_]:=x/.rules;
updateInduction[sign_:-1]:=Module[{left=updated[xs],right=dot[xs]+sign*rate*(p-y)*norm[xs],base,step},base=Expand[unfold[left/.xs->nil]-unfold[right/.xs->nil]];step=(unfold[left/.xs->cons[head,tail]]/.(left/.xs->tail)->(right/.xs->tail))-unfold[right/.xs->cons[head,tail]];base===0&&Expand[step]===0];
nonzeroUnfold[sequence_]:=Which[sequence===nil,False,Head[sequence]===cons,v[sequence[[1]]]!=0||nonzero[sequence[[2]]],True,nonzero[sequence]];
positiveNormInduction[]:=Module[{base,split,nonnegativeStep,headBranch,tailBranch},base=unfold[norm[nil]]===0&&nonzeroUnfold[nil]===False;split=nonzeroUnfold[cons[head,tail]]===(v[head]!=0||nonzero[tail]);nonnegativeStep=FullSimplify[(unfold[norm[cons[head,tail]]]/.norm[tail]->tailNonnegative)>=0,Element[{v[head],tailNonnegative},Reals]&&tailNonnegative>=0];headBranch=FullSimplify[(unfold[norm[cons[head,tail]]]/.{v[head]->nonzeroHead,norm[tail]->tailNonnegative})>0,Element[{nonzeroHead,tailNonnegative},Reals]&&nonzeroHead!=0&&tailNonnegative>=0];tailBranch=FullSimplify[(unfold[norm[cons[head,tail]]]/.{v[head]->0,norm[tail]->tailPositive})>0,tailPositive>0];base&&split&&nonnegativeStep&&headBranch&&tailBranch];
probability=Exp[z]/(1+Exp[z]);
observed=-alpha*(probability-1)*s;
negative=-alpha*probability*s;
assumptions=Element[z,Reals]&&alpha>0&&s>0;
check["actual_finite_dot_update_induction",updateInduction[]];
check["nonzero_vector_strict_square_sum_induction",positiveNormInduction[]];
check["actual_sigmoid_positive",FullSimplify[probability>0,Element[z,Reals]]];
check["actual_sigmoid_below_one",Together[1-probability]===1/(1+Exp[z])&&FullSimplify[1/(1+Exp[z])>0,Element[z,Reals]]];
check["observed_pair_strict_increase",Together[observed]===alpha*s/(1+Exp[z])&&FullSimplify[alpha*s/(1+Exp[z])>0,assumptions]];
check["negative_pair_strict_decrease",FullSimplify[negative<0,assumptions]];
check["zero_context_not_strict",(observed/.s->0)===0&&(negative/.s->0)===0];
check["zero_step_not_strict",(observed/.alpha->0)===0&&(negative/.alpha->0)===0];
check["wrong_update_sign_rejected",!updateInduction[1]];
Print[ExportString[<|"backend"->"Wolfram Language","scope"->"arbitrary finite real vectors, context fixed and nonzero, positive step, sigmoid of finite real score, label zero or one; actual update fold and nonzero-square-sum induction","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
