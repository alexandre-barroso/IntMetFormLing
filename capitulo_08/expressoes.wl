results={};
check[id_,condition_] := AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
confusion={{8,10,1},{5,60,50},{3,30,200}};
tp=Diagonal[confusion];fp=(Total /@ confusion)-tp;fn=Total[confusion]-tp;
precision=tp/(tp+fp);recall=tp/(tp+fn);f1=2tp/(2tp+fp+fn);
check["confusion_totals",Total[Flatten[confusion]]==367 && Total[tp]==268];
check["confusion_components",tp=={8,60,200} && fp=={11,55,33} && fn=={8,40,51}];
check["urgent_metrics",{precision[[1]],recall[[1]],f1[[1]]}=={8/19,1/2,16/35}];
check["f1_classes",f1=={16/35,24/43,100/121}];
check["micro_f1",2Total[tp]/(2Total[tp]+Total[fp]+Total[fn])==268/367];
check["macro_f1",Total[f1]/3==(16/35+24/43+100/121)/3];
safe[a_,b_] := If[b==0,Missing["Undefined"],a/b];
check["undefined_precision",MissingQ[safe[0,0]] && safe[0,100]==0];
w={{1,1},{1,1}};bias={0,-1};
check["neural_matrix",w.{x1,x2}+bias=={x1+x2,x1+x2-1}];
h=Max[0,#]& /@ (w.{x1,x2}+bias);
check["neural_hidden",h=={Max[0,x1+x2],Max[0,x1+x2-1]}];
y=Max[0,h[[1]]-2h[[2]]];
check["neural_all_inputs",(y/.Thread[{x1,x2}->#]& /@ {{0,0},{0,1},{1,0},{1,1}})=={0,1,1,0}];
project[x_,w_,i_,j_,d_] := Sum[x[i,r]w[r,j],{r,1,d}];
score[q_,k_,i_,j_,d_] := Sum[q[i,r]k[j,r],{r,1,d}]/Sqrt[d];
attend[alpha_,v_,i_,r_,n_] := Sum[alpha[i,j]v[j,r],{j,1,n}];
check["projection_entry",project[xx,ww,i,j,d]==Sum[xx[i,r]ww[r,j],{r,1,d}]];
check["score_entry",score[qq,kk,i,j,d]==Sum[qq[i,r]kk[j,r],{r,1,d}]/Sqrt[d]];
check["attention_entry",attend[aa,vv,i,r,n]==Sum[aa[i,j]vv[j,r],{j,1,n}]];
check["attention_weights",FullSimplify[ss/ss==1,ss>0]];
check["attention_sum_step",Together[a/ss+b/ss-(a+b)/ss]==0];
hidden[j_] := Max[0,Sum[xx[r]w1[r,j],{r,1,d}]+b1[j]];
ff[k_] := Sum[hidden[j]w2[j,k],{j,1,width}]+b2[k];
check["feed_forward_entry",ff[k]==Sum[Max[0,Sum[xx[r]w1[r,j],{r,1,d}]+b1[j]]w2[j,k],{j,1,width}]+b2[k]];
check["cbow_coordinate",Expand[(v0+v1+v2+v3)/4-(1/4)(v0+v1+v2+v3)]==0];
Clear[y];
check["brier_binary",Expand[(p-y)^2+((1-p)-(1-y))^2-2(p-y)^2]==0];
check["grouped_mean",Together[(nc(sc/nc)+ne(se/ne))/(nc+ne)-(sc+se)/(nc+ne)]==0];
check["likelihood_log",FullSimplify[Log[p^608(1-p)^319]==608 Log[p]+319 Log[1-p],0<p<1]];

check["ot_first_preference",Resolve[ForAll[{w1,w2},Equivalent[-w1-w2>-2w1,w1>w2]],Reals]];
check["ot_second_preference",Resolve[ForAll[{w1,w2},Equivalent[-w1>-w2,w2>w1]],Reals]];
check["ot_incompatible_preferences",Reduce[-w1-w2>-2w1&&-w1>-w2,{w1,w2},Reals]===False];
check["ot_margin_regions",Resolve[ForAll[{w1,w2},Equivalent[w1-w2>=1,w2<=w1-1]&&Equivalent[w2-w1>=1,w2>=w1+1]],Reals]];
check["ot_incompatible_margins",Reduce[w1-w2>=1&&w2-w1>=1,{w1,w2},Reals]===False];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And @@ Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
