ClearAll[matrixType, matrixTranspose, matrixMultiply, matrixScale, matrixSoftmaxRows, matrixEntry, matrixDimensions, n, dk, dv];
results = {};
check[name_, condition_] := If[TrueQ[condition], AppendTo[results, <|"id" -> name, "passed" -> True|>], Print[name]; Exit[1]];
matrixTranspose[matrixType[r_, c_, f_]] := matrixType[c, r, Function[{i, j}, f[j, i]]];
matrixMultiply[matrixType[r_, k_, f_], matrixType[l_, c_, g_]] := If[SameQ[k, l], Module[{idx = Unique["contraction"]}, matrixType[r, c, Function[{i, j}, Evaluate[Inactive[Sum][f[i, idx] g[idx, j], {idx, 1, k}]]]]], $Failed];
matrixScale[a_, matrixType[r_, c_, f_]] := matrixType[r, c, Function[{i, j}, a f[i, j]]];
matrixSoftmaxRows[matrixType[r_, c_, f_]] := Module[{idx = Unique["normalization"]}, matrixType[r, c, Function[{i, j}, Evaluate[Exp[f[i, j]]/Inactive[Sum][Exp[f[i, idx]], {idx, 1, c}]]]]];
matrixDimensions[matrixType[r_, c_, _]] := {r, c};
matrixEntry[matrixType[_, _, f_], i_, j_] := f[i, j];
queries = matrixType[n, dk, q];
keys = matrixType[n, dk, k];
values = matrixType[n, dv, v];
scores = matrixScale[1/Sqrt[dk], matrixMultiply[queries, matrixTranspose[keys]]];
weights = matrixSoftmaxRows[scores];
output = matrixMultiply[weights, values];
check["attention_arbitrary_score_dimensions", matrixDimensions[scores] === {n, n}];
check["attention_arbitrary_weight_dimensions", matrixDimensions[weights] === {n, n}];
check["attention_arbitrary_output_dimensions", matrixDimensions[output] === {n, dv}];
scoreTerm = Sqrt[dk] matrixEntry[scores, i, j];
check["attention_arbitrary_score_entry", MatchQ[scoreTerm, Inactive[Sum][_, {_, 1, dk}]] && With[{idx = scoreTerm[[2, 1]]}, scoreTerm[[1]] === q[i, idx] k[j, idx]]];
outputTerm = matrixEntry[matrixMultiply[matrixType[n, n, w], values], i, j];
check["attention_arbitrary_output_entry", MatchQ[outputTerm, Inactive[Sum][_, {_, 1, n}]] && With[{idx = outputTerm[[2, 1]]}, outputTerm[[1]] === w[i, idx] v[idx, j]]];
check["attention_dimension_mismatch_rejected", matrixMultiply[matrixType[n, dk, q], matrixType[dv, n, k]] === $Failed];
Print[ExportString[<|"passed" -> True, "results" -> results, "scope" -> "Arbitrary positive integer dimensions n, dk and dv. Typed matrix constructors expose every matrix-product entry as a finite sum, row normalization preserves dimensions, and contraction checks matching inner dimensions."|>, "RawJSON"]];
