takeSuccessorInduction[]:=Catch[Module[{n=pt["nat","n"],head=pt["letter","head"],tail=pt["v","tail"],sides,baseLeft,baseRight,ihLeft,ihRight,stepLeft,stepRight,nn=var["index"],ll=var["length_tail"]},sides[index_,lst_]:={pt["take",pt["succ",index],lst],pt["append",pt["take",index,lst],pt["cons",pt["at",index,lst],{"nil"}]]};{baseLeft,baseRight}=sides[{"zero"},pt["cons",head,tail]];If[pn[baseLeft]=!=pn[baseRight],Throw[False,"proof"]];{ihLeft,ihRight}=sides[n,tail];{stepLeft,stepRight}=sides[pt["succ",n],pt["cons",head,tail]];If[pn[pr[pn[stepLeft],pn[ihLeft],pn[ihRight]]]=!=pn[stepRight]||!TrueQ[FullSimplify[!(nn<0),nn>=0]]||!exact[(ll+1)-(nn+1),ll-nn],Throw[False,"proof"]];AssociateTo[proved,"take_successor"->True];True],"proof"];
takeLengthInduction[]:=Catch[Module[{n=pt["nat","n"],head=pt["letter","head"],tail=pt["v","tail"],lhs,ih,nn=var["index"]},If[pn[pt["length",pt["take",{"zero"},tail]]]=!={"zero"},Throw[False,"proof"]];lhs=pt["length",pt["take",pt["succ",n],pt["cons",head,tail]]];ih=pt["length",pt["take",n,tail]];If[pn[pr[pn[lhs],ih,n]]=!=pt["succ",n]||!TrueQ[FullSimplify[!(nn+1<=0),nn>=0]],Throw[False,"proof"]];AssociateTo[proved,"take_length_bounded"->True];True],"proof"];
prefixCertificate[insertionCost_:1]:=Catch[Module[{i=pt["nat","i"],j=pt["nat","j"],x=pt["v","x"],y=pt["v","y"],preX,preY,ax,by,fullX,fullY,snocX,snocY,rhs,converted,schemaLeft,schemaRight,replacements,insertion},If[!And@@(KeyExistsQ[proved,#]&/@{"snoc_recurrence","alignment_borders","take_successor","take_length_bounded"}),Throw[False,"proof"]];{preX,preY}={pt["take",i,x],pt["take",j,y]};{ax,by}={pt["at",i,x],pt["at",j,y]};{fullX,fullY}={pt["take",pt["succ",i],x],pt["take",pt["succ",j],y]};{snocX,snocY}={pt["append",preX,pt["cons",ax,{"nil"}]],pt["append",preY,pt["cons",by,{"nil"}]]};rhs[sx_,sy_]:=(insertion=Nest[pt["succ",#]&,pt["distance",sx,preY],insertionCost];pt["minimum",pt["succ",pt["distance",preX,sy]],pt["minimum",insertion,pt["plus",pt["distance",preX,preY],pt["delta",ax,by]]]]);converted=pr[pr[rhs[fullX,fullY],fullX,snocX],fullY,snocY];{schemaLeft,schemaRight}=certifiedSchemas["snoc_recurrence"];replacements={{pt["v","px"],preX},{pt["v","py"],preY},{pt["letter","ax"],ax},{pt["letter","by"],by}};Do[schemaLeft=pr[schemaLeft,pair[[1]],pair[[2]]];schemaRight=pr[schemaRight,pair[[1]],pair[[2]]],{pair,replacements}];If[converted=!=schemaRight||pr[pr[pt["distance",fullX,fullY],fullX,snocX],fullY,snocY]=!=schemaLeft,Throw[False,"proof"]];AssociateTo[proved,"prefix_recurrence"->True];True],"proof"];
prefixBoundaryCertificate[]:=Catch[Module[{i=pt["nat","i"],x=pt["v","x"],prefix,expr},If[!And@@(KeyExistsQ[proved,#]&/@{"take_length_bounded","minimum_edit_cost","alignment_borders"}),Throw[False,"proof"]];prefix=pt["take",i,x];Do[expr=pn[pt["distance",pair[[1]],pair[[2]]]];If[pn[pr[expr,pt["length",prefix],i]]=!=i,Throw[False,"proof"]],{pair,{{prefix,{"nil"}},{{"nil"},prefix}}}];AssociateTo[proved,"prefix_boundary"->True];True],"proof"];

SetAttributes[rejected,HoldAll];
rejected[e_]:=MatchQ[Catch[e,"certificate",Function[{value,tag},{"rejected",value}]],{"rejected",_}];
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[<|"failed"->name,"value"->value|>];Exit[1]];
check["alignment_reflexivity_induction",reflexivityInduction[]];
