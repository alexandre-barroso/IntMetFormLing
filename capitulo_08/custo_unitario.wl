hammingSubstitutionInduction[]:=Catch[Module[{m=unitMismatch[ua,ub],letters,a,b,c0,source,other,target,expressions,substitution,lower,upper,left,right,ih},If[!KeyExistsQ[unitProved,"mismatch_triangle"]||!bound[0,m,{},{},m],Throw[False,"unitproof"]];Do[letters=letter["class"<>ToString[#]]&/@triple;{a,b,c0}=letters;source=cons[a,ut];other=cons[b,ut];target=cons[c0,uz];expressions={hammingStep[source,target],unitMismatch[a,b]+hammingStep[other,target]};substitution=DeleteDuplicates[Flatten[Table[If[x=!=y,{unitMismatch[x,y]->Boole[x=!=y]},{}],{x,letters},{y,letters}],2]];{lower,upper}=expressions/.substitution;If[!nonnegative[upper-lower],Throw[False,"unitproof"]],{triple,equalityPartitions[]}];left=hammingStep[cons[uc,Join[up,cons[ua,ut]]],cons[ue,uz]];right=m+hammingStep[cons[uc,Join[up,cons[ub,ut]]],cons[ue,uz]];ih={hammingAtom[Join[up,cons[ua,ut]],uz],m+hammingAtom[Join[up,cons[ub,ut]],uz]};If[!bound[left,right,{ih},{1}],Throw[False,"unitproof"]];AssociateTo[unitProved,"hamming_substitution"->True];True],"unitproof"];
contradiction[premises_,weights_]:=Length[premises]==Length[weights]&&And@@(#>=0&/@weights)&&TrueQ[Expand[Total[MapThread[#1*(#2[[2]]-#2[[1]])&,{weights,premises}]]]<0];
