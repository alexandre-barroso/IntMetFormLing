ClearAll["Global`*"];
assumptions=Element[{k,m},Integers]&&k>0&&m>0&&Element[b,Matrices[{k,m},Reals]]&&Element[h,Vectors[m,Reals]]&&Element[g,Vectors[m,Reals]];
productEntry[a_,v_,row_,dimension_]:=Module[{index},Sum[a[row,index]v[index],{index,1,dimension}]];
difference[index_]:=hh[index]-gg[index];
transformed[index_]:=productEntry[bb,difference,index,m];
vectorProduct[u_,v_,dimension_]:=Module[{index},Sum[u[index]v[index],{index,1,dimension}]];
canonical[expr_]:=If[!FreeQ[expr,s_Symbol/;StringStartsQ[SymbolName[s],"probeIndex"]],Throw[$Failed],canonical[expr,0]];
canonical[expr_,depth_]:=If[AtomQ[expr],expr,If[Head[expr]===Sum,If[Length[expr]!=2||Length[expr[[2]]]!=3,Throw[$Failed]];Module[{variable=expr[[2,1]],index=Symbol["probeIndex"<>ToString[depth]],lower=expr[[2,2]],upper=expr[[2,3]],body},body=expr[[1]]/.variable->index;Inactive[Sum][canonical[body,depth+1],{index,lower,upper}]],Map[canonical[#,depth]&,expr]]];
rules={squareSum[nil]->0,squareSum[cons[head,tail]]->head^2+squareSum[tail],selfDot[nil]->0,selfDot[cons[head,tail]]->head head+selfDot[tail],negatedSquares[nil]->0,negatedSquares[cons[head,tail]]->(-head)^2+negatedSquares[tail]};
unfold[expression_]:=expression/.rules;
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["probe_arbitrary_dimensions",TensorDimensions[b.(h-g),Assumptions->assumptions]=={k}];
check["swap_negates_actual_linear_transform",TensorReduce[b.(g-h)+b.(h-g),Assumptions->assumptions]===SymbolicZerosArray[{k}]];
check["swap_preserves_actual_squared_norm",TensorDimensions[TensorProduct[b.(h-g),b.(h-g)],Assumptions->assumptions]=={k,k}&&TensorDimensions[TensorContract[TensorProduct[b.(h-g),b.(h-g)],{{1,2}}],Assumptions->assumptions]=={}&&TensorReduce[TensorContract[TensorProduct[b.(h-g),b.(h-g)],{{1,2}}]-TensorContract[TensorProduct[b.(g-h),b.(g-h)],{{1,2}}],Assumptions->assumptions]===0];
check["u_transpose_u_is_sum_of_squares",canonical[vectorProduct[uu,uu,k]]===canonical[Sum[uu[r]^2,{r,1,k}]]];
check["probe_squared_coordinate_expansion",canonical[vectorProduct[transformed,transformed,k]]===canonical[Sum[Sum[bb[r,j](hh[j]-gg[j]),{j,1,m}]^2,{r,1,k}]]];
check["finite_self_dot_base",unfold[selfDot[nil]]==unfold[squareSum[nil]]];
check["finite_self_dot_step",Expand[(unfold[selfDot[cons[head,tail]]]-unfold[squareSum[cons[head,tail]]])/.selfDot[tail]->squareSum[tail]]==0];
check["finite_square_fold_base",unfold[squareSum[nil]]==0];
nonnegativeStep=unfold[squareSum[cons[head,tail]]]/.squareSum[tail]->tailSum;
check["finite_square_fold_nonnegative_step",FullSimplify[nonnegativeStep>=0,Element[head,Reals]&&tailSum>=0]];
check["finite_square_fold_symmetry_base",unfold[negatedSquares[nil]]==unfold[squareSum[nil]]];
check["finite_square_fold_symmetry_step",Expand[(unfold[negatedSquares[cons[head,tail]]]-unfold[squareSum[cons[head,tail]]])/.negatedSquares[tail]->squareSum[tail]]==0];
check["negative_square_claim_rejected",!Resolve[ForAll[{head,tailSum},Implies[tailSum>=0,-head^2+tailSum>=0]],Reals]];
check["bound_index_capture_rejected",Catch[canonical[probeIndex0+Sum[uu[r]^2,{r,1,k}]]]===$Failed];
check["norm_square_is_not_metric",(0-2)^2>(0-1)^2+(1-2)^2];
check["noninjective_probe_can_collapse_distinct_vectors",{{1,0}}.{0,1}=={0}&&{0,1}!={0,0}];
Print[ExportString[<|"backend"->"Wolfram","scope"->"real matrices with arbitrary positive integer dimensions; matrix-vector product defined by finite contraction; finite nil/cons induction; no injectivity or metric claim","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
