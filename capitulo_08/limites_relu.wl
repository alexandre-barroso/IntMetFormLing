ClearAll["Global`*"];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[<|"failed"->name,"value"->value|>];Exit[1]];
rho=Max[0,x];
zero=rho/.x->0;
left=FullSimplify[rho/.x->-h,Assumptions->h>0];
right=FullSimplify[rho/.x->h,Assumptions->h>0];
leftQuotient=Cancel[(left-zero)/(-h)];
rightQuotient=Cancel[(right-zero)/h];
check["actual_max_left_branch",left===0];
check["actual_max_right_branch",right===h];
check["actual_value_at_zero",zero===0];
check["one_sided_limits_equal_actual_value",Limit[left,h->0,Direction->"FromAbove"]==zero&&Limit[right,h->0,Direction->"FromAbove"]==zero];
check["actual_left_difference_quotient",leftQuotient===0];
check["actual_right_difference_quotient",rightQuotient===1];
check["one_sided_derivatives_disagree",Limit[leftQuotient,h->0,Direction->"FromAbove"]===0&&Limit[rightQuotient,h->0,Direction->"FromAbove"]===1];
check["equal_slopes_rejected",leftQuotient=!=rightQuotient];
check["altered_intercept_breaks_continuity",Limit[left+1,h->0,Direction->"FromAbove"]!=zero];
Print[ExportString[<|"backend"->"Wolfram Language","scope"->"actual real Max(0,x), symbolic h>0, both one-sided limits and actual difference quotients at zero","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
