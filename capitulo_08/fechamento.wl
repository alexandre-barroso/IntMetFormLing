ClearAll["Global`*"];
results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
check["context_adjacent_transposition",Cancel[(prefix+a+b+suffix)/n-(prefix+b+a+suffix)/n]==0];
check["context_denominator_positive",Resolve[ForAll[n,Implies[n>0,n!=0]],Reals]];
check["context_all_four_permutations",And@@(Expand[Total[#]/4-Total[{v1,v2,v3,v4}]/4]==0&/@Permutations[{v1,v2,v3,v4}])];
profiles={{2,0},{1,1},{1,1},{0,2}};
harmony=(-{w1,w2}.#)&/@profiles;
check["potts_exact_profiles",harmony=={-2w1,-w1-w2,-w1-w2,-2w2}];
check["potts_complete_deletion_hg",Resolve[ForAll[{w1,w2},Implies[w1>w2,And@@Thread[harmony[[4]]>harmony[[1;;3]]]]],Reals]];
check["potts_complete_deletion_ot",And@@(profiles[[4,1]]<#[[1]]&/@profiles[[1;;3]])];
check["squared_distance_triangle_fails",(0-2)^2>(0-1)^2+(1-2)^2];
projection={{1,0}};x={1,0};y={1,1};
check["projection_collapses_distinct_vectors",x!=y&&projection.x==projection.y];
eraseBoundaries[sequence_List]:=DeleteCases[sequence,"-"];
check["erasure_empty",eraseBoundaries[{}]=={}];
check["erasure_kept_nonmarker_step",eraseBoundaries[{head,tailErased}]==Prepend[eraseBoundaries[{tailErased}],head]];
check["erasure_marker_step",eraseBoundaries[{"-",tailErased}]==eraseBoundaries[{tailErased}]];
check["canonical_requires_nonboundary_change",eraseBoundaries[Characters["Cylinder-ical-ly"]]!=eraseBoundaries[Characters["Cylindrically"]]];
values={1,0,1,0};phiA=((values[[2]]-values[[1]])+(values[[4]]-values[[3]]))/2;
check["shapley_valid_performances",And@@(0<=#<=1&/@values)];
check["shapley_negative_contribution",phiA==-1&&phiA<0];
report=<|"backend"->"Wolfram Language","scope"->"General adjacent-transposition identity and complete four-neighbor permutation check; exact Potts profiles with general weight inequalities; exact distance countermodels. Arbitrary finite permutation theorem is checked in Lean.","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
