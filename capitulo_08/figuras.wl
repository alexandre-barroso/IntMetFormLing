ClearAll["Global`*"];
results={};
check[id_,value_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[value]|>];
close[actual_,published_,digits_]:=Abs[N[actual,80]-published]<1/(2*10^digits);
check["loss_positive_point",close[-Log[7/10],356674944/1000000000,9]];
check["loss_negative_point",close[-Log[3/10],1203972804/1000000000,9]];
check["loss_start_point",close[Log[2],693147181/1000000000,9]];
check["sigmoid_point",close[1/(1+Exp[-833/1000]),6969888901/10000000000,10]];
check["gradient_loss_point",close[Log[1+Exp[7/10]]-7/10,403186049/1000000000,9]];
check["gradient_loss_identity",FullSimplify[Log[1+Exp[z]]-z==Log[1+Exp[-z]],Element[z,Reals]]];
check["relu_negative",FullSimplify[Max[0,z]==0,z<=0]];
check["relu_positive",FullSimplify[Max[0,z]==z,z>=0]];
check["relu_graph_points",Map[Max[0,#]&,{-12/10,0,2}]=={0,0,2}];
check["constraint_arrows",FullSimplify[(w+1+2/5)-(w-2/5)>1&&(w+2/5)-(w-1-2/5)>1,Element[w,Reals]]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->AllTrue[results,TrueQ[#["passed"]]&],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[TrueQ[report["passed"]],0,1]];
