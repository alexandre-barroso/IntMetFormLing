ClearAll["Global`*"];
nil={"nil"};
word[name_]:={"word",name};
cons[a_,tail_]:={"cons",a,tail};
cat[a_,b_]:={"cat",a,b};
normal[t_]:=Module[{a,b},Switch[t[[1]],"nil"|"word",t,"cons",cons[t[[2]],normal[t[[3]]]],"cat",a=normal[t[[2]]];b=normal[t[[3]]];Which[a===nil,b,b===nil,a,a[[1]]=="cons",cons[a[[2]],normal[cat[a[[3]],b]]],True,cat[a,b]],_,Throw[$Failed]]];
wordLength[t_]:=Switch[t[[1]],"nil",0,"word",len[t[[2]]],"cons",1+wordLength[t[[3]]],"cat",wordLength[t[[2]]]+wordLength[t[[3]]],_,Throw[$Failed]];
operation[kind_,pre_,post_,a_:"a",b_:"b"]:=Module[{old=normal[cat[pre,cons[a,post]]],short=normal[cat[pre,post]]},Switch[kind,"delete",{old,short,1},"insert",{short,old,1},"substitute",{old,normal[cat[pre,cons[b,post]]],If[a===b,0,2]},_,Throw[$Failed]]];
verify[proof_,hypotheses_]:=Module[{first,second},Switch[proof[[1]],
"hyp",If[!KeyExistsQ[hypotheses,proof[[2]]],Throw[$Failed]];hypotheses[proof[[2]]],
"refl",{normal[proof[[2]]],normal[proof[[2]]],0},
"step",first=operation@@proof[[2]];second=verify[proof[[3]],hypotheses];If[normal[first[[2]]]=!=normal[second[[1]]],Throw[$Failed]];{normal[first[[1]]],normal[second[[2]]],first[[3]]+second[[3]]},
"compose",first=verify[proof[[2]],hypotheses];second=verify[proof[[3]],hypotheses];If[normal[first[[2]]]=!=normal[second[[1]]],Throw[$Failed]];{normal[first[[1]]],normal[second[[2]]],first[[3]]+second[[3]]},_,Throw[$Failed]]];
allPathLengthBounds[extra_:0]:=Module[{pre=word["pre"],post=word["post"],z=word["z"],step,x,y,c,k,forward,backward},TrueQ[Expand[wordLength[pre]+0-wordLength[pre]]==0]&&And@@Table[step=operation[spec[[1]],pre,post,spec[[2]],spec[[3]]];{x,y,c}=step;c+=extra;forward=wordLength[z]+k-wordLength[y];backward=wordLength[y]+k-wordLength[z];TrueQ[Expand[wordLength[y]+c-wordLength[x]]>=0]&&TrueQ[Expand[wordLength[x]+c-wordLength[y]]>=0]&&TrueQ[Expand[wordLength[z]+c+k-wordLength[x]-forward-(wordLength[y]+c-wordLength[x])]==0]&&TrueQ[Expand[wordLength[x]+c+k-wordLength[z]-backward-(wordLength[x]+c-wordLength[y])]==0],{spec,{{"delete","a","b"},{"insert","a","b"},{"substitute","a","b"},{"substitute","a","a"}}}]];
constructiveInduction[direction_,extra_:0]:=Module[{tail=word["tail"],hypotheses,proof,goal,target,result},If[verify[{"refl",nil},<||>]=!={nil,nil,0},Return[False]];Switch[direction,
"delete",hypotheses=<|"tail"->{tail,nil,wordLength[tail]}|>;proof={"step",{"delete",nil,tail},{"hyp","tail"}};goal={cons["a",tail],nil,wordLength[cons["a",tail]]+extra},
"insert",target=normal[cat[tail,cons["a",nil]]];hypotheses=<|"tail"->{nil,tail,wordLength[tail]}|>;proof={"compose",{"hyp","tail"},{"step",{"insert",tail,nil},{"refl",target}}};goal={nil,target,wordLength[target]+extra},_,Throw[$Failed]];result=verify[proof,hypotheses];Take[result,2]===Take[goal,2]&&Expand[result[[3]]-goal[[3]]]===0];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["operation_length_changes",And@@MapThread[Function[{kind,delta},With[{op=operation[kind,word["pre"],word["post"]]},Expand[wordLength[op[[2]]]-wordLength[op[[1]]]]==delta]],{{"delete","insert","substitute"},{-1,1,0}}]];
check["substitution_cost_cases",operation["substitute",word["pre"],word["post"],"a","a"][[3]]==0&&operation["substitute",word["pre"],word["post"],"a","b"][[3]]==2];
check["nonnegative_addition",Resolve[ForAll[{a,b},Implies[a>=0&&b>=0,a+b>=0]],Reals]];
check["composition_length_bounds",Expand[(lz+c+k-lx)-(ly+c-lx)-(lz+k-ly)]==0&&Expand[(lx+c+k-lz)-(lx+c-ly)-(ly+k-lz)]==0];
check["all_finite_path_length_bounds",allPathLengthBounds[]];
check["zero_cost_deletion_rejected",!allPathLengthBounds[-1]];
check["delete_all_structural_certificate",Catch[constructiveInduction["delete"]]];
check["insert_all_structural_certificate",Catch[constructiveInduction["insert"]]];
check["incorrect_constructive_cost_rejected",!Catch[constructiveInduction["delete",-1]]&&!Catch[constructiveInduction["insert",1]]];
check["unmatched_path_rejected",Catch[verify[{"step",{"delete",nil,word["tail"]},{"refl",nil}},<||>]]===$Failed];
check["prefix_length_domain",FullSimplify[Min[i,i+slack]==i,i>=0&&slack>=0]];
check["empty_target_lower_bound",Resolve[ForAll[{i,c},Equivalent[i<=0+c,c>=i]],Reals]];
check["empty_source_lower_bound",Resolve[ForAll[{i,c},Equivalent[i<=0+c,c>=i]],Reals]];
check["delete_boundary_minimum",allPathLengthBounds[]&&Catch[constructiveInduction["delete"]]&&FullSimplify[Min[i,i+slack]==i,i>=0&&slack>=0]];
check["insert_boundary_minimum",allPathLengthBounds[]&&Catch[constructiveInduction["insert"]]&&FullSimplify[Min[i,i+slack]==i,i>=0&&slack>=0]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"induction over every edit-path constructor and finite-word constructor; deletion/insertion cost1; substitution cost0 for equal symbols and2 otherwise; both equality cases checked; prefix length within the source","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
