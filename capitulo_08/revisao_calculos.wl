reviewTransitions[q_,c_]:=If[MemberQ[{0,1},q],If[c=="d",{{1,"d"},{2,"t"}},If[MemberQ[{"t","a"},c],{{0,c}},{}]],{}];
reviewTraces[q_,{}]:={{{q},""}};
reviewTraces[q_,word_List]:=Flatten[Table[({Prepend[#[[1]],q],edge[[2]]<>#[[2]]}& /@ reviewTraces[edge[[1]],Rest[word]]),{edge,reviewTransitions[q,First[word]]}],1];
