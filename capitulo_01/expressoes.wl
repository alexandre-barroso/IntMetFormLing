results = {};
check[id_, condition_] := AppendTo[results, <|"id" -> id, "passed" -> TrueQ[condition]|>];
nTotal = 4112943;
q = 195/nTotal;
expected = 660 q;
ratioValue = 29/expected;
check["association_bindings", {nTotal,q,expected,ratioValue} == {4112943,195/4112943,128700/4112943,119275347/128700}];
check["association_bounds", 3/100 < expected < 4/100 && 926 < ratioValue < 927];
check["segmentation_bindings", {Length[{"I'm"}],Length[{"I","am"}],Length[{"I","am"}]-Length[{"I'm"}]} == {1,2,1}];
second = 1; millisecond = 1/1000;
check["units_and_percent", 8/100 second == 80 millisecond && 24/100 second == 240 millisecond && (14/100-3/100)second == 110 millisecond && 16/100 second == 160 millisecond && 14/16 == (875/10)/100];
concordance = {23,27,5,10};
check["concordance_sum", Total[concordance] == 65 && Total[concordance/65] == 1];
check["four_term_sum", Total[{x1,x2,x3,x4}] == x1+x2+x3+x4];
check["interval_membership", Resolve[ForAll[t,Equivalent[3/100 <= t <= 14/100, t >= 3/100 && t <= 14/100]],Reals]];
check["rate_numerator", FullSimplify[c/total*120000 == c*120000/total,total > 0]];
check["rate_bindings", Map[120000 #[[1]]/#[[2]] &,{{14,168799},{242,4623107},{180,1012985},{236,1009304}}] == {1680000/168799,29040000/4623107,21600000/1012985,28320000/1009304}];
check["reversed_relative_difference", (584/10-706/10)/(706/10) == -61/353 && -61/353 != -61/292];
check["arbitrary_mean_base", FullSimplify[0/n == 0,n > 0]];
check["arbitrary_mean_step", FullSimplify[(subtotal+next)/n == subtotal/n+next/n,n > 0]];
check["arbitrary_weights", FullSimplify[Sum[1/n,{i,1,n}] == 1,n > 0 && Element[n,Integers]]];
safeRatio[a_,b_] := If[TrueQ[b == 0],Missing["Undefined"],a/b];
check["zero_denominator_undefined", MissingQ[safeRatio[0,0]]];
check["positive_denominator_defined", safeRatio[c,total] == c/total];
check["zero_equation_not_unique", Resolve[ForAll[u,0 u == 0],Reals]];
report = <|"backend" -> "Wolfram", "checks" -> Length[results], "passed" -> AllTrue[results,TrueQ[#["passed"]]&], "results" -> results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[TrueQ[report["passed"]],0,1]];
