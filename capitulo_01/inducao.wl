ClearAll["Global`*"];
total[nil]=0;
total[cons[head_,tail_]]:=head+total[tail];
weighted[nil]=0;
weighted[cons[head_,tail_]]:=head/n+weighted[tail];
structuralInduction[left_,right_]:=Module[{baseLeft,baseRight,hypothesisLeft,hypothesisRight,stepLeft,stepRight},If[!FreeQ[{left,right},head|tail],Return[False]];baseLeft=left/.xs->nil;baseRight=right/.xs->nil;If[!TrueQ[FullSimplify[baseLeft==baseRight,Element[n,Integers]&&n>0]],Return[False]];hypothesisLeft=left/.xs->tail;hypothesisRight=right/.xs->tail;stepLeft=left/.xs->cons[head,tail];stepRight=(right/.xs->cons[head,tail])/.hypothesisRight->hypothesisLeft;TrueQ[FullSimplify[stepLeft==stepRight,Element[{n,head,total[tail]},Reals]&&n>0]]];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["recursive_total_nil",total[nil]==0];
check["recursive_total_cons",total[cons[head,tail]]==head+total[tail]];
check["recursive_weighted_nil",weighted[nil]==0];
check["recursive_weighted_cons",weighted[cons[head,tail]]==head/n+weighted[tail]];
check["mean_distributivity_induction",structuralInduction[total[xs]/n,weighted[xs]]];
check["false_base_rejected",!structuralInduction[total[xs]/n,weighted[xs]+1]];
check["false_step_rejected",!structuralInduction[total[xs],weighted[xs]]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"structural induction on finite real lists from explicit total and weighted-sum recursions; n fixed positive","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
