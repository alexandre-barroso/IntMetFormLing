results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
fold[nil,body_]:=0;
fold[cons[first_,second_,rest_],body_]:=(body/.{a->first,b->second})+fold[rest,body];
foldIdentityInduction[left_,right_,absoluteValueRule_:False]:=Module[{base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},If[!FreeQ[{left,right},tail|u|v],Return[False]];base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.xs->tail;hypothesisRight=right/.xs->tail;stepLeft=(left/.xs->cons[u,v,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[u,v,tail];If[absoluteValueRule,stepLeft=stepLeft/.Abs[u-v]->u+v-2Min[u,v];stepRight=stepRight/.Abs[u-v]->u+v-2Min[u,v]];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
sumNonnegativeInduction[]:=Module[{base,step,expected,constrained},base=fold[nil,ff[a,b]];step=fold[cons[u,v,tail],ff[a,b]];expected=ff[u,v]+fold[tail,ff[a,b]];constrained=step/.{ff[u,v]->head,fold[tail,ff[a,b]]->remainder};TrueQ[base==0&&step===expected&&FullSimplify[constrained>=0,head>=0&&remainder>=0]]];
check["dp_absolute_min_cases",FullSimplify[Abs[a-b]==a+b-2Min[a,b]&&Abs[a-b]>=0,Element[{a,b},Reals]]];
check["dp_pointwise_min_bound",Resolve[ForAll[{a,b,minimum},Implies[0<=a<=1&&0<=minimum<=1&&b>=minimum,Min[a,b]>=a*minimum]],Reals]];
absoluteIdentity=foldIdentityInduction[fold[xs,Abs[a-b]],fold[xs,a]+fold[xs,b]-2fold[xs,Min[a,b]],True];
residualIdentity=foldIdentityInduction[fold[xs,Min[a,b]-minimum*a],fold[xs,Min[a,b]]-minimum*fold[xs,a]];
check["dp_absolute_sum_induction",absoluteIdentity];
check["dp_residual_sum_induction",residualIdentity];
check["dp_nonnegative_sum_induction",sumNonnegativeInduction[]];
check["dp_aggregate_bound",absoluteIdentity&&residualIdentity&&sumNonnegativeInduction[]&&Simplify[(1+1-2overlap)/2==1-overlap]&&FullSimplify[(1-minimum)-(1-(minimum+residual))==residual&&residual>=0,residual>=0]];
check["dp_extremal_general",FullSimplify[Min[1,minimum]==minimum&&Min[0,b]==0,0<=minimum<=1&&b>=0]&&Sum[0,{index,1,size}]==0&&Simplify[(1+1-2minimum)/2==1-minimum]];
check["dp_normalized_bound",Resolve[ForAll[{distance,denominator},Implies[denominator>0&&0<=distance<=denominator,0<=distance/denominator<=1]],Reals]&&FullSimplify[denominator/denominator==1,denominator>0]];
check["dp_wrong_absolute_identity_rejected",!foldIdentityInduction[fold[xs,Abs[a-b]],fold[xs,a]+fold[xs,b]-fold[xs,Min[a,b]],True]];
entryLeSumInduction[]:=Module[{total,headGap,recursiveGap},total=fold[cons[u,v,tail],ff[a,b]];headGap=Expand[total-ff[u,v]];recursiveGap=Expand[(total-selected)/.fold[tail,ff[a,b]]->selected+tailGap];TrueQ[sumNonnegativeInduction[]&&headGap===fold[tail,ff[a,b]]&&FullSimplify[(headGap/.fold[tail,ff[a,b]]->tailMass)>=0,tailMass>=0]&&recursiveGap===ff[u,v]+tailGap&&FullSimplify[(recursiveGap/.ff[u,v]->headMass)>=0,headMass>=0&&tailGap>=0]]];
check["dp_entry_le_sum_induction",entryLeSumInduction[]];
check["dp_probability_entries_bounded",entryLeSumInduction[]&&Resolve[ForAll[{entry,remaining},Implies[entry>=0&&remaining>=0&&entry+remaining==1,0<=entry<=1]],Reals]];
check["dp_minimum_in_unit_interval",Resolve[ForAll[{minimum,entry,remaining},Implies[0<=minimum<=entry&&remaining>=0&&entry+remaining==1,0<=minimum<=1]],Reals]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
