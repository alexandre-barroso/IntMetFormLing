results={};
check[id_,condition_] := AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
x={2,2,2,2,3,1,2,2,2,2,1,2,1,3,2,1,2,2,2,2};
check["mean_from_observations", Total[x]==38 && Mean[x]==19/10];
check["variance_from_observations", Total[x-Mean[x]]==0 && Total[(x-Mean[x])^2]==29/5 && Variance[x]==29/95];
sizes={4,3,3}/10;observations={6,2,2}/10;
dispersion[o_,s_] := Total[Abs[o-s]]/2;
check["dispersion_from_distributions", dispersion[observations,sizes]==1/5 && Total[sizes]==1 && Total[observations]==1];
check["normalized_dispersion", Min[sizes]==sizes[[2]] && dispersion[observations,sizes]/(1-Min[sizes])==2/7];
check["weighted_empirical_mean", ({4,14,2}/20).{1,2,3}==Mean[x]];
check["standardization_origin_unit", FullSimplify[(m-m)/s==0 && (m+s-m)/s==1,s!=0]];
o1={{180,3},{20,153}};o2={{29,13},{123,31612}};
row[o_] := Total /@ o;
col[o_] := Total[o];
expected[o_] := Outer[Times,row[o],col[o]]/Total[Flatten[o]];
check["margins_one", row[o1]=={183,173} && col[o1]=={200,156} && Total[Flatten[o1]]==356];
check["margins_two", row[o2]=={42,31735} && col[o2]=={152,31625} && Total[Flatten[o2]]==31777];
check["expected_one", expected[o1]=={{36600,28548},{34600,26988}}/356];
check["expected_two", expected[o2]=={{6384,1328250},{4823720,1003619375}}/31777];
check["expected_row_general_base", r*0/total==0];
check["expected_row_general_step", Together[r*column/total+r*next/total-r*(column+next)/total]==0];
check["expected_row_general_total", Together[r*total/total-r]==0];
e=expected[o2];terms=Flatten[MapThread[#1 Log[#1/#2]&,{o2,e},2]];
targets={29 Log[921533/6384],13 Log[413101/1328250],123 Log[3908571/4823720],31612 Log[1004534524/1003619375]};
check["contributions_from_table", terms==targets];
check["g_from_table", Expand[2 Total[terms]-2 Total[targets]]==0];
validSampleVariance[xs_]:=If[Length[xs]>=2,Variance[xs],Missing["InsufficientObservations"]];
validStandardize[value_,center_,scale_]:=If[scale>0,(value-center)/scale,Missing["NonpositiveScale"]];
validExpected[o_]:=If[And@@Thread[Flatten[o]>=0]&&Total[Flatten[o]]>0,expected[o],Missing["InvalidCounts"]];
check["sample_variance_domain",Length[x]>=2&&validSampleVariance[x]>=0];
check["sample_variance_rejects_singleton",MissingQ[validSampleVariance[{1}]]];
check["standardization_zero_scale",MissingQ[validStandardize[1,2,0]]];
check["standardization_sign",FullSimplify[delta/scale>0&&(-delta)/scale<0,delta>0&&scale>0]];
check["expected_distribution_domain",AllTrue[{o1,o2},Function[o,!MissingQ[validExpected[o]]&&And@@Thread[Flatten[validExpected[o]]>=0]&&row[validExpected[o]]==row[o]&&col[validExpected[o]]==col[o]&&Total[Flatten[validExpected[o]]]==Total[Flatten[o]]]]];
check["expected_rejects_zero_total",MissingQ[validExpected[ConstantArray[0,{2,2}]]]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And @@ Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
