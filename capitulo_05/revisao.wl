results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
chain[values_]:=And@@Map[Expand[#[[1]]-#[[2]]]==0&,Partition[values,2,1]];
check["trimmed_mean_rounding",Abs[23/6-383/100]<1/200];
check["square_expansion_chain",chain[{(c+d)^2,(c+d)(c+d),c c+c d+d c+d d,c^2+c d+c d+d^2,c^2+2 c d+d^2}]];
check["midpoint_recovery_chain",chain[{(x+y)/2+(x-y)/2,(x+y+x-y)/2,2x/2,x}]&&chain[{(x+y)/2-(x-y)/2,(x+y-(x-y))/2,(x+y-x+y)/2,2y/2,y}]];
check["recover_candidate",Expand[m+(a-m)-a]==0];
check["shifted_deviation_chains",chain[{(m+d)-(m+h),d-h}]&&chain[{(m-d)-(m+h),-d-h}]];
check["symmetric_loss_chain",chain[{(d-h)^2+(-d-h)^2,(d^2-2d h+h^2)+(d^2+2d h+h^2),2d^2+2h^2}]];
check["loss_penalty_nonnegative",FullSimplify[2h^2>=0,Element[h,Reals]]];
mid=(x+y)/2;
check["mean_minimum",Expand[(x-a)^2+(y-a)^2-(x-mid)^2-(y-mid)^2-2(a-mid)^2]==0&&FullSimplify[2(a-mid)^2>=0,Element[{x,y,a},Reals]]];
obs=Array[o,4];exp=Array[e,4];
check["statistic_scale_four_cells",FullSimplify[2Total[MapThread[k #1 Log[k #1/(k #2)]&,{obs,exp}]]==k 2Total[MapThread[#1 Log[#1/#2]&,{obs,exp}]],k>0&&And@@Thread[obs>0]&&And@@Thread[exp>0]]];
check["statistic_scale_zero_extension",Limit[t Log[t/expected],t->0,Direction->"FromAbove",Assumptions->expected>0]==0&&Limit[k t Log[k t/(k expected)],t->0,Direction->"FromAbove",Assumptions->expected>0&&k>0]==0];
check["total_scale",Expand[Total[k obs]-k Total[obs]]==0];
check["variance_rounding",Abs[29/95-3053/10000]<1/20000];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
