results = {};
check[id_, value_] := AppendTo[results, <|"id" -> id, "passed" -> TrueQ[value]|>];
bound = o + s - 2 m o;
check["c05_d03_upper_signed_bound", Expand[bound - (o - s) - 2 ((s - m) + m (1 - o))] == 0];
check["c05_d03_lower_signed_bound", Expand[bound - (s - o) - 2 o (1 - m)] == 0];
check["c05_d03_point_bound", Resolve[ForAll[{o, s, m}, Implies[0 <= o <= 1 && 0 <= m <= 1 && m <= s, Abs[o - s] <= o + s - 2 m o]], Reals]];
check["c05_d03_sum_bound", Expand[(1 + 1 - 2 m)/2 - (1 - m)] == 0];
sizes = {4/10, 3/10, 3/10};
observed = {6/10, 2/10, 2/10};
dispersion = Total[Abs[observed - sizes]]/2;
check["c05_r05_source_dispersion", dispersion == 1/5];
check["c05_d03_source_normalization", dispersion/(1 - Min[sizes]) == 2/7];
Do[check["c05_d03_attained_" <> ToString[j], Total[Abs[UnitVector[3, j] - sizes]]/2 == 1 - sizes[[j]]], {j, 1, 3}];
check["c05_r05_no_dispersion", Total[Abs[sizes - sizes]] == 0];
report = <|"backend" -> "Wolfram", "checks" -> Length[results], "passed" -> AllTrue[results, TrueQ[#["passed"]] &], "results" -> results|>;
Print[ExportString[report, "RawJSON"]];
Exit[If[TrueQ[report["passed"]], 0, 1]];
