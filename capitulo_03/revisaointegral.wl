ClearAll["Global`*"];
r={};
check[name_,value_]:=AppendTo[r,<|"id"->name,"passed"->TrueQ[value]|>];
genitivePlural=ConstantArray["-on",8];
check["genitive_plural_values",genitivePlural[[1]]=="-on"&&genitivePlural[[2]]=="-on"&&genitivePlural[[1]]==genitivePlural[[2]]];
check["min_cardinalities",Min[4,5]==4];
check["disjunction_without_negation",(True||False)&&!False];
gen={"u","zero","s","s","u","u","us","os"};
acc={"us","es","es","is","a","a","i","a"};
cell={7,"genitivo","singular",gen[[7]]};
other={1,"acusativo","plural",acc[[1]]};
check["feature_record",cell=={7,"genitivo","singular","us"}&&Last[cell]==Last[other]&&cell!=other];
segA={"s","or","pr","endere"};
segB={"s","or","pr","endere","bbe"};
segC={"s","or","pr","end","iamo"};
check["published_segment_properties",Complement[segA,segB]=={}&&Length[Union[segA]]==4&&Length[Union[segB]]==5&&Length[Intersection[segA,segB]]==4&&Length[Intersection[segA,segC]]==3];
aa={"s","or","pr","endere"};bb={"s","or","pr","endere","bbe"};cc={"s","or","pr","end","iamo"};dd={"s","or","pre","se"};
check["published_overlap_steps",{Length[Intersection[aa,bb]],Min[Length[aa],Length[bb]],Length[Intersection[aa,bb]]/Min[Length[aa],Length[bb]]}=={4,4,1}&&{Length[Intersection[aa,cc]],Min[Length[aa],Length[cc]],Length[Intersection[aa,cc]]/Min[Length[aa],Length[cc]]}=={3,4,3/4}&&3/4==75/100&&{Length[Intersection[aa,dd]],Min[Length[aa],Length[dd]],Length[Intersection[aa,dd]]/Min[Length[aa],Length[dd]]}=={2,4,2/4}&&2/4==5/10];
Print[ExportString[<|"passed"->And@@Lookup[r,"passed"],"results"->r|>,"RawJSON"]];
If[And@@Lookup[r,"passed"],Exit[0],Exit[1]];
