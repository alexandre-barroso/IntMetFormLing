ClearAll["Global`*"];
bot={"false"};
at[name_,args___]:={"atom",name,{args}};
cn[a_,b_]:={"and",a,b};
ds[a_,b_]:={"or",a,b};
im[a_,b_]:={"imp",a,b};
ng[a_]:=im[a,bot];
iff[a_,b_]:=cn[im[a,b],im[b,a]];
af[x_,a_]:={"all",x,a};
ef[x_,a_]:={"ex",x,a};
freeVars[f_]:=Switch[f[[1]],"false",{},"atom",Union[f[[3]]],"all"|"ex",Complement[freeVars[f[[3]]],{f[[2]]}],_,Union[freeVars[f[[2]]],freeVars[f[[3]]]]];
require[value_]:=If[!TrueQ[value],Throw[$Failed]];
substitute[f_,x_,t_]:=Module[{tag=f[[1]]},If[!MemberQ[freeVars[f],x],Return[f]];If[tag=="atom",Return[{"atom",f[[2]],If[#==x,t,#]& /@ f[[3]]}]];If[MemberQ[{"all","ex"},tag],require[f[[2]]!=t];Return[{tag,f[[2]],substitute[f[[3]],x,t]}]];{tag,substitute[f[[2]],x,t],substitute[f[[3]],x,t]}];
canon[f_,bound_:{}]:=Switch[f[[1]],"false",f,"atom",{"atom",f[[2]],If[MemberQ[bound,#],{"bound",First[First[Position[Reverse[bound],#]]]}, {"free",#}]& /@ f[[3]]},"all"|"ex",{f[[1]],canon[f[[3]],Append[bound,f[[2]]]]},_,{f[[1]],canon[f[[2]],bound],canon[f[[3]],bound]}];
same[a_,b_]:=canon[a]===canon[b];
extend[ctx_,name_,formula_]:=(require[!KeyExistsQ[ctx,name]];Join[ctx,<|name->formula|>]);
verify[proof_,ctx_:<||>,vars_:{}]:=Module[{rule=proof[[1]],f,g,a,b,x,body,t},Switch[rule,
"hyp",require[KeyExistsQ[ctx,proof[[2]]]];Return[ctx[proof[[2]]]],
"andI",Return[cn[verify[proof[[2]],ctx,vars],verify[proof[[3]],ctx,vars]]],
"andEL"|"andER",f=verify[proof[[2]],ctx,vars];require[f[[1]]=="and"];Return[f[[If[rule=="andEL",2,3]]]],
"impI",Return[im[proof[[3]],verify[proof[[4]],extend[ctx,proof[[2]],proof[[3]]],vars]]],
"impE",f=verify[proof[[2]],ctx,vars];g=verify[proof[[3]],ctx,vars];require[f[[1]]=="imp"&&same[f[[2]],g]];Return[f[[3]]],
"orIL",Return[ds[verify[proof[[2]],ctx,vars],proof[[3]]]],
"orIR",Return[ds[proof[[2]],verify[proof[[3]],ctx,vars]]],
"orE",f=verify[proof[[2]],ctx,vars];require[f[[1]]=="or"];a=verify[proof[[4]],extend[ctx,proof[[3]],f[[2]]],vars];b=verify[proof[[6]],extend[ctx,proof[[5]],f[[3]]],vars];require[same[a,b]];Return[a],
"falseE",require[verify[proof[[3]],ctx,vars]===bot];Return[proof[[2]]],
"allI",x=proof[[2]];require[!MemberQ[vars,x]&&And@@(!MemberQ[freeVars[#],x]& /@ Values[ctx])];Return[af[x,verify[proof[[3]],ctx,Union[vars,{x}]]]],
"allE",f=verify[proof[[2]],ctx,vars];require[f[[1]]=="all"&&MemberQ[vars,proof[[3]]]];Return[substitute[f[[3]],f[[2]],proof[[3]]]],
"exI",x=proof[[2]];body=proof[[3]];t=proof[[4]];require[MemberQ[vars,t]];require[same[verify[proof[[5]],ctx,vars],substitute[body,x,t]]];Return[ef[x,body]],
"exE",f=verify[proof[[2]],ctx,vars];x=proof[[3]];require[f[[1]]=="ex"];require[!MemberQ[vars,x]&&!MemberQ[freeVars[f],x]&&And@@(!MemberQ[freeVars[#],x]& /@ Values[ctx])];g=verify[proof[[5]],extend[ctx,proof[[4]],substitute[f[[3]],f[[2]],x]],Union[vars,{x}]];require[!MemberQ[freeVars[g],x]];Return[g],
"dne",f=verify[proof[[2]],ctx,vars];require[f[[1]]=="imp"&&f[[3]]===bot&&f[[2,1]]=="imp"&&f[[2,3]]===bot];Return[f[[2,2]]],
"lem",require[Complement[freeVars[proof[[2]]],vars]=={}];Return[ds[proof[[2]],ng[proof[[2]]]]]
];Throw[$Failed]];
memberFormula[term_,x_]:=Switch[term[[1]],"set",at[term[[2]],x],"empty",bot,"inter",cn[memberFormula[term[[2]],x],memberFormula[term[[3]],x]],"diff",cn[memberFormula[term[[2]],x],ng[memberFormula[term[[3]],x]]],"union",ds[memberFormula[term[[2]],x],memberFormula[term[[3]],x]],_,Throw[$Failed]];
subsetFormula[a_,b_]:=af["x",im[memberFormula[a,"x"],memberFormula[b,"x"]]];
equalityFormula[a_,b_]:=af["x",iff[memberFormula[a,"x"],memberFormula[b,"x"]]];
nonemptyFormula[a_]:=ef["x",memberFormula[a,"x"]];
emptyFormula[a_]:=af["x",ng[memberFormula[a,"x"]]];
rejected[proof_,ctx_:<||>,vars_:{}]:=Catch[verify[proof,ctx,vars]]===$Failed;
