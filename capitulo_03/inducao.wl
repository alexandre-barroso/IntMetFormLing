ClearAll["Global`*"];
nil={"nil"};zero={"zero"};
vr[name_,sort_]:={"var",name,sort};
cn[a_,b_]:={"cons",a,b};
ap[a_,b_]:={"append",a,b};
ln[a_]:={"len",a};
su[a_]:={"succ",a};
ad[a_,b_]:={"add",a,b};
freeVars[term_]:=If[term[[1]]=="var",{term[[2]]},If[Length[term]==1,{},Union@@(freeVars /@ Rest[term])]];
substitute[term_,name_,value_]:=If[term[[1]]=="var",If[term[[2]]==name,value,term],Prepend[substitute[#,name,value]& /@ Rest[term],First[term]]];
typeOf[term_]:=Module[{tag=term[[1]],args,signature},If[tag=="var",If[MemberQ[{"list","element","nat"},term[[3]]],Return[term[[3]]],Throw[$Failed]]];If[tag=="nil",Return["list"]];If[tag=="zero",Return["nat"]];args=typeOf /@ Rest[term];signature=<|"cons"->{{"element","list"},"list"},"append"->{{"list","list"},"list"},"len"->{{"list"},"nat"},"succ"->{{"nat"},"nat"},"add"->{{"nat","nat"},"nat"}|>;If[!KeyExistsQ[signature,tag]||args=!=signature[tag][[1]],Throw[$Failed]];signature[tag][[2]]];
normal[term_]:=Module[{tag=term[[1]],args},If[tag=="var"||Length[term]==1,Return[term]];args=normal /@ Rest[term];If[tag=="append",If[args[[1]]===nil,Return[args[[2]]]];If[args[[1,1]]=="cons",Return[cn[args[[1,2]],normal[ap[args[[1,3]],args[[2]]]]]]]];If[tag=="len",If[args[[1]]===nil,Return[zero]];If[args[[1,1]]=="cons",Return[su[normal[ln[args[[1,3]]]]]]]];If[tag=="add",If[args[[1]]===zero,Return[args[[2]]]];If[args[[1,1]]=="succ",Return[su[normal[ad[args[[1,2]],args[[2]]]]]]]];Prepend[args,tag]];
rewriteExact[term_,left_,right_]:=If[term===left,right,If[term[[1]]=="var"||Length[term]==1,term,Prepend[rewriteExact[#,left,right]& /@ Rest[term],First[term]]]];
structuralInduction[left_,right_,variable_]:=Module[{names,baseLeft,baseRight,head,tail,hypothesisLeft,hypothesisRight,stepLeft,stepRight},If[typeOf[left]=!=typeOf[right]||typeOf[variable]=!="list",Throw[$Failed]];names=Union[freeVars[left],freeVars[right]];If[Intersection[names,{"fresh_head","fresh_tail"}]!={},Throw[$Failed]];baseLeft=normal[substitute[left,variable[[2]],nil]];baseRight=normal[substitute[right,variable[[2]],nil]];If[baseLeft=!=baseRight,Return[False]];head=vr["fresh_head","element"];tail=vr["fresh_tail","list"];hypothesisLeft=normal[substitute[left,variable[[2]],tail]];hypothesisRight=normal[substitute[right,variable[[2]],tail]];stepLeft=normal[substitute[left,variable[[2]],cn[head,tail]]];stepRight=normal[substitute[right,variable[[2]],cn[head,tail]]];normal[rewriteExact[stepLeft,hypothesisLeft,hypothesisRight]]===stepRight];
word[text_]:=Fold[cn[vr[#2,"element"],#1]&,nil,Reverse[Characters[text]]];
number[n_]:=Nest[su,zero,n];
xs=vr["xs","list"];ys=vr["ys","list"];zs=vr["zs","list"];
certificates=<|"associativity"->{{"append",{"append",{"var","xs","list"},{"var","ys","list"}},{"var","zs","list"}},{"append",{"var","xs","list"},{"append",{"var","ys","list"},{"var","zs","list"}}},{"var","xs","list"}},"right_identity"->{{"append",{"var","xs","list"},{"nil"}},{"var","xs","list"},{"var","xs","list"}},"length_append"->{{"len",{"append",{"var","xs","list"},{"var","ys","list"}}},{"add",{"len",{"var","xs","list"}},{"len",{"var","ys","list"}}},{"var","xs","list"}}|>;
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["associativity_induction",Catch[structuralInduction@@certificates["associativity"]]];
check["right_identity_induction",Catch[structuralInduction@@certificates["right_identity"]]];
check["length_append_induction",Catch[structuralInduction@@certificates["length_append"]]];
check["left_identity_definition",normal[ap[nil,xs]]===xs];
check["empty_length_definition",normal[ln[nil]]===zero];
check["published_worked",normal[ap[word["work"],word["ed"]]]===word["worked"]&&normal[ln[word["work"]]]===number[4]&&normal[ln[word["ed"]]]===number[2]&&normal[ln[word["worked"]]]===number[6]&&normal[ad[number[4],number[2]]]===number[6]];
check["published_carefully",normal[ap[ap[word["care"],word["ful"]],word["ly"]]]===normal[ap[word["care"],ap[word["ful"],word["ly"]]]]===word["carefully"]&&normal[ln[word["carefully"]]]===number[9]];
check["commutativity_rejected",!Catch[structuralInduction[ap[xs,ys],ap[ys,xs],xs]]];
check["wrong_length_rejected",!Catch[structuralInduction[ln[ap[xs,ys]],su[ad[ln[xs],ln[ys]]],xs]]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"structural induction from finite-list append, length and natural-addition recursions","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
