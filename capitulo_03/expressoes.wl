results = {};
check[id_, condition_] := AppendTo[results, <|"id" -> id, "passed" -> TrueQ[condition]|>];
acc = {"us","es","es","is","a","a","i","a"};
gen = {"u","zero","s","s","u","u","us","os"};
fiber[s_] := Flatten[Position[acc,s]];
check["fibers", {fiber["us"],fiber["es"],fiber["is"],fiber["a"],fiber["i"]} == {{1},{2,3},{4},{5,6,8},{7}}];
check["partition_disjoint", And @@ (Intersection[fiber[#[[1]]],fiber[#[[2]]]] == {} & /@ Subsets[DeleteDuplicates[acc],{2}])];
check["partition_cover", Union @@ (fiber /@ DeleteDuplicates[acc]) == Range[8]];
check["relation_from_columns", Sort[DeleteDuplicates[Transpose[{acc,gen}]]] == Sort[{{"us","u"},{"es","zero"},{"es","s"},{"is","s"},{"a","u"},{"i","us"},{"a","os"}}]];
a = {5,6,8}; b = {1,5,6};
check["set_membership", MemberQ[a,5] && !MemberQ[a,1] && Length[Intersection[a,b]] == 2 && Length[Union[a,b]] == 4];
check["all_sets", TautologyQ[Equivalent[Implies[p,q],Not[p && Not[q]]]]];
check["some_sets", TautologyQ[Equivalent[p && q,And[p,q]]]];
check["no_sets", TautologyQ[Equivalent[Not[p && q],Not[p] || Not[q]]]];
check["de_morgan_all_base", Not[And @@ {}] == Or @@ {}];
check["de_morgan_all_step", TautologyQ[Equivalent[Not[p && q],Not[p] || Not[q]]]];
check["de_morgan_any_base", Not[Or @@ {}] == And @@ {}];
check["de_morgan_any_step", TautologyQ[Equivalent[Not[p || q],Not[p] && Not[q]]]];
qt = Function[g, Exists[y, tt[y] && g[y]]];
qw = Function[g, Exists[x, ww[x] && g[x]]];
v = Function[qo,Function[qs,qs[Function[x,qo[Function[y,oo[x,y]]]]]]];
check["verb_object_beta", v[qt][Function[g,g[xx]]] == Exists[y,tt[y] && oo[xx,y]]];
check["verb_subject_beta", v[qt][qw] == Exists[x,ww[x] && Exists[y,tt[y] && oo[x,y]]]];
check["modal_not_veridical", Function[x,True][False] && !False];
check["published_sets_from_columns",Flatten[Position[acc,"a"]]=={5,6,8}&&Flatten[Position[gen,"u"]]=={1,5,6}];
check["cardinality_union_regions",Expand[(u+w)+(v+w)-w-(u+v+w)]==0];
check["same_output_reflexive",And@@Table[acc[[i]]==acc[[i]],{i,8}]];
check["same_output_symmetric",And@@Flatten[Table[Equivalent[acc[[i]]==acc[[j]],acc[[j]]==acc[[i]]],{i,8},{j,8}]]];
check["same_output_transitive",And@@Flatten[Table[Implies[acc[[i]]==acc[[j]]&&acc[[j]]==acc[[k]],acc[[i]]==acc[[k]]],{i,8},{j,8},{k,8}]]];
article=Function[pp,Function[gg,Exists[xx,pp[xx]&&gg[xx]]]];
check["subject_indefinite_beta",article[ww][qq]===Exists[xx,ww[xx]&&qq[xx]]];
check["object_indefinite_beta",Function[ff,Exists[yy,tt[yy]&&ff[yy]]][Function[zz,oo[xx,zz]]]===Exists[yy,tt[yy]&&oo[xx,yy]]];
check["morphological_product",Length[Union[acc]]==5&&Length[Union[gen]]==5&&Length[Tuples[{Union[acc],Union[gen]}]]==25&&SubsetQ[Tuples[{Union[acc],Union[gen]}],Union[Transpose[{acc,gen}]]]];
report = <|"backend" -> "Wolfram", "checks" -> Length[results], "passed" -> And @@ Lookup[results,"passed"], "results" -> results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
