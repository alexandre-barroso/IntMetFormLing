results={};
check[id_,value_,hypotheses_] := AppendTo[results,<|"id"->id,"hypotheses"->hypotheses,"passed"->TrueQ[value]|>];
overlap[a_List,b_List] := If[a=={}||b=={},Missing["Undefined"],Length[Intersection[a,b]]/Min[Length[Union[a]],Length[Union[b]]]];
check["overlap_regions",FullSimplify[Min[x+z,y+z]==z+Min[x,y],Element[{x,y,z},Reals]],{"x=|A minus B|","y=|B minus A|","z=|A intersection B|"}];
check["overlap_bounds",Resolve[ForAll[{x,y,z},Implies[x>=0&&y>=0&&z>=0&&x+z>0&&y+z>0,0<=z/Min[x+z,y+z]<=1]],Reals],{"x,y,z nonnegative integers","A and B nonempty"}];
check["overlap_zero_iff",Resolve[ForAll[{x,y,z},Implies[x>=0&&y>=0&&z>=0&&x+z>0&&y+z>0,Equivalent[z/Min[x+z,y+z]==0,z==0]]],Reals],{"x,y,z nonnegative integers","A and B nonempty"}];
check["overlap_one_iff",Resolve[ForAll[{x,y,z},Implies[x>=0&&y>=0&&z>=0&&x+z>0&&y+z>0,Equivalent[z/Min[x+z,y+z]==1,x==0||y==0]]],Reals],{"x,y,z nonnegative integers","A and B nonempty"}];
check["overlap_empty_rejected",And@@(MissingQ /@ {overlap[{},{}],overlap[{"s"},{}],overlap[{}, {"s"}]}),{"at least one set empty"}];
a={"s","or","pr","endere"};b={"s","or","pr","endere","bbe"};c={"s","or","pr","end","iamo"};ds={"s","or","pre","se"};
check["overlap_published_values",(overlap[a,#]& /@ {b,c,ds})=={1,3/4,1/2},{"nonempty published segment sets"}];
domain={False,True};
surface=And@@Table[Or@@Table[y===x,{x,domain}],{y,domain}];
inverse=Or@@Table[And@@Table[y===x,{y,domain}],{x,domain}];
check["surface_not_inverse",surface&&!inverse,{"domain Bool","F=D=True","R(y,x)=y=x","finite countermodel"}];
check["empty_restriction_no_existence",SubsetQ[{},{}]&&Intersection[{},{}]=={},{"A=B=empty"}];
most[p_,q_] := True;
check["most_rules_are_not_type_consequences",most[False,False]&&!Or@@Table[False&&False,{x,domain}],{"Most constant True","countermodel; existential import requires explicit rule"}];
check["inverse_implies_surface_witness_step",BooleanConvert[Implies[p&&Implies[q,r]&&q,p&&r],"DNF"]===True,{"p=D(x) for witness x","q=F(y) for arbitrary y","r=R(y,x)","propositional step; quantifier proof in Lean"}];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
