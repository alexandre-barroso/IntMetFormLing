results={};
check[id_,condition_] := AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
check["correct_subsets",TautologyQ[Implies[s && p && q,s && p]] && TautologyQ[Implies[s && p && q,s && q]]];
precision[s_,p_,q_] := If[Length[Intersection[s,p]]==0,Missing["Undefined"],Length[Intersection[s,p,q]]/Length[Intersection[s,p]]];
coverage[s_,p_,q_] := If[Length[Intersection[s,q]]==0,Missing["Undefined"],Length[Intersection[s,p,q]]/Length[Intersection[s,q]]];
check["precision_empty",MissingQ[precision[{},{},{}]]];
check["coverage_empty",MissingQ[coverage[{},{},{}]]];
before={{85,15},{4,105}};after={{100,0},{4,105}};
check["revision_rows",(Total /@ before)=={100,109} && (Total /@ after)=={100,109}];
check["revision_columns",Total[before]=={89,120} && Total[after]=={104,105}];
check["revision_conservation",Total[Flatten[before]]==209 && Total[Flatten[after]]==209 && after-before=={{15,-15},{0,0}}];
check["revision_proportion",Total[after][[1]]/Total[Flatten[after]]-Total[before][[1]]/Total[Flatten[before]]==15/209];
transfer={997,986,918,951,966,936,813,906,985}/1000;
check["transfer_mean",Total[transfer]==8458/1000 && Mean[transfer]==4229/4500];
check["nested_indicators",TautologyQ[Implies[Implies[b,a],Equivalent[a && b,b]]]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And @@ Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
