results={};
check[id_,condition_] := If[TrueQ[condition],AppendTo[results,<|"id"->id,"passed"->True|>],Print[id];Exit[1]];
check["correct_subset_selected",TautologyQ[Implies[s&&p&&q,s&&p]]];
check["correct_subset_relevant",TautologyQ[Implies[s&&p&&q,s&&q]]];
check["selected_partition",TautologyQ[Equivalent[s&&p,(s&&p&&q)||(s&&p&&!q)]]];
check["relevant_partition",TautologyQ[Equivalent[s&&q,(s&&p&&q)||(s&&!p&&q)]]];
check["partition_disjointness",TautologyQ[!((s&&p&&q)&&(s&&p&&!q))]&&TautologyQ[!((s&&p&&q)&&(s&&!p&&q))]];
check["ratio_domain_and_range",Resolve[ForAll[{t,u},Implies[t>=0&&u>=0&&t+u>0,0<=t/(t+u)<=1]],Reals]];
check["ratio_complement",Together[1-t/(t+u)-u/(t+u)]==0];
check["nested_sets",TautologyQ[Implies[Implies[q,p],Equivalent[p&&q,q]]]];
opportunities={5509,395,209};preposed={601,292,89};
precision=preposed/opportunities;coverage=preposed/783;
pplot={109,739,426}/10;cplot={768,373,114}/10;
check["source_domains",And@@MapThread[0<=#1<=#2&&#2>0&&#1<=783&,{preposed,opportunities}]];
check["source_precision_range",And@@(0<=#<=1& /@ precision)];
check["source_coverage_range",And@@(0<=#<=1& /@ coverage)];
check["source_precision_plot_rounding",And@@Thread[Abs[100precision-pplot]<1/20]];
check["source_coverage_plot_rounding",And@@Thread[Abs[100coverage-cplot]<1/20]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];Exit[0];
