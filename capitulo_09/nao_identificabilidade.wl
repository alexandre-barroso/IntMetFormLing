ClearAll["Global`*"];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[<|"failed"->name,"value"->value|>];Exit[1]];
row=Inactive[Sum][m[i,j],{j,1,n}];
column=Inactive[Sum][m[j,i],{j,1,n}];
score=2*m[i,i]/(row+column);
mt[a_,b_]:=m[b,a];
transposedScore=2*mt[i,i]/(Inactive[Sum][mt[i,j],{j,1,n}]+Inactive[Sum][mt[j,i],{j,1,n}]);
c=IdentityMatrix[9];c[[1,2]]=t;
f1[m_,k_]:=2*m[[k,k]]/(Total[m[[k]]]+Total[m[[All,k]]]);
check["transpose_actual_symbolic_f1",Together[transposedScore-score]===0];
check["nine_class_nonnegative_integer_counts",FullSimplify[And@@Flatten[Map[Element[#,Integers]&&#>=0&,c,{2}]],Assumptions->Element[t,Integers]&&t>0]];
check["nine_class_positive_denominators",FullSimplify[And@@Table[Total[c[[k]]]+Total[c[[All,k]]]>0,{k,9}],Assumptions->t>0]];
check["nine_class_different_error_locations",FullSimplify[c[[1,2]]-Transpose[c][[1,2]]>0,Assumptions->t>0]];
check["all_nine_unrounded_scores_equal",And@@Table[Together[f1[c,k]-f1[Transpose[c],k]]===0,{k,9}]];
check["macro_scores_equal",Together[Total[Table[f1[c,k],{k,9}]]/9-Total[Table[f1[Transpose[c],k],{k,9}]]/9]===0];
check["same_total_and_correct_counts",Total[Flatten[c]]===Total[Flatten[Transpose[c]]]&&Tr[c]===Tr[Transpose[c]]];
check["claim_unique_matrix_rejected",c=!=Transpose[c]&&And@@Table[Together[f1[c,k]-f1[Transpose[c],k]]===0,{k,9}]];
check["symmetric_matrix_not_a_counterexample",IdentityMatrix[9]===Transpose[IdentityMatrix[9]]];
Print[ExportString[<|"backend"->"Wolfram Language","scope"->"F1 per class with positive denominators; transpose identity; nine-class family with arbitrary positive integer error count, no reconstruction of a published confusion matrix","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
