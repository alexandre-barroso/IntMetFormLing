results={};
check[id_,condition_] := AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
x=Join[ConstantArray[{1,0},3],ConstantArray[{1,1},3]];
y={233,204,242,130,112,142};beta={679/3,-295/3};
check["predictions",x.{a,b}=={a,a,a,a+b,a+b,a+b}];
check["normal_matrix",Transpose[x].x=={{6,3},{3,3}}];
check["normal_target",Transpose[x].y=={1063,384}];
check["normal_equation",Transpose[x].x.beta==Transpose[x].y];
r=y-x.beta;
check["residuals_from_matrix",r=={20/3,-67/3,47/3,2,-16,14}];
check["residual_orthogonality",Transpose[x].r=={0,0}];
check["residual_loss",r.r==3734/3];
rab=y-x.{a,b};
check["loss_from_matrix",Expand[rab.rab-(6a^2+6a b+3b^2-2126a-768b+204077)]==0];
check["paired_mean_base",(0-0)/n==0];
check["paired_mean_step",Expand[(sA+tA)-(sB+tB)-(sA-sB)-(tA-tB)]==0];
check["paired_mean_general",Together[(sA-sB)/n-sA/n+sB/n]==0];
check["swap_count_base",2^0==1];
check["swap_count_step",FullSimplify[2*2^n==2^(n+1)]];
check["correlation_simplification",FullSimplify[(-295/2)/Sqrt[(3/2)(94493/6)]+295/Sqrt[94493]]==0];
check["indicator_product",Resolve[ForAll[{a,q},Implies[(q==0 || q==1) && Implies[q==1,a==1],a q==q]],Reals]];
check["nonidentifiable_coefficients",Expand[b q+c q-(b+c)q]==0 && Expand[(b+h)q+(c-h)q-(b+c)q]==0];
plotted={2263333333333/10000000000,2263333333333/10000000000,2263333333333/10000000000,128,128,128};
check["fitted_graph_rounding",Max[Abs[plotted-x.beta]]<1/20000000000];
check["residual_segments",y-plotted==(y-x.beta)+(x.beta-plotted)];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And @@ Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
