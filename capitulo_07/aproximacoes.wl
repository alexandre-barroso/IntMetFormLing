apEq=ProbabilityProof`pgEq;
apOmega="Omega";
apFunction=apFT[apOmega,"R"];
apEvent=apFT[apOmega,"Prop"];
apFamily=apFT[apEvent,"Prop"];
apSimple={"List",{"Pair","R",apEvent}};
apSequence=apFT["N",apSimple];
apZero=apC["zero_real","R"];
apOne=apC["one_real","R"];
apLe[a_,b_]:=apA[apC["real_le",apFT["R",apFT["R","Prop"]]],a,b];
apUpper[f_,a_]:=With[{p=apV["upper_point",apOmega]},apLam[p,apLe[a,apA[f,p]]]];
apLower[f_,a_]:=With[{p=apV["lower_point",apOmega]},apLam[p,apLe[apA[f,p],a]]];
apNonnegative[f_]:=With[{p=apV["nonnegative_point",apOmega]},apAll[p,apLe[apZero,apA[f,p]]]];
apMeasurable[f_]:=Module[{a=apV["level","R"],mu=apC["measurable_event",apFT[apEvent,"Prop"]]},apAll[a,apAnd[apA[mu,apUpper[f,a]],apA[mu,apLower[f,a]]]]];
apUpperIn[f_,g_]:=With[{a=apV["upper_level","R"]},apAll[a,apA[g,apUpper[f,a]]]];
apVal[s_,p_]:=apA[apC["simple_value",apFT[apSimple,apFunction]],s,p];
apPositive[h_]:=With[{n=apV["positive_stage","N"]},apAll[n,apA[apC["valid_nonnegative_simple",apFT[apSimple,"Prop"]],apA[h,n]]]];
apIncreasing[h_]:=Module[{p=apV["increasing_point",apOmega],i=apV["first","N"],j=apV["last","N"]},apAll[p,apAll[i,apAll[j,apImp[apA[apC["nat_le",apFT["N",apFT["N","Prop"]]],i,j],apLe[apVal[apA[h,i],p],apVal[apA[h,j],p]]]]]]];
apPointwiseLub[h_,f_]:=Module[{p=apV["lub_point",apOmega],i=apV["lub_index","N"],b=apV["upper_bound","R"]},apAll[p,apAnd[apAll[i,apLe[apVal[apA[h,i],p],apA[f,p]]],apAll[b,apImp[apAll[i,apLe[apVal[apA[h,i],p],b]],apLe[apA[f,p],b]]]]]];
apApproximation[h_,f_]:=apAnd[apAnd[apPositive[h],apIncreasing[h]],apPointwiseLub[h,f]];
apAdapted[h_,g_]:=With[{n=apV["adapted_stage","N"]},apAll[n,apA[apC["simple_adapted",apFT[apFamily,apFT[apSimple,"Prop"]]],g,apA[h,n]]]];
apCast[n_]:=apA[apC["natural_real_embedding",apFT["N","R"]],n];
apCanonical[f_]:=Module[{n=apV["stage","N"],q,cap,grid},q=apA[apC["dyadic_natural",apFT["N","N"]],n];cap=apA[apC["natural_mul",apFT["N",apFT["N","N"]]],q,q];grid=apC["upper_level_grid",apFT[apFunction,apFT["R",apFT["N",apSimple]]]];apLam[n,apA[grid,f,apCast[q],cap]]];
apTargets[]:=Module[{f=apV["independent_function",apFunction],g=apV["independent_family",apFamily],h=apV["independent_sequence",apSequence]},<|"nonnegative_measurable_approximable"->apAll[f,apImp[apNonnegative[f],apImp[apMeasurable[f],apEx[h,apApproximation[h,f]]]]],"nonnegative_measurable_adapted_approximable"->apAll[f,apAll[g,apImp[apNonnegative[f],apImp[apMeasurable[f],apImp[apUpperIn[f,g],apEx[h,apAnd[apApproximation[h,f],apAdapted[h,g]]]]]]]],"canonical_nonnegative_approximation"->apAll[f,apImp[apNonnegative[f],apImp[apMeasurable[f],apApproximation[apCanonical[f],f]]]]|>];
apReplay[axioms_,proofs_]:=Module[{kernel=ProbabilityProof`pgKernel[axioms]},Do[ProbabilityProof`pgTheorem[kernel,record[[1]],record[[2]],record[[3]]],{record,proofs}];kernel];
apMutation[case_]:=Module[{axioms=apData["axioms"],proofs=apData["proofs"],index},
 Switch[case["kind"],
 "delete",axioms=KeyDrop[axioms,case["name"]],
 "axiom",If[ProbabilityProof`pgSame[axioms[case["name"]],case["formula"]],ProbabilityProof`pgFail["unchanged mutation"]];axioms=Join[axioms,<|case["name"]->case["formula"]|>],
 "target",index=FirstPosition[proofs[[All,1]],case["name"]];If[MissingQ[index],ProbabilityProof`pgFail["mutation theorem absent"]];proofs=Take[proofs,First[index]];proofs[[-1,2]]=case["formula"],
 _,ProbabilityProof`pgFail["unknown mutation kind"]];apReplay[axioms,proofs]];
CanonicalApproximation`check[id_,condition_]:=AppendTo[apResults,<|"id"->id,"passed"->TrueQ[condition]|>];
apRun[]:=Block[{$RecursionLimit=20000,$IterationLimit=Infinity},Module[{kernel,targets,q,x,first},
 apResults={};kernel=apReplay[apData["axioms"],apData["proofs"]];targets=apTargets[];
 CanonicalApproximation`check["canonical_nonnegative_approximations_exist",ProbabilityProof`pgSame[kernel["verified"]["nonnegative_measurable_approximable"]["conclusion"],targets["nonnegative_measurable_approximable"]]];
 CanonicalApproximation`check["canonical_adapted_approximations_exist",ProbabilityProof`pgSame[kernel["verified"]["nonnegative_measurable_adapted_approximable"]["conclusion"],targets["nonnegative_measurable_adapted_approximable"]]];
 CanonicalApproximation`check["canonical_list_is_explicit",ProbabilityProof`pgSame[kernel["verified"]["canonical_nonnegative_approximation"]["conclusion"],targets["canonical_nonnegative_approximation"]]];
 CanonicalApproximation`check["canonical_lists_positive",kernel["verified"]["canonical_sequence_positive"]["assumptions"]==={}];
 CanonicalApproximation`check["canonical_lists_increasing",kernel["verified"]["canonical_sequence_increasing"]["assumptions"]==={}];
 CanonicalApproximation`check["canonical_lists_pointwise_lub",kernel["verified"]["canonical_sequence_pointwise_lub"]["assumptions"]==={}];
 CanonicalApproximation`check["finite_sum_equals_truncated_floor",kernel["verified"]["finite_upper_grid_value"]["assumptions"]==={}];
 CanonicalApproximation`check["dyadic_growth_by_induction",kernel["verified"]["dyadic_dominates_index"]["assumptions"]==={}];
 CanonicalApproximation`check["cofinality_from_archimedean_embedding",kernel["verified"]["dyadic_unbounded"]["assumptions"]==={}];
 CanonicalApproximation`check["all_derived_claims_closed",And@@((#["assumptions"]==={})&/@Values[kernel["verified"]])];
 CanonicalApproximation`check["approximation_is_not_a_foundation",And@@(!KeyExistsQ[kernel["axioms"],#]&/@{"canonical_sequence_pointwise_lub","nonnegative_measurable_approximable","finite_upper_grid_value","canonical_scalar_lub"})];
 CanonicalApproximation`check["reciprocal_positive_domain",FullSimplify[1/q>0,q>0]];
 CanonicalApproximation`check["division_addition_identity",Together[1/q+x/q-(x+1)/q]===0];
 CanonicalApproximation`check["division_doubling_identity",Cancel[2*x/(2*q)-x/q]===0];
 Do[CanonicalApproximation`check[case["id"],ProbabilityProof`pgRejects[apMutation[case]]],{case,apData["negative_cases"]}];
 If[!And@@(TrueQ[#["passed"]]&/@apResults),ProbabilityProof`pgFail[apResults]];
 first=First@FirstPosition[apData["proofs"][[All,1]],"inverse_gap_bound"];
 apVerification=<|"kernel"->kernel,"targets"->targets|>;
 <|"backend"->"Wolfram","checks"->apResults,"derived"->Drop[apData["proofs"][[All,1]],first-1],"derived_count"->Length[apData["proofs"]]-first+1|>]];
If[!TrueQ[CanonicalApproximation`$LibraryMode],
 apReport=Catch[apRun[],"ProbabilityKernelError",Function[{value,tag},<|"error"->ToString[value,InputForm]|>]];
 Print[ExportString[apReport,"RawJSON"]];
 If[KeyExistsQ[apReport,"error"],Exit[1],Exit[0]]];
End[];
