BeginPackage["MomentAlgebra`"];
results={};
MomentAlgebra`check[name_,condition_]:=If[TrueQ[condition],AppendTo[results,<|"id"->name,"passed"->True|>],Throw[{"failed_check",name},"MomentAlgebraFailure"]];
variance[first_,second_]:=second-first^2;
covariance[first_,second_,product_]:=product-first second;
MomentAlgebra`check["variance_centered_expansion",Expand[(ex2-2ex ex+ex^2)-variance[ex,ex2]]===0];
MomentAlgebra`check["covariance_centered_expansion",Expand[(exy-ex ey-ey ex+ex ey)-covariance[ex,ey,exy]]===0];
MomentAlgebra`check["variance_of_sum_with_covariance",Expand[variance[ex+ey,ex2+2exy+ey2]-variance[ex,ex2]-variance[ey,ey2]-2covariance[ex,ey,exy]]===0];
MomentAlgebra`check["variance_of_scalar_multiple",Expand[variance[c ex,c^2 ex2]-c^2 variance[ex,ex2]]===0];
MomentAlgebra`check["variance_of_zero",variance[0,0]===0];
MomentAlgebra`check["covariance_independent_factorization",covariance[ex,ey,ex ey]===0];
MomentAlgebra`check["centered_independent_product",(ex ey/.{ex->0,ey->0})===0];
MomentAlgebra`check["covariance_additivity_left",Expand[covariance[eu+ev,ew,euw+evw]-covariance[eu,ew,euw]-covariance[ev,ew,evw]]===0];
MomentAlgebra`check["covariance_symmetry",Expand[covariance[ex,ey,exy]-covariance[ey,ex,exy]]===0];
MomentAlgebra`check["covariance_zero_left",covariance[0,ey,0]===0];
MomentAlgebra`check["covariance_self_equals_variance",covariance[ex,ex,ex2]===variance[ex,ex2]];
MomentAlgebra`check["covariance_finite_sum_induction_base",covariance[0,ey,0]===0];
MomentAlgebra`check["covariance_finite_sum_induction_step",((tailCovariance+headCovariance)/.{tailCovariance->0,headCovariance->0})===0];
MomentAlgebra`check["independent_variance_sum_induction_base",variance[0,0]===0];
MomentAlgebra`check["independent_variance_sum_induction_step",Expand[(tailVariance+headVariance+2tailCovariance/.tailCovariance->0)-(tailVariance+headVariance)]===0];
MomentAlgebra`check["common_variance_induction_base",0v===0];
MomentAlgebra`check["common_variance_induction_step",Expand[n v+v-(n+1)v]===0];
MomentAlgebra`check["positive_sample_size_denominator",Resolve[ForAll[n,Implies[n>0,n!=0&&n^2>0]],Reals]];
MomentAlgebra`check["mean_variance_final_cancellation",FullSimplify[(1/n)^2(n v)==v/n,Element[{n,v},Reals]&&n>0]];
MomentAlgebra`check["mean_variance_zero_sample_size_rejected",!TrueQ[0>0]];
names={"u","v","e","w","f"};means=AssociationThread[names,{mu,mv,me,mw,mf}];pairs=Tuples[{{"u","v","e"},{"u","w","f"}}];
cross[x_,y_]:=Symbol["MomentAlgebra`E"<>x<>y];
total=covariance[Total[Lookup[means,{"u","v","e"}]],Total[Lookup[means,{"u","w","f"}]],Total[cross@@@pairs]];
expanded=Total[(covariance[means[#[[1]]],means[#[[2]]],cross@@#]&/@pairs)];
MomentAlgebra`check["shared_participant_nine_term_expansion",Expand[total-expanded]===0];
independentPairs=DeleteCases[pairs,{"u","u"}];substitutions=(cross@@#->means[#[[1]]]means[#[[2]]]&/@independentPairs);
MomentAlgebra`check["shared_participant_exact_eight_independences",independentPairs==={{"u","w"},{"u","f"},{"v","u"},{"v","w"},{"v","f"},{"e","u"},{"e","w"},{"e","f"}}];
MomentAlgebra`check["shared_participant_general_covariance",Expand[(total/.substitutions)-variance[means["u"],cross["u","u"]]]===0];
MomentAlgebra`check["shared_participant_no_centering_required",AllTrue[Last/@substitutions,#=!=0&]&&AllTrue[Values[means],!FreeQ[total,#]&]];
MomentAlgebra`check["shared_participant_reject_each_missing_independence",And@@Table[Expand[(total/.Delete[substitutions,index])-variance[means["u"],cross["u","u"]]]=!=0,{index,Length[substitutions]}]];
report=<|"backend"->"Wolfram Language","passed"->And@@Lookup[results,"passed"],"results"->results,"scope"->"General algebra and finite induction conditional on separately proved expectation linearity, L2 closure and independent factorization; these identities alone are not probability theorems."|>;
If[!TrueQ[MomentAlgebra`$LibraryMode],Print[ExportString[report,"RawJSON"]]];
EndPackage[];
If[!TrueQ[MomentAlgebra`$LibraryMode],Exit[If[TrueQ[MomentAlgebra`report["passed"]],0,1]]];
