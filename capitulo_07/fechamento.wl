ClearAll["Global`*"];
results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
check["lagrange_empty",(a b-c^2/.{a->0,b->0,c->0})==0];
check["lagrange_append",Expand[(a+x^2)(b+y^2)-(c+x y)^2-(a b-c^2)-(y^2 a+x^2 b-2 x y c)]==0];
check["lagrange_cross_term",Expand[(u y-v x)^2-(y^2 u^2+x^2 v^2-2 x y u v)]==0];
check["lagrange_square_nonnegative",Resolve[ForAll[{u,v,x,y},(u y-v x)^2>=0],Reals]];
check["normalized_scalar_range",Resolve[ForAll[{c,d},Implies[d>0&&c^2<=d^2,-1<=c/d<=1]],Reals]];
check["constant_vector_centering",Resolve[ForAll[{n,m},Implies[n>0,n m/n-m==0]],Reals]];
check["zero_square_sum_induction",Resolve[ForAll[{x,tail},Implies[tail>=0,Equivalent[x^2+tail==0,x==0&&tail==0]]],Reals]];
check["positive_square_sum_induction",Resolve[ForAll[{x,tail},Implies[tail>=0,Equivalent[x^2+tail>0,x!=0||tail>0]]],Reals]];
xx={-1,0,1};yy={1,0,1};
sx=Total[(xx-Mean[xx])^2];sy=Total[(yy-Mean[yy])^2];sxy=(xx-Mean[xx]).(yy-Mean[yy]);
check["countermodel_nonlinear",yy==xx^2];
check["countermodel_nonzero_dispersions",sx==2&&sy==2/3];
check["countermodel_zero_pearson",sxy/Sqrt[sx sy]==0];
check["countermodel_no_affine_relation",Resolve[Not[Exists[{a,b},And@@Thread[yy==a+b xx]]],Reals]];
px=Count[xx,0]/3;py=Count[yy,0]/3;joint=Count[Transpose[{xx,yy}],{0,0}]/3;
check["countermodel_dependent",joint==1/3&&px py==1/9&&joint!=px py];
report=<|"backend"->"Wolfram Language","scope"->"Algebraic induction certificates and quantified scalar bound; exact nonlinear dependence countermodel. Finite-dimensional Pearson theorem is checked in Lean.","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
