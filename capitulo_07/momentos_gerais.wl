BeginPackage["GeneralMoments`"];
If[!ValueQ[GeneralMoments`$LibraryMode],GeneralMoments`$LibraryMode=False];
mDirectory=DirectoryName[$InputFileName];
ProbabilityProof`$LibraryMode=True;
Block[{$ContextPath={"System`"}},Get[FileNameJoin[{mDirectory,"probabilidade_geral.wl"}]]];
MomentAlgebra`$LibraryMode=True;
Block[{$ContextPath={"System`"}},Get[FileNameJoin[{mDirectory,"momentos_algebra.wl"}]]];
mFail[x_]:=Throw[x,"GeneralMomentsFailure"];
GeneralMoments`check[id_,condition_]:=If[TrueQ[condition],AppendTo[mResults,<|"id"->id,"passed"->True|>],mFail[{"failed_check",id}]];
mV[a___]:=ProbabilityProof`pgV[a];mC[a___]:=ProbabilityProof`pgC[a];mFT[a___]:=ProbabilityProof`pgFT[a];mA[a___]:=ProbabilityProof`pgA[a];mLam[a___]:=ProbabilityProof`pgLam[a];mAll[a___]:=ProbabilityProof`pgAll[a];mEx[a___]:=ProbabilityProof`pgEx[a];mImp[a___]:=ProbabilityProof`pgImp[a];mAnd[a___]:=ProbabilityProof`pgAnd[a];mEq[a___]:=ProbabilityProof`pgEq[a];
mIff[a_,b_]:=mAnd[mImp[a,b],mImp[b,a]];
mAlls[vars_,body_]:=Fold[mAll[#2,#1]&,body,Reverse[vars]];
mImps[conditions_,body_]:=Fold[mImp[#2,#1]&,body,Reverse[conditions]];
mOmega="Omega";mFunction=mFT[mOmega,"R"];mList={"List",mFunction};
mZero=mC["zero_real","R"];mOne=mC["one_real","R"];
mOperator[name_]:=mC[name,mFT["R",mFT["R","R"]]];
mAdd[a_,b_]:=mA[mOperator["real_add"],a,b];mMul[a_,b_]:=mA[mOperator["real_mul"],a,b];mSub[a_,b_]:=mA[mOperator["real_sub"],a,b];mDiv[a_,b_]:=mA[mOperator["real_div"],a,b];
mLt[a_,b_]:=mA[mC["real_lt",mFT["R",mFT["R","Prop"]]],a,b];
mExpectation[f_]:=mA[mC["expectation",mFT[mFunction,"R"]],f];
mAddFunction[f_,g_]:=Module[{x=mV["sum_function_point",mOmega]},mLam[x,mAdd[mA[f,x],mA[g,x]]]];
mSubtractFunction[f_,g_]:=Module[{x=mV["difference_function_point",mOmega]},mLam[x,mSub[mA[f,x],mA[g,x]]]];
mScaleFunction[a_,f_]:=Module[{x=mV["scalar_function_point",mOmega]},mLam[x,mMul[a,mA[f,x]]]];
mConstant[a_]:=mLam[mV["constant_function_point",mOmega],a];
mProduct[f_,g_]:=Module[{x=mV["product_function_point",mOmega]},mLam[x,mMul[mA[f,x],mA[g,x]]]];
mSquare[f_]:=mProduct[f,f];mCentered[f_]:=mSubtractFunction[f,mConstant[mExpectation[f]]];
mVariance[f_]:=mExpectation[mSquare[mCentered[f]]];
mMomentVariance[f_]:=mSub[mExpectation[mSquare[f]],mMul[mExpectation[f],mExpectation[f]]];
mCovariance[f_,g_]:=mExpectation[mProduct[mCentered[f],mCentered[g]]];
mNil=mC["list_nil",mList];mCons=mC["list_cons",mFT[mFunction,mFT[mList,mList]]];
mTotal[x_]:=mA[mC["random_variable_list_sum",mFT[mList,mFunction]],x];
mCount[x_]:=mA[mC["random_variable_list_real_length",mFT[mList,"R"]],x];
mVarianceTotal[x_]:=mA[mC["random_variable_list_variance_sum",mFT[mList,"R"]],x];
mAllL2[x_]:=mA[mC["random_variable_list_l2",mFT[mList,"Prop"]],x];
mPairwise[x_]:=mA[mC["random_variable_list_pairwise_independent",mFT[mList,"Prop"]],x];
mEach[f_,xs_]:=mA[mC["random_variable_independent_of_each",mFT[mFunction,mFT[mList,"Prop"]]],f,xs];
mCommon[xs_,v_]:=mA[mC["random_variable_list_common_variance",mFT[mList,mFT["R","Prop"]]],xs,v];
mCenteredCommon[xs_,v_]:=mA[mC["random_variable_list_common_centered_variance",mFT[mList,mFT["R","Prop"]]],xs,v];
mMeanChain[xs_,v_]:=Module[{n=mCount[xs],s=mTotal[xs],scale,mean,a,b,c,d},scale=mDiv[mOne,mMul[n,n]];mean=mScaleFunction[mDiv[mOne,n],s];a=mVariance[mean];b=mMul[scale,mVariance[s]];c=mMul[scale,mVarianceTotal[xs]];d=mMul[scale,mMul[n,v]];mAnd[mEq[a,b],mAnd[mEq[b,c],mAnd[mEq[c,d],mEq[d,mDiv[v,n]]]]]];
mSpecialize[formula_,terms_List]:=Fold[Function[{current,term},If[First[current]=!="all",mFail["specialization requires universal formula"]];ProbabilityProof`pgSubstitute[current[[3]],current[[2]],term]],formula,terms];
mAntecedents[formula_]:=If[First[formula]==="imp",Prepend[mAntecedents[formula[[3]]],formula[[2]]],{}];
mL2[f_]:=First[mAntecedents[mSpecialize[mLiteralData["interfaces"]["l2_implies_integrable"],{f}]]];
mIndependent[f_,g_]:=mAntecedents[mSpecialize[mLiteralData["interfaces"]["independent_l2_product_integral"],{f,g}]][[3]];
mFoundations[]:=Module[{f=mV["function",mFunction],g=mV["other_function",mFunction],h=mV["list_head",mFunction],t=mV["list_tail",mList],v=mV["variance_value","R"],a=mV["real_value","R"],x=mV["extensional_point",mOmega],cons},cons=mA[mCons,h,t];<|
 "moment_function_extensionality"->mAlls[{f,g},mImp[mAll[x,mEq[mA[f,x],mA[g,x]]],mEq[f,g]]],
 "moment_total_nil"->mEq[mTotal[mNil],mConstant[mZero]],
 "moment_total_cons"->mAlls[{h,t},mEq[mTotal[cons],mAddFunction[h,mTotal[t]]]],
 "moment_count_nil"->mEq[mCount[mNil],mZero],
 "moment_count_cons"->mAlls[{h,t},mEq[mCount[cons],mAdd[mOne,mCount[t]]]],
 "moment_l2_nil"->mAllL2[mNil],
 "moment_l2_cons"->mAlls[{h,t},mIff[mAllL2[cons],mAnd[mL2[h],mAllL2[t]]]],
 "moment_pairwise_nil"->mPairwise[mNil],
 "moment_pairwise_cons"->mAlls[{h,t},mIff[mPairwise[cons],mAnd[mEach[h,t],mPairwise[t]]]],
 "moment_each_nil"->mAll[f,mEach[f,mNil]],
 "moment_each_cons"->mAlls[{f,h,t},mIff[mEach[f,cons],mAnd[mIndependent[f,h],mEach[f,t]]]],
 "moment_common_nil"->mAll[v,mCommon[mNil,v]],
 "moment_common_cons"->mAlls[{h,t,v},mIff[mCommon[cons,v],mAnd[mEq[mMomentVariance[h],v],mCommon[t,v]]]],
 "moment_centered_common_nil"->mAll[v,mCenteredCommon[mNil,v]],
 "moment_centered_common_cons"->mAlls[{h,t,v},mIff[mCenteredCommon[cons,v],mAnd[mEq[mVariance[h],v],mCenteredCommon[t,v]]]],
 "moment_variance_total_nil"->mEq[mVarianceTotal[mNil],mZero],
 "moment_variance_total_cons"->mAlls[{h,t},mEq[mVarianceTotal[cons],mAdd[mVariance[h],mVarianceTotal[t]]]],
 "moment_positive_reciprocal"->mAll[a,mImp[mLt[mZero,a],mEq[mMul[mDiv[mOne,a],a],mOne]]],
 "moment_positive_division_factor"->mAlls[{v,a},mImp[mLt[mZero,a],mEq[mDiv[v,a],mMul[v,mDiv[mOne,a]]]]],
 "moment_positive_reciprocal_square"->mAll[a,mImp[mLt[mZero,a],mEq[mMul[mDiv[mOne,a],mDiv[mOne,a]],mDiv[mOne,mMul[a,a]]]]]|>];
mTargets[]:=Module[{xs=mV["observations",mList],v=mV["population_variance","R"],f=mV["centered_left",mFunction],g=mV["centered_right",mFunction],variables,pairs,left,right,names={"u","v","e","w","f"},u,conditions},variables=AssociationThread[names,mV["component_"<>#,mFunction]&/@names];pairs={{"u","w"},{"u","f"},{"v","u"},{"v","w"},{"v","f"},{"e","u"},{"e","w"},{"e","f"}};u=variables["u"];left=mAddFunction[mAddFunction[u,variables["v"]],variables["e"]];right=mAddFunction[mAddFunction[u,variables["w"]],variables["f"]];conditions=Join[mL2/@Values[variables],mIndependent[variables[#[[1]]],variables[#[[2]]]]&/@pairs];<|
 "sample_mean_variance_from_pairwise_independence"->mAlls[{xs,v},mImps[{mAllL2[xs],mPairwise[xs],mCenteredCommon[xs,v],mLt[mZero,mCount[xs]]},mEq[mVariance[mScaleFunction[mDiv[mOne,mCount[xs]],mTotal[xs]]],mDiv[v,mCount[xs]]]]],
 "centered_independent_cross_moment_zero"->mAlls[{f,g},mImps[{mL2[f],mL2[g],mIndependent[f,g],mEq[mExpectation[f],mZero],mEq[mExpectation[g],mZero]},mEq[mExpectation[mProduct[f,g]],mZero]]],
 "shared_participant_covariance_from_independence"->mAlls[Values[variables],mImps[conditions,mEq[mCovariance[left,right],mVariance[u]]]],
 "sample_sum_variance_from_pairwise_independence"->mAlls[{xs,v},mImps[{mAllL2[xs],mPairwise[xs],mCenteredCommon[xs,v]},mEq[mVariance[mTotal[xs]],mMul[mCount[xs],v]]]],
 "sample_mean_variance_scaling"->mAlls[{xs,v},mImps[{mAllL2[xs],mPairwise[xs],mCenteredCommon[xs,v],mLt[mZero,mCount[xs]]},mEq[mVariance[mScaleFunction[mDiv[mOne,mCount[xs]],mTotal[xs]]],mMul[mDiv[mOne,mMul[mCount[xs],mCount[xs]]],mVariance[mTotal[xs]]]]]],
 "sample_variance_sum_additivity"->mAlls[{xs,v},mImps[{mAllL2[xs],mPairwise[xs],mCenteredCommon[xs,v]},mEq[mVariance[mTotal[xs]],mVarianceTotal[xs]]]],
 "sample_sum_of_common_variances"->mAlls[{xs,v},mImp[mCenteredCommon[xs,v],mEq[mVarianceTotal[xs],mMul[mCount[xs],v]]]],
 "sample_entire_variance_chain"->mAlls[{xs,v},mImps[{mAllL2[xs],mPairwise[xs],mCenteredCommon[xs,v],mLt[mZero,mCount[xs]]},mMeanChain[xs,v]]]|>];
SetAttributes[mInferProofs,HoldFirst];
mInferProofs[kernel_]:=Module[{expected=mTargets[],foundations=mFoundations[]},If[Sort[Keys[foundations]]=!=Sort[Keys[mLiteralData["foundations"]]]||!And@@Table[ProbabilityProof`pgSame[foundations[name],mLiteralData["foundations"][name]],{name,Keys[foundations]}],mFail["recursive definitions differ from proof data"]];Do[If[KeyExistsQ[expected,record[[1]]]&&!ProbabilityProof`pgSame[expected[record[[1]]],record[[2]]],mFail[{"wrong target",record[[1]]}]];ProbabilityProof`pgTheorem[kernel,record[[1]],record[[2]],record[[3]]],{record,mLiteralData["proofs"]}];expected];
mRemovePremise[formula_,index_]:=Which[First[formula]==="all",{"all",formula[[2]],mRemovePremise[formula[[3]],index]},First[formula]=!="imp",mFail["premise does not exist"],index==0,formula[[3]],True,{"imp",formula[[2]],mRemovePremise[formula[[3]],index-1]}];
mRejectProof[kernel_,formula_,proof_]:=Module[{copy=kernel},ProbabilityProof`pgRejects[ProbabilityProof`pgTheorem[copy,"invalid_missing_condition",formula,proof]]];
mRun[]:=Module[{kernel,expected,interfaces,required,verified,axioms,newAxioms,positiveDivision,records,mean,cross,shared},
 mResults={};If[!TrueQ[MomentAlgebra`report["passed"]],mFail["algebra failed"]];
 kernel=ProbabilityProof`pgKernel[ProbabilityProof`pgCertificateData["axioms"]];Do[ProbabilityProof`pgTheorem[kernel,record[[1]],record[[2]],record[[3]]],{record,ProbabilityProof`pgCertificateData["proofs"]}];
 interfaces=mLiteralData["interfaces"];required=Keys[interfaces];verified=kernel["verified"];axioms=kernel["axioms"];
 If[Intersection[required,Keys[axioms]]=!={}||!And@@(KeyExistsQ[verified,#]&/@required),mFail["general integration interface is not fully proved"]];
 Do[If[!ProbabilityProof`pgSame[verified[name]["conclusion"],interfaces[name]],mFail[{"interface changed",name}]],{name,required}];
 newAxioms=mFoundations[];If[Intersection[Keys[newAxioms],Join[Keys[axioms],Keys[verified]]]=!={},mFail["foundation name collision"]];AssociateTo[kernel,"axioms"->Join[axioms,newAxioms]];
 positiveDivision=Resolve[ForAll[{a,v},Implies[a>0,(1/a)a==1&&v/a==v(1/a)&&(1/a)^2==1/(a*a)]],Reals];
 GeneralMoments`check["ordered_field_denominators_and_reciprocals",positiveDivision];
 expected=mInferProofs[kernel];
 GeneralMoments`check["general_mean_variance_from_original_hypotheses",ProbabilityProof`pgInfer[kernel,{"ref","sample_mean_variance_from_pairwise_independence"}]["assumptions"]==={}&&ProbabilityProof`pgSame[kernel["verified"]["sample_mean_variance_from_pairwise_independence"]["conclusion"],expected["sample_mean_variance_from_pairwise_independence"]]];
 GeneralMoments`check["general_centered_independent_cross_moment",ProbabilityProof`pgInfer[kernel,{"ref","centered_independent_cross_moment_zero"}]["assumptions"]==={}&&ProbabilityProof`pgSame[kernel["verified"]["centered_independent_cross_moment_zero"]["conclusion"],expected["centered_independent_cross_moment_zero"]]];
 GeneralMoments`check["general_shared_participant_covariance",ProbabilityProof`pgInfer[kernel,{"ref","shared_participant_covariance_from_independence"}]["assumptions"]==={}&&ProbabilityProof`pgSame[kernel["verified"]["shared_participant_covariance_from_independence"]["conclusion"],expected["shared_participant_covariance_from_independence"]]];
 GeneralMoments`check["sample_mean_chain_sum_variance",ProbabilityProof`pgInfer[kernel,{"ref","sample_sum_variance_from_pairwise_independence"}]["assumptions"]==={}];
 GeneralMoments`check["sample_mean_chain_scalar_variance",ProbabilityProof`pgInfer[kernel,{"ref","sample_mean_variance_scaling"}]["assumptions"]==={}];
 GeneralMoments`check["sample_mean_chain_variance_additivity",ProbabilityProof`pgInfer[kernel,{"ref","sample_variance_sum_additivity"}]["assumptions"]==={}];
 GeneralMoments`check["sample_mean_chain_common_variance_sum",ProbabilityProof`pgInfer[kernel,{"ref","sample_sum_of_common_variances"}]["assumptions"]==={}];
 GeneralMoments`check["sample_entire_displayed_variance_chain",ProbabilityProof`pgInfer[kernel,{"ref","sample_entire_variance_chain"}]["assumptions"]==={}&&ProbabilityProof`pgSame[kernel["verified"]["sample_entire_variance_chain"]["conclusion"],expected["sample_entire_variance_chain"]]];
 GeneralMoments`check["no_general_probability_result_postulated",Intersection[required,Keys[kernel["axioms"]]]==={}];
 records=Association[(#[[1]]->#&/@mLiteralData["proofs"])];mean=records["sample_mean_variance_from_pairwise_independence"];cross=records["centered_independent_cross_moment_zero"];shared=records["shared_participant_covariance_from_independence"];
 GeneralMoments`check["reject_missing_sample_positivity",mRejectProof[kernel,mRemovePremise[mean[[2]],3],mean[[3]]]];
 GeneralMoments`check["reject_missing_common_variance",mRejectProof[kernel,mRemovePremise[mean[[2]],2],mean[[3]]]];
 GeneralMoments`check["reject_missing_pairwise_independence",mRejectProof[kernel,mRemovePremise[mean[[2]],1],mean[[3]]]];
 GeneralMoments`check["reject_missing_product_independence",mRejectProof[kernel,mRemovePremise[cross[[2]],2],cross[[3]]]];
 GeneralMoments`check["reject_each_missing_shared_independence",And@@Table[mRejectProof[kernel,mRemovePremise[shared[[2]],index],shared[[3]]],{index,5,12}]];
 mVerification=<|"kernel"->kernel,"targets"->expected|>;
 <|"backend"->"Wolfram Language","passed"->And@@Lookup[mResults,"passed"],"results"->mResults,"general_probability_complete"->True,"derived_theorems"->Length[kernel["verified"]],"scope"->"Arbitrary probability spaces and square-integrable real random variables; finite nonempty samples with pairwise independence and common variance; eight cross independences for shared participant covariance; no normality or finite support hypothesis."|>];

