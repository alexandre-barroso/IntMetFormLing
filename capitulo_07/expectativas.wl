ClearAll["Global`*"];
variance[x_]:=expectation[(x-expectation[x])^2];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["zero_centered_integrand",Expand[(u-0)^2-u^2]==0];
check["expectation_of_identical_integrands",expectation[(u-0)^2]===expectation[u^2]];
check["variance_definition",variance[u]===expectation[(u-expectation[u])^2]];
check["mean_zero_variance_chain",(variance[u]/.expectation[u]->0)===expectation[(u-0)^2]&&expectation[(u-0)^2]===expectation[u^2]];
check["nonzero_mean_cannot_be_erased",(variance[u]/.expectation[u]->1)=!=expectation[u^2]];
check["unspecified_mean_cannot_be_erased",(variance[u]/.expectation[u]->m)=!=expectation[u^2]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"definitional identity for a square-integrable real random variable with mean0; expectation kept as an arbitrary operator on integrands; no Gaussian or independence premise","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
