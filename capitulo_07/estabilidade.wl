ClearAll["Global`*"];
Begin["BootstrapBinary`"];
binaryDependencyOK=Catch[Block[{$Path=Prepend[$Path,DirectoryName[$InputFileName]],System`Exit=(If[#==0,Null,Throw[False,"binaryDependency"]]&),System`Print=(Null&)},Get["escolhas.wl"]];True,"binaryDependency"];
End[];
If[!TrueQ[BootstrapBinary`binaryDependencyOK]||Length[BootstrapBinary`results]!=18||!And@@Lookup[BootstrapBinary`results,"passed"],Print["binary enumeration dependency"];Exit[1]];
ClearAll["Global`*"];
naturalAssumptions=Element[{n,k,j},Integers]&&n>=0&&k>=0&&j>=0;
monomialEqual[left_,right_]:=TrueQ[Simplify[left[[2]]==right[[2]]&&left[[3]]==right[[3]]]]&&TrueQ[FullSimplify[left[[1]]==right[[1]],naturalAssumptions]];
monomialShift[term_,pd_,qd_]:={term[[1]],term[[2]]+pd,term[[3]]+qd};
monomialAdd[left_,right_]:=If[TrueQ[Simplify[left[[2]]==right[[2]]&&left[[3]]==right[[3]]]],{left[[1]]+right[[1]],left[[2]],left[[3]]},$Failed];
binomialTerm[size_,index_]:={Binomial[size,index],index,size-index};
coefficientInduction[term_]:=monomialEqual[term[0,0],{1,0,0}]&&monomialEqual[term[n+1,0],monomialShift[term[n,0],0,1]]&&monomialEqual[term[n+1,n+1],monomialShift[term[n,n],1,0]]&&monomialEqual[term[k+j+2,k+1],monomialAdd[monomialShift[term[k+j+1,k],1,0],monomialShift[term[k+j+1,k+1],0,1]]];
transition[nil,prev_]:=cons[p*prev,nil];
transition[cons[weight_,rest_],prev_]:=cons[q*weight+p*prev,transition[rest,weight]];
length[nil]=0;
length[cons[weight_,rest_]]:=1+length[rest];
fold[nil,start_,body_]:=0;
fold[cons[weight_,rest_],start_,body_]:=weight*(body/.k->start)+fold[rest,start+1,body];
foldInduction[left_,right_]:=Module[{base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},If[!FreeQ[{left,right},tail|h],Return[False]];base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.{xs->tail,i->i+1};hypothesisRight=right/.{xs->tail,i->i+1};stepLeft=(left/.xs->cons[h,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[h,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
rowLengthInduction[]:=Module[{left,right,base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},left=length[transition[xs,previous]];right=length[xs]+1;base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.{xs->tail,previous->h};hypothesisRight=right/.xs->tail;stepLeft=(left/.xs->cons[h,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[h,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0&&length[cons[1,nil]]==1]];
weightedTransitionInduction[]:=Module[{left,right,base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},left=fold[transition[xs,previous],i,ff[k]];right=q*fold[xs,i,ff[k]]+p*fold[xs,i+1,ff[k]]+p*previous*ff[i];base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.{xs->tail,previous->h,i->i+1};hypothesisRight=right/.{xs->tail,previous->h,i->i+1};stepLeft=(left/.xs->cons[h,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[h,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
shiftBodyCertificate[power_]:=Module[{shifted,right},shifted=Expand[(k+1)^power];right=Sum[Coefficient[shifted,k,r]*fold[xs,i,k^r],{r,0,power}];foldInduction[fold[xs,i,shifted],right]];
momentInduction[closedForms_]:=Module[{base,nextMoment,coefficients},If[!coefficientInduction[binomialTerm]||!rowLengthInduction[]||!weightedTransitionInduction[]||!foldInduction[fold[xs,i+1,ff[k]],fold[xs,i,ff[k+1]]]||Length[closedForms]!=3,Return[False]];And@@Table[base=fold[cons[1,nil],0,k^order];coefficients=Expand[(k+1)^order];nextMoment=(q*closedForms[[order+1]]+p*Sum[Coefficient[coefficients,k,r]*closedForms[[r+1]],{r,0,order}])/.q->1-p;shiftBodyCertificate[order]&&TrueQ[Expand[(closedForms[[order+1]]/.n->0)-base]==0]&&TrueQ[Expand[nextMoment-(closedForms[[order+1]]/.n->n+1)]==0],{order,0,2}]];
endpointRecurrences[]:=Module[{zeroBase,zeroLeft,zeroRight,oneBase,oneLeft,oneRight},zeroBase=(transition[nil,previous]/.{p->0,q->1})===cons[0,nil];zeroLeft=(transition[cons[h,tail],previous]/.{p->0,q->1})/.transition[tail,h]->pad[tail];zeroRight=cons[h,pad[tail]];oneBase=(transition[nil,previous]/.{p->1,q->0})===cons[previous,nil];oneLeft=(transition[cons[h,tail],previous]/.{p->1,q->0})/.transition[tail,h]->cons[h,tail];oneRight=cons[previous,cons[h,tail]];zeroBase&&zeroLeft===zeroRight&&oneBase&&oneLeft===oneRight];
naturalPower[base_,0]:=1;
naturalPower[base_,exponent_Integer?Positive]:=base*naturalPower[base,exponent-1];
singleCoefficientBoundInduction[]:=Module[{stepTotal,definition,headGap,tailGap},stepTotal=fold[cons[h,tail],i,1];definition=stepTotal===h+fold[tail,i+1,1];headGap=Expand[(h+tailTotal)-h]/.tailTotal->rest;tailGap=Expand[(h+tailTotal)-selected]/.{h->un,tailTotal->selected+rest};definition&&TrueQ[FullSimplify[headGap>=0&&tailGap>=0,Element[{un,rest,selected},Reals]&&un>=0&&rest>=0]]];
moments={1,n*p,(n*p)^2+n*p*(1-p)};
treeProved=<||>;
wordWeight[wordNil]=1;
wordWeight[wordCons[0,rest_]]:=q*wordWeight[rest];
wordWeight[wordCons[1,rest_]]:=p*wordWeight[rest];
wordOnes[wordNil]=0;
wordOnes[wordCons[0,rest_]]:=wordOnes[rest];
wordOnes[wordCons[1,rest_]]:=wordOnes[rest]+1;
familyAppend[familyNil,right_]:=right;
familyAppend[familyCons[word_,rest_],right_]:=familyCons[word,familyAppend[rest,right]];
prefixMap[bit_,familyNil]:=familyNil;
prefixMap[bit_,familyCons[word_,rest_]]:=familyCons[wordCons[bit,word],prefixMap[bit,rest]];
binaryTree[0]=familyCons[wordNil,familyNil];
binaryTree[n+1]:=familyAppend[prefixMap[0,binaryTree[n]],prefixMap[1,binaryTree[n]]];
binomialRow[0]=cons[1,nil];
binomialRow[n+1]:=transition[binomialRow[n],0];
treeSum[familyNil,body_]:=0;
treeSum[familyCons[word_,rest_],body_]:=wordWeight[word]*(body/.k->wordOnes[word])+treeSum[rest,body];
treeSum[familyAppend[left_,right_],body_]/;KeyExistsQ[treeProved,"sum_append"]:=treeSum[left,body]+treeSum[right,body];
treeSum[prefixMap[0,rest_],body_]/;KeyExistsQ[treeProved,"sum_prefix_zero"]:=q*treeSum[rest,body];
treeSum[prefixMap[1,rest_],body_]/;KeyExistsQ[treeProved,"sum_prefix_one"]:=p*treeSum[rest,body/.k->k+1];
treeFamilyInduction[left_,right_]:=Module[{base,ihLeft,ihRight,stepLeft,stepRight},If[!FreeQ[{left,right},wordHead|familyTail],Return[False]];base=Expand[(left/.family->familyNil)-(right/.family->familyNil)];ihLeft=left/.family->familyTail;ihRight=right/.family->familyTail;stepLeft=left/.family->familyCons[wordHead,familyTail];stepRight=right/.family->familyCons[wordHead,familyTail];TrueQ[base==0&&Expand[(stepLeft/.ihLeft->ihRight)-stepRight]==0]];
treeRules=<|"sum_append"->{treeSum[familyAppend[family,otherFamily],ff[k]],treeSum[family,ff[k]]+treeSum[otherFamily,ff[k]]},"sum_prefix_zero"->{treeSum[prefixMap[0,family],ff[k]],q*treeSum[family,ff[k]]},"sum_prefix_one"->{treeSum[prefixMap[1,family],ff[k]],p*treeSum[family,ff[k+1]]}|>;
treeCertify[name_,left_,right_]:=Module[{valid},If[!KeyExistsQ[treeRules,name]||!SameQ[treeRules[name],{left,right}],Return[False]];If[KeyExistsQ[treeProved,name],Return[True]];valid=treeFamilyInduction[left,right];If[valid,AssociateTo[treeProved,name->True]];valid];
binaryEnumerationCertificate[]:=Module[{expectedBase,expectedStep,exactDefinitions,ownDefinitions},expectedBase=BootstrapBinary`tm["fcons",BootstrapBinary`snil,BootstrapBinary`fnil];expectedStep=BootstrapBinary`tm["append",BootstrapBinary`tm["map",BootstrapBinary`bit0,BootstrapBinary`tm["enum",BootstrapBinary`n]],BootstrapBinary`tm["map",BootstrapBinary`bit1,BootstrapBinary`tm["enum",BootstrapBinary`n]]];exactDefinitions=SameQ[BootstrapBinary`norm[BootstrapBinary`tm["enum",BootstrapBinary`zero]],expectedBase]&&SameQ[BootstrapBinary`norm[BootstrapBinary`tm["enum",BootstrapBinary`tm["succ",BootstrapBinary`n]]],expectedStep];ownDefinitions=SameQ[binaryTree[0],familyCons[wordNil,familyNil]]&&SameQ[binaryTree[n+1],familyAppend[prefixMap[0,binaryTree[n]],prefixMap[1,binaryTree[n]]]];exactDefinitions&&ownDefinitions&&BootstrapBinary`coverageInduction[]&&BootstrapBinary`naturalInduction[BootstrapBinary`tm["unique",BootstrapBinary`tm["enum",BootstrapBinary`n]],BootstrapBinary`pTrue,BootstrapBinary`n]];
sequenceCountLaw[zeroFactor_:q,oneFactor_:p]:=Module[{sequenceBase,countBase,sequenceNext,expectedSequenceNext,countNext,transitionLeft,transitionRight,replacements},If[!binaryEnumerationCertificate[]||!And@@KeyValueMap[treeCertify[#1,Sequence@@#2]&,treeRules]||!coefficientInduction[binomialTerm]||!weightedTransitionInduction[]||!foldInduction[fold[xs,i+1,ff[k]],fold[xs,i,ff[k+1]]],Return[False]];sequenceBase=treeSum[binaryTree[0],ff[k]];countBase=fold[binomialRow[0],0,ff[k]];If[!SameQ[sequenceBase,countBase],Return[False]];sequenceNext=treeSum[binaryTree[n+1],ff[k]];expectedSequenceNext=zeroFactor*treeSum[binaryTree[n],ff[k]]+oneFactor*treeSum[binaryTree[n],ff[k+1]];If[!TrueQ[Expand[sequenceNext-expectedSequenceNext]==0],Return[False]];countNext=fold[binomialRow[n+1],0,ff[k]];transitionLeft=fold[transition[xs,previous],i,ff[k]];transitionRight=q*fold[xs,i,ff[k]]+p*fold[xs,i+1,ff[k]]+p*previous*ff[i];replacements={xs->binomialRow[n],previous->0,i->0};countNext=countNext/.(transitionLeft/.replacements)->(transitionRight/.replacements);countNext=countNext/.fold[binomialRow[n],1,ff[k]]->fold[binomialRow[n],0,ff[k+1]];sequenceNext=sequenceNext/.{treeSum[binaryTree[n],ff[k]]->fold[binomialRow[n],0,ff[k]],treeSum[binaryTree[n],ff[k+1]]->fold[binomialRow[n],0,ff[k+1]]};TrueQ[Expand[sequenceNext-countNext]==0]];
positiveCount=Element[beta,Integers]&&beta>0;
bootstrapAverageCertificate[proposedMean_,proposedVariance_,repetitions_:beta]:=Module[{countDomain,meanLeft,meanRight,varianceLeft,varianceRight,m0,m1,m2,expectedMean,expectedVariance},countDomain=TrueQ[FullSimplify[Element[repetitions,Integers]&&repetitions>0,positiveCount]];If[!countDomain||!sequenceCountLaw[]||!momentInduction[moments],Return[False]];meanLeft=fold[xs,i,k/repetitions];meanRight=fold[xs,i,k]/repetitions;varianceLeft=fold[xs,i,(k/repetitions-p)^2];varianceRight=fold[xs,i,k^2]/repetitions^2-2*p*fold[xs,i,k]/repetitions+p^2*fold[xs,i,1];If[!foldInduction[meanLeft,meanRight]||!foldInduction[varianceLeft,varianceRight],Return[False]];{m0,m1,m2}=moments/.n->repetitions;expectedMean=m1/repetitions;expectedVariance=m2/repetitions^2-2*p*m1/repetitions+p^2*m0;TrueQ[Together[expectedMean-proposedMean]==0&&Together[expectedVariance-proposedVariance]==0]];
monotonicityCertificate[proposedGap_]:=Module[{exactGap,expandedGap,domain,weak,strict},If[!bootstrapAverageCertificate[p,p*(1-p)/beta],Return[False]];exactGap=p*(1-p)/beta1-p*(1-p)/beta2;If[!TrueQ[Together[exactGap-proposedGap]==0],Return[False]];expandedGap=Together[(proposedGap/.beta2->beta1+delta)-p*(1-p)*delta/(beta1*(beta1+delta))];domain=Resolve[ForAll[p,Equivalent[p>=0&&1-p>=0,0<=p<=1]],Reals];weak=FullSimplify[pn*qn*delta/(beta1*(beta1+delta))>=0,Element[{pn,qn,beta1,delta},Reals]&&pn>=0&&qn>=0&&beta1>0&&delta>=0];strict=FullSimplify[pp*qq*deltaStrict/(beta1*(beta1+deltaStrict))>0,Element[{pp,qq,beta1,deltaStrict},Reals]&&pp>0&&qq>0&&beta1>0&&deltaStrict>0];TrueQ[expandedGap==0&&domain&&weak&&strict]];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["binary_sequences_complete_and_unique",binaryEnumerationCertificate[]];
check["sequence_product_weight_base_and_branches",wordWeight[wordNil]==1&&wordWeight[wordCons[0,wordHead]]==q*wordWeight[wordHead]&&wordWeight[wordCons[1,wordHead]]==p*wordWeight[wordHead]];
check["success_count_base_and_branches",wordOnes[wordNil]==0&&wordOnes[wordCons[0,wordHead]]==wordOnes[wordHead]&&wordOnes[wordCons[1,wordHead]]==wordOnes[wordHead]+1];
check["sequence_sum_append_induction",treeCertify["sum_append",Sequence@@treeRules["sum_append"]]];
check["sequence_sum_zero_prefix_induction",treeCertify["sum_prefix_zero",Sequence@@treeRules["sum_prefix_zero"]]];
check["sequence_sum_one_prefix_induction",treeCertify["sum_prefix_one",Sequence@@treeRules["sum_prefix_one"]]];
check["independent_sequence_count_binomial_law",sequenceCountLaw[]];
check["incorrect_zero_branch_weight_rejected",!sequenceCountLaw[p,p]];
check["omitted_success_increment_rejected",!treeCertify["sum_prefix_one",treeSum[prefixMap[1,family],ff[k]],p*treeSum[family,ff[k]]]];
check["binomial_coefficients_from_independent_trial_convolution",coefficientInduction[binomialTerm]&&rowLengthInduction[]&&weightedTransitionInduction[]];
check["binomial_normalization_mean_second_moment_induction",momentInduction[moments]];
check["probability_parameter_domain",Resolve[ForAll[p,Equivalent[p>=0&&1-p>=0,0<=p<=1]],Reals]];
check["probability_mass_nonnegative_induction",1>=0&&FullSimplify[qn*un+pn*vn>=0&&pn*un>=0,Element[{pn,qn,un,vn},Reals]&&pn>=0&&qn>=0&&un>=0&&vn>=0]];
check["average_expectation_scaling_induction",foldInduction[fold[xs,i,k/beta],fold[xs,i,k]/beta]];
check["average_centered_square_expansion_induction",foldInduction[fold[xs,i,(k/beta-p)^2],fold[xs,i,k^2]/beta^2-2*p*fold[xs,i,k]/beta+p^2*fold[xs,i,1]]];
check["bootstrap_average_mean_and_variance",bootstrapAverageCertificate[p,p*(1-p)/beta]];
check["variance_decrease_exact_difference",Together[p*(1-p)/beta1-p*(1-p)/beta2-p*(1-p)*(beta2-beta1)/(beta1*beta2)]==0];
check["variance_nonstrict_and_strict_monotonicity",monotonicityCertificate[p*(1-p)*(beta2-beta1)/(beta1*beta2)]];
check["endpoint_variance_zero",endpointRecurrences[]&&And@@Table[Together[(p*(1-p)/beta)/.p->endpoint]==0,{endpoint,{0,1}}]];
check["equal_repetitions_equal_variance",Together[(p*(1-p)*(beta2-beta1)/(beta1*beta2))/.beta2->beta1]==0];
check["dependence_counterexample",1/2*(0-1/2)^2+1/2*(1-1/2)^2==1/4&&1/2*(1-1/2)/2==1/8&&1/4!=1/8];
check["wrong_variance_power_rejected",!bootstrapAverageCertificate[p,p*(1-p)/beta^2]];
check["wrong_mean_rejected",!bootstrapAverageCertificate[p+1,p*(1-p)/beta]];
check["zero_repetitions_rejected",!bootstrapAverageCertificate[p,p*(1-p),0]];
check["noninteger_repetitions_rejected",!bootstrapAverageCertificate[p,p*(1-p),1/2]];
check["wrong_monotonicity_sign_rejected",!monotonicityCertificate[-p*(1-p)*(beta2-beta1)/(beta1*beta2)]];
check["outside_probability_counterexample",Binomial[1,0]*naturalPower[2,0]*naturalPower[1-2,1]==-1];
Print[ExportString[<|"backend"->"Wolfram","scope"->"Conditional on a fixed observed corpus and fixed p in [0,1], the b>0 indicators are independent Bernoulli(p). The complete, duplicate-free binary-word enumeration has product weights q=1-p for zero and p for one and a recursive count of ones. Structural induction on finite weighted families derives prefix splitting, and induction on b proves its weighted expectations equal the actual binomial convolution row for arbitrary functions of the count. Its coefficients and moments are then certified by structural induction, including p=0 and p=1. Finite-fold linearity proves E[S/b]=p and Var(S/b)=p(1-p)/b. Increasing the positive integer b decreases this variance, strictly only for 0<p<1 and a strict increase of b. The corpus is fixed as a model hypothesis; this does not assert reduction of sampling uncertainty or acquisition of new observations. A perfectly dependent two-replicate counterexample rejects the iid formula without independence.","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
