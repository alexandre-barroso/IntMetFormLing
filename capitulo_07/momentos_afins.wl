afRun[]:=Block[{$RecursionLimit=20000,$IterationLimit=Infinity},Module[{base,kernel,expected,shared,records,full,wrong,placeholder},
 afResults={};base=GeneralMoments`mRun[];If[!TrueQ[base["passed"]],GeneralMoments`mFail["general moments not proved"]];kernel=GeneralMoments`mVerification["kernel"];expected=afTargets[];
 Do[If[!KeyExistsQ[expected,record[[1]]]||!ProbabilityProof`pgSame[expected[record[[1]]],record[[2]]],GeneralMoments`mFail[{"affine target mismatch",record[[1]]}]];ProbabilityProof`pgTheorem[kernel,record[[1]],record[[2]],record[[3]]],{record,afData["proofs"]}];
 records=Association[(#[[1]]->#&/@afData["proofs"])];full=records["full_response_covariance_equals_shared_variance"];shared=afSharedData[];
 AffineMoments`check["centered_functions_equal_after_fixed_translation",kernel["verified"]["centered_function_unchanged_by_constant_translation"]["assumptions"]==={}];
 AffineMoments`check["covariance_invariant_under_fixed_translation",kernel["verified"]["covariance_unchanged_by_constant_translation"]["assumptions"]==={}];
 AffineMoments`check["full_response_covariance_exact_hypotheses",ProbabilityProof`pgSame[full[[2]],expected[full[[1]]]]&&kernel["verified"][full[[1]]]["assumptions"]==={}];
 AffineMoments`check["no_translation_or_shared_result_assumed",Intersection[{"centered_function_unchanged_by_constant_translation","covariance_unchanged_by_constant_translation","shared_participant_covariance_from_independence","full_response_covariance_equals_shared_variance"},Keys[kernel["axioms"]]]==={}];
 AffineMoments`check["reject_each_removed_cross_independence",And@@Table[GeneralMoments`mRejectProof[kernel,GeneralMoments`mRemovePremise[full[[2]],i],full[[3]]],{i,5,12}]];
 AffineMoments`check["reject_each_removed_square_integrability",And@@Table[GeneralMoments`mRejectProof[kernel,GeneralMoments`mRemovePremise[full[[2]],i],full[[3]]],{i,0,4}]];
 AffineMoments`check["reject_random_shift_as_fixed_constant",ProbabilityProof`pgRejects[ProbabilityProof`pgInfer[kernel,ProbabilityProof`pgInstantiate[{"ref","covariance_unchanged_by_constant_translation"},shared["first"],shared["second"],shared["variables"]["v"],shared["b"]]]]];
 wrong=full[[2]]/.GeneralMoments`mVariance[shared["variables"]["u"]]->GeneralMoments`mZero;
 AffineMoments`check["reject_erasing_shared_variance",GeneralMoments`mRejectProof[kernel,wrong,full[[3]]]];
 afVerification=<|"kernel"->kernel,"targets"->expected|>;
 <|"backend"->"Wolfram","results"->afResults,"derived"->Keys[expected],"passed"->And@@Lookup[afResults,"passed"]|>]];
If[!TrueQ[AffineMoments`$LibraryMode],afReport=Catch[afRun[],_,Function[{value,tag},<|"passed"->False,"error"->ToString[value,InputForm],"tag"->ToString[tag,InputForm]|>]];Print[ExportString[afReport,"RawJSON"]];If[TrueQ[afReport["passed"]],Exit[0],Exit[1]]];
End[];
