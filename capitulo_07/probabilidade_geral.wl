Begin["ProbabilityProof`"];
ClearAll["ProbabilityProof`pg*"];
pgFail[value_]:=Throw[value,"ProbabilityKernelError"];
pgV[name_,sort_]:={"v",name,sort};
pgC[name_,sort_]:={"c",name,sort};
pgFT[domain_,codomain_]:={"fun",domain,codomain};
pgA[function_,arguments___]:=Fold[{"app",#1,#2}&,function,{arguments}];
pgLam[variable_,body_]:={"lam",variable,body};
pgAll[variable_,body_]:={"all",variable,body};
pgEx[variable_,body_]:={"ex",variable,body};
pgImp[left_,right_]:={"imp",left,right};
pgAnd[left_,right_]:={"and",left,right};
pgOr[left_,right_]:={"or",left,right};
pgEq[left_,right_]:={"eq",left,right};
pgBottom={"false"};
pgSort[term_]:=Module[{tag,functionSort,bodySort},
 If[!ListQ[term]||Length[term]==0,pgFail["malformed term"]];
 tag=First[term];
 Switch[tag,
 "v"|"c",If[Length[term]!=3||!StringQ[term[[2]]],pgFail["malformed symbol"]];term[[3]],
 "app",If[Length[term]!=3,pgFail["malformed application"]];functionSort=pgSort[term[[2]]];If[!ListQ[functionSort]||Length[functionSort]!=3||First[functionSort]=!="fun"||functionSort[[2]]=!=pgSort[term[[3]]],pgFail["application type mismatch"]];functionSort[[3]],
 "lam"|"all"|"ex",If[Length[term]!=3||First[term[[2]]]=!="v",pgFail["malformed binder"]];bodySort=pgSort[term[[3]]];If[tag==="lam",pgFT[pgSort[term[[2]]],bodySort],If[bodySort=!="Prop",pgFail["quantified body is not a formula"]];"Prop"],
 "imp"|"and"|"or",If[Length[term]!=3||pgSort[term[[2]]]=!="Prop"||pgSort[term[[3]]]=!="Prop",pgFail["logical connective type mismatch"]];"Prop",
 "eq",If[Length[term]!=3||pgSort[term[[2]]]=!=pgSort[term[[3]]],pgFail["equality type mismatch"]];"Prop",
 "false",If[term=!=pgBottom,pgFail["malformed false"]];"Prop",
 _,pgFail[{"unknown term constructor",tag}]]];
pgFree[term_]:=Switch[First[term],"v",{term},"c"|"false",{},"lam"|"all"|"ex",DeleteCases[pgFree[term[[3]]],x_/;x===term[[2]]],_,DeleteDuplicates[Flatten[pgFree/@Rest[term],1]]];
pgSubstitute[term_,variable_,replacement_]:=Module[{binder,body},
 If[First[variable]=!="v"||pgSort[variable]=!=pgSort[replacement],pgFail["substitution type mismatch"]];
 If[term===variable,Return[replacement]];
 If[MemberQ[{"v","c","false"},First[term]],Return[term]];
 If[MemberQ[{"lam","all","ex"},First[term]],
  {binder,body}=Rest[term];If[binder===variable,Return[term]];
  If[MemberQ[pgFree[replacement],binder]&&MemberQ[pgFree[body],variable],pgFail["capturing substitution"]];
  Return[{First[term],binder,pgSubstitute[body,variable,replacement]}]];
 Prepend[pgSubstitute[#,variable,replacement]&/@Rest[term],First[term]]];
pgNormalize[term_]:=Module[{reduced},
 If[MemberQ[{"v","c","false"},First[term]],Return[term]];
 If[MemberQ[{"lam","all","ex"},First[term]],Return[{First[term],term[[2]],pgNormalize[term[[3]]]}]];
 reduced=Prepend[pgNormalize/@Rest[term],First[term]];
 If[First[reduced]==="app"&&First[reduced[[2]]]==="lam",pgNormalize[pgSubstitute[reduced[[2,3]],reduced[[2,2]],reduced[[3]]]],reduced]];
pgAlpha[term_,bound_:{}]:=Module[{position},
 Switch[First[term],
 "v",position=FirstPosition[Reverse[bound],term,Missing["NotFound"],{1}];If[MissingQ[position],term,{"bound",First[position]-1,term[[3]]}],
 "c"|"false",term,
 "lam"|"all"|"ex",{First[term],term[[2,3]],pgAlpha[term[[3]],Append[bound,term[[2]]]]},
 _,Prepend[pgAlpha[#,bound]&/@Rest[term],First[term]]]];
pgSame[left_,right_]:=pgAlpha[pgNormalize[left]]===pgAlpha[pgNormalize[right]];
pgAtoms[formula_]:=If[MemberQ[{"imp","and","or"},First[formula]],Union[pgAtoms[formula[[2]]],pgAtoms[formula[[3]]]],If[formula===pgBottom,{},{formula}]];
pgBoolean[formula_,components_,values_]:=Switch[First[formula],
 "false",False,
 "and",pgBoolean[formula[[2]],components,values]&&pgBoolean[formula[[3]],components,values],
 "or",pgBoolean[formula[[2]],components,values]||pgBoolean[formula[[3]],components,values],
 "imp",!pgBoolean[formula[[2]],components,values]||pgBoolean[formula[[3]],components,values],
 _,values[[First[FirstPosition[components,formula,Missing["NotFound"],{1}]]]]];
pgTautology[formula_]:=Module[{components=pgAtoms[formula]},If[Length[components]>16,pgFail["propositional certificate too large"]];And@@(pgBoolean[formula,components,#]&/@Tuples[{False,True},Length[components]])];
pgRingIdentity[left_,right_]:=Module[{symbols=<||>,encode,zero=pgC["zero_real","R"],one=pgC["one_real","R"],op,term},
 encode[input_]:=Module[{t=pgNormalize[input],key,operator},If[t===zero,Return[0]];If[t===one,Return[1]];If[First[t]==="app"&&First[t[[2]]]==="app",operator=t[[2,2]];If[operator===pgC["real_add",pgFT["R",pgFT["R","R"]]],Return[encode[t[[2,3]]]+encode[t[[3]]]]];If[operator===pgC["real_sub",pgFT["R",pgFT["R","R"]]],Return[encode[t[[2,3]]]-encode[t[[3]]]]];If[operator===pgC["real_mul",pgFT["R",pgFT["R","R"]]],Return[encode[t[[2,3]]]*encode[t[[3]]]]]];key=ToString[pgAlpha[t],InputForm];If[!KeyExistsQ[symbols,key],AssociateTo[symbols,key->Unique["ringVariable"]]];symbols[key]];
 TrueQ[Expand[encode[left]-encode[right]]===0]];
pgSequent[assumptions_,conclusion_]:=<|"assumptions"->DeleteDuplicates[assumptions],"conclusion"->conclusion|>;
pgKernel[axioms_Association]:=Module[{},
 If[!And@@(pgSort[#]==="Prop"&&pgFree[#]==={}&/@Values[axioms]),pgFail["axiom must be a closed formula"]];
 <|"axioms"->axioms,"verified"-><||>,"records"->{}|>];
pgLookup[association_,key_]:=If[KeyExistsQ[association,key],association[key],pgFail[{"unknown proof or axiom",key}]];
pgRemove[items_,item_]:=Select[items,#=!=item&];
pgInfer[kernel_,proof_,environment_:<||>]:=Module[{rule,data,formula,name,extended,result,assumption,implication,antecedent,left,right,other,conclusion,choice,remaining,variable,replacement,existential,witness,instance,eigenvariable,protected,equality,pattern,target,body,base,step,zero,successor,expectedStep,assumptions,head,tail,listSort,nil,cons},
 If[!ListQ[proof]||Length[proof]==0,pgFail["malformed proof"]];
 rule=First[proof];data=Rest[proof];
 Switch[rule,
 "assume",{formula}=data;If[pgSort[formula]=!="Prop",pgFail["assumption is not a formula"]];pgSequent[{formula},formula],
 "axiom",{name}=data;pgSequent[{},pgLookup[kernel["axioms"],name]],
 "ref",{name}=data;pgLookup[kernel["verified"],name],
 "local",{name}=data;pgLookup[environment,name],
 "let",{name,left,right}=data;If[KeyExistsQ[environment,name],pgFail["duplicate local proof name"]];extended=Join[environment,<|name->pgInfer[kernel,left,environment]|>];pgInfer[kernel,right,extended],
 "imp_i",{assumption,body}=data;If[pgSort[assumption]=!="Prop",pgFail["invalid discharged assumption"]];result=pgInfer[kernel,body,environment];pgSequent[pgRemove[result["assumptions"],assumption],pgImp[assumption,result["conclusion"]]],
 "mp",{implication,antecedent}=pgInfer[kernel,#,environment]&/@data;If[First[implication["conclusion"]]=!="imp"||!pgSame[implication["conclusion"][[2]],antecedent["conclusion"]],pgFail["modus ponens antecedent mismatch"]];pgSequent[Union[implication["assumptions"],antecedent["assumptions"]],implication["conclusion"][[3]]],
 "and_i",{left,right}=pgInfer[kernel,#,environment]&/@data;pgSequent[Union[left["assumptions"],right["assumptions"]],pgAnd[left["conclusion"],right["conclusion"]]],
 "and_l"|"and_r",result=pgInfer[kernel,First[data],environment];If[First[result["conclusion"]]=!="and",pgFail["conjunction elimination on a non-conjunction"]];pgSequent[result["assumptions"],result["conclusion"][[If[rule==="and_l",2,3]]]],
 "or_l"|"or_r",{other,body}=data;If[pgSort[other]=!="Prop",pgFail["invalid disjunction"]];result=pgInfer[kernel,body,environment];conclusion=If[rule==="or_l",pgOr[result["conclusion"],other],pgOr[other,result["conclusion"]]];pgSequent[result["assumptions"],conclusion],
 "or_e",{choice,left,right}=pgInfer[kernel,#,environment]&/@data;If[First[choice["conclusion"]]=!="or"||!pgSame[left["conclusion"],right["conclusion"]],pgFail["disjunction cases mismatch"]];remaining=Union[pgRemove[left["assumptions"],choice["conclusion"][[2]]],pgRemove[right["assumptions"],choice["conclusion"][[3]]]];pgSequent[Union[choice["assumptions"],remaining],left["conclusion"]],
 "all_i",{variable,body}=data;If[First[variable]=!="v",pgFail["universal binder is not a variable"]];result=pgInfer[kernel,body,environment];If[AnyTrue[result["assumptions"],MemberQ[pgFree[#],variable]&],pgFail["universal eigenvariable is not fresh"]];pgSequent[result["assumptions"],pgAll[variable,result["conclusion"]]],
 "all_e",{body,replacement}=data;result=pgInfer[kernel,body,environment];If[First[result["conclusion"]]=!="all",pgFail["universal elimination on a non-universal"]];pgSequent[result["assumptions"],pgSubstitute[result["conclusion"][[3]],result["conclusion"][[2]],replacement]],
 "ex_i",{existential,witness,body}=data;If[pgSort[existential]=!="Prop"||First[existential]=!="ex",pgFail["existential introduction target mismatch"]];result=pgInfer[kernel,body,environment];instance=pgSubstitute[existential[[3]],existential[[2]],witness];If[!pgSame[instance,result["conclusion"]],pgFail["existential witness proves another formula"]];pgSequent[result["assumptions"],existential],
 "ex_e",{left,eigenvariable,right}=data;existential=pgInfer[kernel,left,environment];body=pgInfer[kernel,right,environment];If[First[existential["conclusion"]]=!="ex"||First[eigenvariable]=!="v",pgFail["invalid existential elimination"]];instance=pgSubstitute[existential["conclusion"][[3]],existential["conclusion"][[2]],eigenvariable];remaining=pgRemove[body["assumptions"],instance];protected=Union[existential["assumptions"],remaining,{body["conclusion"],existential["conclusion"]}];If[AnyTrue[protected,MemberQ[pgFree[#],eigenvariable]&],pgFail["existential eigenvariable escapes"]];pgSequent[Union[existential["assumptions"],remaining],body["conclusion"]],
 "eq_i",{body}=data;pgSort[body];pgSequent[{},pgEq[body,body]],
 "eq_e",{left,variable,pattern,right}=data;equality=pgInfer[kernel,left,environment];instance=pgInfer[kernel,right,environment];If[First[equality["conclusion"]]=!="eq"||pgSort[pattern]=!="Prop",pgFail["invalid equality elimination"]];{left,right}=Rest[equality["conclusion"]];If[!pgSame[pgSubstitute[pattern,variable,left],instance["conclusion"]],pgFail["equality replacement premise mismatch"]];pgSequent[Union[equality["assumptions"],instance["assumptions"]],pgSubstitute[pattern,variable,right]],
 "conversion",{target,body}=data;If[pgSort[target]=!="Prop",pgFail["conversion target is not a formula"]];result=pgInfer[kernel,body,environment];If[!pgSame[target,result["conclusion"]],pgFail["non-definitional conversion"]];pgSequent[result["assumptions"],target],
 "false_e",{target,body}=data;result=pgInfer[kernel,body,environment];If[result["conclusion"]=!=pgBottom||pgSort[target]=!="Prop",pgFail["false elimination lacks contradiction"]];pgSequent[result["assumptions"],target],
 "ring",{formula}=data;If[pgSort[formula]=!="Prop"||First[formula]=!="eq"||pgSort[formula[[2]]]=!="R"||!pgRingIdentity[formula[[2]],formula[[3]]],pgFail["invalid real polynomial identity"]];pgSequent[{},formula],
 "tautology",{formula}=data;If[pgSort[formula]=!="Prop"||!pgTautology[formula],pgFail["invalid propositional tautology"]];pgSequent[{},formula],
 "nat_induction",{variable,body,left,right}=data;If[First[variable]=!="v"||pgSort[variable]=!="N"||pgSort[body]=!="Prop",pgFail["invalid induction predicate"]];base=pgInfer[kernel,left,environment];step=pgInfer[kernel,right,environment];zero=pgC["zero_nat","N"];successor=pgA[pgC["successor",pgFT["N","N"]],variable];expectedStep=pgAll[variable,pgImp[body,pgSubstitute[body,variable,successor]]];If[!pgSame[base["conclusion"],pgSubstitute[body,variable,zero]]||!pgSame[step["conclusion"],expectedStep],pgFail["induction base or step mismatch"]];assumptions=Union[base["assumptions"],step["assumptions"]];If[AnyTrue[assumptions,MemberQ[pgFree[#],variable]&],pgFail["induction variable occurs in open assumptions"]];pgSequent[assumptions,pgAll[variable,body]],
 "list_induction",{variable,head,tail,body,left,right}=data;listSort=pgSort[variable];If[First[variable]=!="v"||!ListQ[listSort]||Length[listSort]!=2||First[listSort]=!="List"||pgSort[head]=!=listSort[[2]]||pgSort[tail]=!=listSort||First[head]=!="v"||First[tail]=!="v"||Length[DeleteDuplicates[{variable,head,tail}]]!=3||pgSort[body]=!="Prop",pgFail["invalid list induction variables"]];If[MemberQ[pgFree[body],head]||MemberQ[pgFree[body],tail],pgFail["list induction variables are not fresh"]];base=pgInfer[kernel,left,environment];step=pgInfer[kernel,right,environment];nil=pgC["list_nil",listSort];cons=pgA[pgC["list_cons",pgFT[listSort[[2]],pgFT[listSort,listSort]]],head,tail];expectedStep=pgAll[head,pgAll[tail,pgImp[pgSubstitute[body,variable,tail],pgSubstitute[body,variable,cons]]]];If[!pgSame[base["conclusion"],pgSubstitute[body,variable,nil]]||!pgSame[step["conclusion"],expectedStep],pgFail["list induction base or step mismatch"]];assumptions=Union[base["assumptions"],step["assumptions"]];If[AnyTrue[assumptions,Intersection[pgFree[#],{variable,head,tail}]=!={}&],pgFail["list induction variable occurs in open assumptions"]];pgSequent[assumptions,pgAll[variable,body]],
 _,pgFail[{"unrecognized proof rule",rule}]]];
SetAttributes[pgTheorem,HoldFirst];
pgTheorem[kernel_,name_,formula_,proof_]:=Module[{result},
 If[KeyExistsQ[kernel["verified"],name]||KeyExistsQ[kernel["axioms"],name],pgFail["duplicate theorem name"]];
 If[pgSort[formula]=!="Prop"||pgFree[formula]=!={},pgFail["theorem must be closed"]];
 result=pgInfer[kernel,proof];If[result["assumptions"]=!={}||!pgSame[result["conclusion"],formula],pgFail[{"theorem has open hypotheses or another conclusion",name,result}]];
 kernel=Join[kernel,<|"verified"->Join[kernel["verified"],<|name->pgSequent[{},formula]|>],"records"->Append[kernel["records"],{name,formula,proof}]|>];{"ref",name}];
pgInstantiate[proof_,terms___]:=Fold[{"all_e",#1,#2}&,proof,{terms}];
pgApply[proof_,premises___]:=Fold[{"mp",#1,#2}&,proof,{premises}];
pgClose[proof_,variables_:{},assumptions_:{}]:=Fold[{"all_i",#2,#1}&,Fold[{"imp_i",#2,#1}&,proof,Reverse[assumptions]],Reverse[variables]];
SetAttributes[pgRejects,HoldFirst];
pgRejects[expression_]:=TrueQ[Catch[expression;False,"ProbabilityKernelError",Function[{value,tag},True]]];
pgSelfTest[]:=Module[{x=pgV["x","R"],y=pgV["y","R"],p=pgC["P",pgFT["R","Prop"]],px,py,kernel,identity,checks},
 px=pgA[p,x];py=pgA[p,y];kernel=pgKernel[<||>];identity=pgClose[{"assume",px},{x},{px}];
 pgTheorem[kernel,"identity",pgAll[x,pgImp[px,px]],identity];
 checks=<|
 "identity_closed"->(pgInfer[kernel,{"ref","identity"}]["assumptions"]==={}),
 "open_hypothesis_rejected"->pgRejects[pgTheorem[kernel,"open",pgAll[x,px],{"all_i",x,{"assume",px}}]],
 "wrong_conclusion_rejected"->pgRejects[pgTheorem[kernel,"wrong",pgAll[x,pgImp[px,py]],identity]],
 "capturing_substitution_rejected"->pgRejects[pgSubstitute[pgAll[y,px],x,y]],
 "application_type_mismatch_rejected"->pgRejects[pgSort[pgA[p,pgC["zero_nat","N"]]]],
 "unknown_theorem_rejected"->pgRejects[pgInfer[kernel,{"ref","factorization"}]],
 "existential_escape_rejected"->pgRejects[pgInfer[kernel,{"ex_e",{"assume",pgEx[x,px]},y,{"assume",py}}]],
 "wrong_modus_ponens_rejected"->pgRejects[pgInfer[kernel,{"mp",{"assume",pgImp[px,px]},{"assume",py}}]],
 "non_tautology_rejected"->pgRejects[pgInfer[kernel,{"tautology",pgImp[px,py]}]],
 "alpha_conversion"->pgSame[pgAll[x,px],pgAll[y,py]],
 "beta_conversion"->pgSame[pgA[pgLam[x,px],y],py]|>;
 If[!And@@Values[checks],pgFail[checks]];checks];
pgRecord[kernel_,name_]:=Module[{records=Select[kernel["records"],First[#]===name&]},If[Length[records]!=1,pgFail[{"certificate record must be unique",name}]];First[records]];
pgProves[kernel_,formula_,proof_]:=Module[{result=pgInfer[kernel,proof]},If[pgSort[formula]=!="Prop"||pgFree[formula]=!={}||result["assumptions"]=!={}||!pgSame[result["conclusion"],formula],pgFail["certificate does not prove the closed expected formula"]];True];
pgCertified[kernel_,name_,expected_]:=Module[{record=pgRecord[kernel,name]},If[!pgSame[record[[2]],expected],pgFail[{"record differs from independently specified interface",name}]];pgProves[kernel,expected,record[[3]]]];
pgRemoveDischarge[proof_,assumption_]:=Module[{changed},If[!ListQ[proof],Return[{proof,0}]];If[Length[proof]>0&&First[proof]==="imp_i"&&pgSame[proof[[2]],assumption],Return[{proof[[3]],1}]];changed=pgRemoveDischarge[#,assumption]&/@proof;{First/@changed,Total[Last/@changed]}];
pgReplaceTerm[term_,old_,new_]:=If[pgSame[term,old],new,If[MemberQ[{"v","c","false"},First[term]],term,If[MemberQ[{"all","ex","lam"},First[term]],{First[term],term[[2]],pgReplaceTerm[term[[3]],old,new]},Prepend[pgReplaceTerm[#,old,new]&/@Rest[term],First[term]]]]];
pgFirstReplayFailure[kernel_,name_,replacement_]:=Module[{axioms=Join[kernel["axioms"],<|name->replacement|>],replay},replay=pgKernel[axioms];Catch[Do[If[pgRejects[pgTheorem[replay,record[[1]],record[[2]],record[[3]]]],Throw[record[[1]],"ProbabilityReplayStop"]],{record,kernel["records"]}];Null,"ProbabilityReplayStop"]];
pgProbabilitySelfTest[kernel_]:=Module[{checks=<||>,record,formula,independence,l2,mutated,wrongProduct,mct,bound,originalBound,wrongBound,original,head,tail,changedIntegral,xs,h,t,nil,cons,body,base,step,induction,wrongStep,x,y,zero=pgC["zero_real","R"],one=pgC["one_real","R"],add,mul,sub,div,expectation,ef,eg},
 add[a_,b_]:=pgA[pgC["real_add",pgFT["R",pgFT["R","R"]]],a,b];mul[a_,b_]:=pgA[pgC["real_mul",pgFT["R",pgFT["R","R"]]],a,b];sub[a_,b_]:=pgA[pgC["real_sub",pgFT["R",pgFT["R","R"]]],a,b];div[a_,b_]:=pgA[pgC["real_div",pgFT["R",pgFT["R","R"]]],a,b];
 record=pgRecord[kernel,"independent_l2_product_integral"];formula=record[[2]];independence=formula[[3,3,3,3,2]];l2=formula[[3,3,2]];
 mutated=pgRemoveDischarge[record[[3]],independence];AssociateTo[checks,"independence_hypothesis_removal_rejected"->(mutated[[2]]===1&&pgRejects[pgProves[kernel,formula,mutated[[1]]]])];
 mutated=pgRemoveDischarge[record[[3]],l2];AssociateTo[checks,"l2_hypothesis_removal_rejected"->(mutated[[2]]===1&&pgRejects[pgProves[kernel,formula,mutated[[1]]]])];
 expectation=pgC["expectation",pgFT[pgFT["Omega","R"],"R"]];ef=pgA[expectation,formula[[2]]];eg=pgA[expectation,formula[[3,2]]];wrongProduct=pgReplaceTerm[formula,mul[ef,eg],add[ef,eg]];
 AssociateTo[checks,"expectation_product_changed_to_sum_rejected"->(!pgSame[formula,wrongProduct]&&pgRejects[pgProves[kernel,wrongProduct,record[[3]]]])];
 mct=pgRecord[kernel,"monotone_simple_approximation_integral_bound"];bound=mct[[2,3,3,2]];originalBound=Nest[#[[3]]&,mct[[2]],7];wrongBound=pgReplaceTerm[mct[[2]],originalBound,pgSubstitute[originalBound,bound,sub[bound,one]]];
 AssociateTo[checks,"mct_bound_decreased_by_one_rejected"->(!pgSame[mct[[2]],wrongBound]&&pgRejects[pgProves[kernel,wrongBound,mct[[3]]]])];
 AssociateTo[checks,"countable_additivity_cannot_be_accepted_by_name"->(pgFirstReplayFailure[kernel,"measure_countable_additivity_partial_unions",pgEq[zero,zero]]==="measure_union_lub_of_finite_unions")];
 original=kernel["axioms"]["simple_integral_cons"];head=original[[2]];tail=original[[3,2]];
 changedIntegral=pgReplaceTerm[original,original[[3,3,3,2,3]],add[original[[3,3,3,2,3,2,3]],original[[3,3,3,2,3,3]]]];
 AssociateTo[checks,"simple_integral_coefficient_mutation_rejected"->(pgFirstReplayFailure[kernel,"simple_integral_cons",changedIntegral]==="simple_integral_is_unrestricted_weighted_sum")];
 xs=pgV["induction_list",{"List","R"}];h=pgV["induction_head","R"];t=pgV["induction_tail",{"List","R"}];nil=pgC["list_nil",{"List","R"}];cons=pgA[pgC["list_cons",pgFT["R",pgFT[{"List","R"},{"List","R"}]]],h,t];body=pgEq[xs,xs];base={"eq_i",nil};step=pgClose[{"eq_i",cons},{h,t},{pgEq[t,t]}];induction={"list_induction",xs,h,t,body,base,step};
 AssociateTo[checks,"list_induction_actual_recurrence_accepted"->pgProves[pgKernel[<||>],pgAll[xs,body],induction]];
 AssociateTo[checks,"list_induction_wrong_base_rejected"->pgRejects[pgInfer[pgKernel[<||>],{"list_induction",xs,h,t,body,{"eq_i",zero},step}]]];
 wrongStep=pgClose[{"eq_i",t},{h,t},{pgEq[t,t]}];AssociateTo[checks,"list_induction_wrong_step_rejected"->pgRejects[pgInfer[pgKernel[<||>],{"list_induction",xs,h,t,body,base,wrongStep}]]];
 AssociateTo[checks,"list_induction_nonfresh_head_rejected"->pgRejects[pgInfer[pgKernel[<||>],{"list_induction",xs,h,t,pgAnd[body,pgEq[h,h]],base,step}]]];
 x=pgV["polynomial_x","R"];y=pgV["polynomial_y","R"];
 AssociateTo[checks,"ring_identity_accepted"->pgProves[pgKernel[<||>],pgAll[x,pgAll[y,pgEq[mul[add[x,y],sub[x,y]],sub[mul[x,x],mul[y,y]]]]],pgClose[{"ring",pgEq[mul[add[x,y],sub[x,y]],sub[mul[x,x],mul[y,y]]]},{x,y}]]];
 AssociateTo[checks,"ring_wrong_sign_rejected"->pgRejects[pgInfer[pgKernel[<||>],{"ring",pgEq[add[x,y],sub[x,y]]}]]];
 AssociateTo[checks,"division_cancellation_without_nonzero_rejected"->pgRejects[pgInfer[pgKernel[<||>],{"ring",pgEq[div[x,x],one]}]]];
 If[!And@@Values[checks],pgFail[checks]];checks];
pgChecks=<||>;
check[name_,condition_]:=If[KeyExistsQ[pgChecks,name]||!TrueQ[condition],pgFail[name],AssociateTo[pgChecks,name->True]];
pgProbabilityVerification[]:=Module[{kernel=pgProbabilityKernel[],interfaces=pgCertificateData["interfaces"]},
 check["signed_integral_add",pgCertified[kernel,"signed_integral_add",interfaces["signed_integral_add"]]];
 check["signed_integral_scale",pgCertified[kernel,"signed_integral_scale",interfaces["signed_integral_scale"]]];
 check["signed_integral_unique",pgCertified[kernel,"signed_integral_unique",interfaces["signed_integral_unique"]]];
 check["expectation_of_signed_integral",pgCertified[kernel,"expectation_of_signed_integral",interfaces["expectation_of_signed_integral"]]];
 check["l2_implies_integrable",pgCertified[kernel,"l2_implies_integrable",interfaces["l2_implies_integrable"]]];
 check["l2_square_signed_integral",pgCertified[kernel,"l2_square_signed_integral",interfaces["l2_square_signed_integral"]]];
 check["independent_l2_product_integral",pgCertified[kernel,"independent_l2_product_integral",interfaces["independent_l2_product_integral"]]];
