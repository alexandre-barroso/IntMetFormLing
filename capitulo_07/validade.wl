results={};
check[id_,condition_] := If[TrueQ[condition],AppendTo[results,<|"id"->id,"passed"->True|>],Print[id];Exit[1]];
loss=yy-2b xy+b^2 xx+n(my-a-b mx)^2;
minimum=yy-xy^2/xx;
excess=xx(b-xy/xx)^2+n(my-a-b mx)^2;
check["general_completed_square",Together[loss-minimum-excess]==0];
check["general_excess_nonnegative",FullSimplify[excess>=0,xx>0&&n>0&&Element[{xy,yy,mx,my,a,b},Reals]]];
hess={{D[loss,{a,2}],D[loss,a,b]},{D[loss,b,a],D[loss,{b,2}]}};
check["general_hessian_positive_definite",FullSimplify[hess[[1,1]]>0&&Det[hess]>0,n>0&&xx>0]];
solution=Solve[{D[loss,a]==0,D[loss,b]==0},{a,b}];
check["general_critical_unique",Length[solution]==1&&(Together /@ ({a-(my-mx xy/xx),b-xy/xx}/.First[solution]))=={0,0}];
check["general_critical_loss",Together[(loss/.{a->my-mx xy/xx,b->xy/xx})-minimum]==0];
xs=Array[x,6];ys=Array[y,6];xb=Mean[xs];yb=Mean[ys];
sxx=Total[(xs-xb)^2];sxy=Total[(xs-xb)(ys-yb)];syy=Total[(ys-yb)^2];
check["source_size_centered_loss_identity",Expand[Total[(ys-a-b xs)^2]-(syy-2b sxy+b^2 sxx+6(yb-a-b xb)^2)]==0];
fit[x_List,y_List] := Module[{mx,my,sxx,sxy,beta},If[Length[x]==0||Length[x]!=Length[y],Return[$Failed]];mx=Mean[x];my=Mean[y];sxx=Total[(x-mx)^2];If[!TrueQ[sxx>0],Return[$Failed]];sxy=Total[(x-mx)(y-my)];beta=sxy/sxx;{my-beta mx,beta}];
check["source_group_coefficients",fit[{0,0,0,1,1,1},{233,204,242,130,112,142}]=={679/3,-295/3}];
check["source_age_coefficients",fit[{14,23,35,48,52,67},{252,244,240,233,212,204}]=={3087671/11561,-10519/11561}];
check["reject_empty_pairs",fit[{},{}]===$Failed];
check["reject_mismatched_pairs",fit[{0,0,0,1,1,1},{233,204,242}]===$Failed];
check["reject_constant_covariate",fit[{0,0,0},{233,204,242}]===$Failed];
sl=Total[({233,204,242,130,112,142}-a-b {0,0,0,1,1,1})^2];
se=3(a-679/3)^2+3(a+b-128)^2;
check["source_completed_square",Expand[sl-3734/3-se]==0];
check["source_unique_zero_squares",Reduce[se==0,{a,b},Reals]==(a==679/3&&b==-295/3)];
check["source_excess_nonnegative",FullSimplify[se>=0,Element[{a,b},Reals]]];
sigma=DiagonalMatrix[{vu,vv,ve,vw,vf}];
check["distribution_free_shared_covariance",({1,1,1,0,0}.sigma.{1,0,0,1,1})==vu];
check["distribution_free_mean_variance",FullSimplify[Sum[KroneckerDelta[i,j]variance,{i,1,ni},{j,1,ni}]/ni^2==variance/ni,ni>=1&&Element[ni,Integers]]];
check["variance_scaling",Expand[(c centered)^2-c^2 centered^2]==0];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];Exit[0];
