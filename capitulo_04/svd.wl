ClearAll["Global`*"];
results={};
check[name_,condition_]:=If[TrueQ[condition],AppendTo[results,<|"id"->name,"passed"->True|>],Print[<|"failed"->name,"value"->condition|>];Exit[1]];
rows={"100100000","101000000","110000000","011010000","011200000","010010000","010010000","001100000","010000001","000001110","000000111","000000011"};
m=Map[FromDigits,Map[Characters,rows],{2}];
g=Transpose[m].m;
p=x^9-31x^8+374x^7-2286x^6+7697x^5-14557x^4+15014x^3-7755x^2+1732x-124;
check["svd_source_gram_and_characteristic",g==Transpose[g]&&Expand[Det[x IdentityMatrix[9]-g]-p]==0];
published={334,254,235,164,150,131,85,56,36}/100;
intervals=Sort[{(#-1/200)^2,(#+1/200)^2}&/@published];
check["svd_nine_distinct_positive_roots",Exponent[p,x]==9&&Exponent[PolynomialGCD[p,D[p,x]],x]==0&&And@@(#[[1]]>0&&(p/.x->#[[1]])*(p/.x->#[[2]])<0&&CountRoots[p,{x,#[[1]],#[[2]]}]==1&/@intervals)&&And@@Table[intervals[[i,2]]<intervals[[i+1,1]],{i,8}]&&CountRoots[p,{x,-Infinity,Infinity}]==9];
rootFunction=Function[z,Evaluate[p/.x->z]];
eigenvalues=Table[Root[rootFunction,i],{i,9}];
coefficients=Reverse[CoefficientList[p,x]];
blocks=FoldList[g.#1+#2 IdentityMatrix[9]&,IdentityMatrix[9],coefficients[[2;;9]]];
adjugate=Sum[blocks[[k+1]] x^(8-k),{k,0,8}];
check["svd_polynomial_adjugate",Map[Expand,(x IdentityMatrix[9]-g).adjugate-p IdentityMatrix[9],{2}]==ConstantArray[0,{9,9}]];
w=adjugate[[All,1]];
e0=UnitVector[9,1];
check["svd_polynomial_eigenvectors",Expand[g.w-x w+p e0]==ConstantArray[0,9]];
{gcd,{bezoutP,bezoutW}}=PolynomialExtendedGCD[p,w[[1]],x];
check["svd_eigenvector_never_zero",gcd==1&&Expand[bezoutP p+bezoutW w[[1]]]==1];
normSquared=Expand[w.w];
check["svd_norm_is_sum_of_squares",normSquared==Expand[Total[#^2&/@w]]];
coordinates=Table[Symbol["coordinate"<>ToString[k]],{k,9}];
check["svd_norm_positive_from_nonzero_coordinate",FullSimplify[a^2>0&&b^2>=0,Element[{a,b},Reals]&&a!=0]&&FullSimplify[Total[coordinates]>0,And@@(#>=0&/@coordinates)&&coordinates[[1]]>0]];
wy=w/.x->y;
inner=Expand[w.wy];
check["svd_distinct_roots_orthogonal",Expand[(x-y)inner-p wy[[1]]+(p/.x->y)w[[1]]]==0];
check["svd_normalization_scalar_identities",FullSimplify[a/Sqrt[a]^2==1&&0/(Sqrt[a]Sqrt[b])==0&&Sqrt[a]>0,a>0&&b>0]];
check["svd_gram_norm_eigenvalue",PolynomialRemainder[w.g.w-x normSquared,p,x]==0];
{gcdNorm,{normInverse,unused}}=PolynomialExtendedGCD[normSquared,p,x];
check["svd_norm_denominator_nonzero",gcdNorm==1&&PolynomialRemainder[normInverse normSquared,p,x]==1];
projector=Map[PolynomialRemainder[# normInverse,p,x]&,Outer[Times,w,w],{2}];
check["svd_projector_reduction",And@@Flatten[Map[PolynomialRemainder[#,p,x]==0&,projector normSquared-Outer[Times,w,w],{2}]]];
rootPowers=Table[RootSum[rootFunction,Function[z,Evaluate[z^k]]],{k,0,8}];
check["svd_exact_root_power_sums",rootPowers[[1]]==9&&And@@Table[rootPowers[[k+1]]+Sum[coefficients[[i+1]]rootPowers[[k-i+1]],{i,1,k-1}]+k coefficients[[k+1]]==0,{k,1,8}]];
rootSum[expression_]:=If[Exponent[expression,x]>8,$Failed,Sum[Coefficient[expression,x,k]rootPowers[[k+1]],{k,0,8}]];
projectorSum=Map[rootSum,projector,{2}];
check["svd_exact_right_completeness",projectorSum==IdentityMatrix[9]];
scaledLeft=m.w;
check["svd_exact_left_unit_columns",PolynomialRemainder[scaledLeft.scaledLeft-x normSquared,p,x]==0&&FullSimplify[(a b)/(Sqrt[a]Sqrt[b])^2==1,a>0&&b>0]];
check["svd_exact_left_cross_columns",Expand[w.g.wy-y inner+(p/.x->y)w[[1]]]==0];
reconstruction=Map[PolynomialRemainder[# normInverse,p,x]&,Outer[Times,scaledLeft,w],{2}];
reconstructed=Map[rootSum,reconstruction,{2}];
check["svd_exact_source_reconstruction",reconstructed==m];
check["svd_reconstruction_scalar_cancellation",FullSimplify[(c/(Sqrt[a]Sqrt[b]))Sqrt[a]/Sqrt[b]==c/b,a>0&&b>0&&Element[c,Reals]]];
v=Transpose[(w/.x->#)/Sqrt[normSquared/.x->#]&/@eigenvalues];
sigma=DiagonalMatrix[Sqrt/@eigenvalues];
u=Transpose[(scaledLeft/.x->#)/(Sqrt[#]Sqrt[normSquared/.x->#])&/@eigenvalues];
check["svd_exact_factor_dimensions",Dimensions[m]=={12,9}&&Dimensions[u]=={12,9}&&Dimensions[sigma]=={9,9}&&Dimensions[v]=={9,9}];
check["svd_wrong_source_reconstruction_rejected",reconstructed!=m+ConstantArray[1,{12,9}]];
check["svd_wrong_projector_normalization_rejected",2projectorSum!=IdentityMatrix[9]];
check["svd_wrong_eigenvalue_rejected",!And@@(PolynomialRemainder[#,p,x]===0&/@(g.w-(x+1)w))];
Print[ExportString[<|"backend"->"Wolfram","checks"->Length[results],"passed"->True,"scope"->"Exact thin SVD of the published 12 by 9 integer matrix. Nine distinct positive real algebraic roots of its characteristic polynomial, polynomial eigenvectors, Bezout nonvanishing, positive normalization, pairwise orthogonality and exact RootSum projectors give U^T U=I, V^T V=I, V V^T=I and U Sigma V^T=M. No rounded factor is assumed orthogonal.","results"->results|>,"RawJSON"]];
Exit[0];
