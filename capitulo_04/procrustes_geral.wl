If[!ValueQ[GeneralProcrustes`$LibraryMode],GeneralProcrustes`$LibraryMode=False];
pDirectory=DirectoryName[$InputFileName];
SVDProof`$LibraryMode=True;
Block[{$ContextPath={"System`"}},Get[FileNameJoin[{pDirectory,"svd_geral.wl"}]]];
