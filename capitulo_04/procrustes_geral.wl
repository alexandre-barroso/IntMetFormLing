pConditionalCertificate[]:=Module[{required,ids,emptyRows,emptyColumns,assumptions},
 If[!TrueQ[ProcrustesProof`report["passed"]]||!And@@Lookup[ProcrustesProof`results,"passed"],pFail["conditional certificate failed"]];
 required={"one_sided_determinant_nonzero","opposite_product_from_inverse","loss_trace_expansion","svd_rotated_trace","weighted_gap_induction","weighted_gap_nonnegative_induction","candidate_orthogonal","candidate_attains_trace","actual_cross_matrix_binding","actual_conditional_loss_gap","conditional_loss_nonnegative","square_root_preserves_order"};ids=Lookup[ProcrustesProof`results,"id"];
