pSolution[rows_,columns_,left_,right_,optimizer_]:=Module[{competitor=SVDProof`gV["orthogonal_competitor","M"],domain,orthogonality,bound},domain=SVDProof`gA[SVDProof`gSquare,columns,competitor];orthogonality=SVDProof`gEq[SVDProof`gMM[columns,SVDProof`gTr[competitor],competitor],SVDProof`gA[SVDProof`gIdentity,columns]];bound=SVDProof`gA[SVDProof`gLe,SVDProof`gA[pFrobenius,rows,columns,left,right,optimizer],SVDProof`gA[pFrobenius,rows,columns,left,right,competitor]];SVDProof`gAnd[SVDProof`gOrtho[columns,optimizer],SVDProof`gGeneral[{competitor},{domain,orthogonality},bound]]];
