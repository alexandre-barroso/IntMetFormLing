 GeneralProcrustes`check["cross_product_shape_all_dimensions",TensorDimensions[Transpose[left].right,Assumptions->assumptions]==={columns,columns}&&pTypedShapes[]["cross"]==={columns,columns}];
 GeneralProcrustes`check["alignment_product_shape_all_dimensions",TensorDimensions[left.candidate-right,Assumptions->assumptions]==={rows,columns}&&pTypedShapes[]["error"]==={rows,columns}];
 GeneralProcrustes`check["empty_dimensions_cross_and_error_shapes",pTypedShapes[]["zero_rows_cross"]==={columns,columns}&&pTypedShapes[]["zero_columns_cross"]==={0,0}&&pTypedShapes[]["zero_columns_error"]==={rows,0}&&Sum[leftEntry[k,i]rightEntry[k,j],{k,1,0}]===0&&Resolve[!Exists[index,0<=index<0],Integers]];
 GeneralProcrustes`check["empty_row_frobenius_sum",emptyRows===0&&Sqrt[emptyRows]===0];
 GeneralProcrustes`check["empty_column_frobenius_sum",emptyColumns===0&&Sqrt[emptyColumns]===0];
 GeneralProcrustes`check["empty_objective_every_candidate_minimizes",Sqrt[emptyRows]<=Sqrt[emptyColumns]];
 GeneralProcrustes`check["positive_dimensions_use_complete_conditional_certificate",SubsetQ[ids,required]];
 GeneralProcrustes`check["conditional_cross_product_is_exact",ProcrustesProof`traceNormal[ProcrustesProof`parameterizedLoss/.ProcrustesProof`cross->Transpose[ProcrustesProof`aa].ProcrustesProof`bb,ProcrustesProof`orthogonal]===ProcrustesProof`traceNormal[ProcrustesProof`traceLoss,ProcrustesProof`orthogonal]];
