pExpected[]:=Module[{rows=SVDProof`gV["n_rows","N"],columns=SVDProof`gV["n_columns","N"],left=SVDProof`gV["data_a","M"],right=SVDProof`gV["data_b","M"],q=SVDProof`gV["optimizer","M"]},SVDProof`gGeneral[{rows,columns,left,right},{SVDProof`gA[pRectangular,rows,columns,left],SVDProof`gA[pRectangular,rows,columns,right]},SVDProof`gEx[q,pSolution[rows,columns,left,right,q]]]];
