pFail[value_]:=Throw[value,"GeneralProcrustesFailure"];
GeneralProcrustes`check[name_,condition_]:=If[TrueQ[condition],AppendTo[pResults,<|"id"->name,"passed"->True|>],pFail[{"failed_check",name}]];
