results={};
check[id_,condition_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
assumptions=Element[{m,n},Integers]&&m>0&&n>0&&Element[u,Matrices[{m,2},Reals]]&&Element[v,Matrices[{n,2},Reals]]&&Element[sigma,Matrices[{2,2},Reals]]&&Element[inverse,Matrices[{2,2},Reals]]&&Element[x,Matrices[{n,1},Reals]]&&Element[c,Matrices[{2,1},Reals]];
relations={HoldPattern[Dot[left___,{{1,0},{0,1}},right___]]:>Dot[left,right],HoldPattern[Dot[left___,Transpose[u,{2,1}],u,right___]]:>Dot[left,IdentityMatrix[2],right],HoldPattern[Dot[left___,Transpose[v,{2,1}],v,right___]]:>Dot[left,IdentityMatrix[2],right],HoldPattern[Dot[left___,sigma,inverse,right___]]:>Dot[left,IdentityMatrix[2],right],HoldPattern[Dot[left___,inverse,sigma,right___]]:>Dot[left,IdentityMatrix[2],right]};
reduceRelations[expression_]:=FixedPoint[TensorReduce[#/.relations,Assumptions->assumptions]&,TensorReduce[expression,Assumptions->assumptions]];
diagonal=DiagonalMatrix[{s1,s2}];
diagonalInverse=DiagonalMatrix[{1/s1,1/s2}];
reconstruction=u.sigma.Transpose[v];
coordinateMap=sigma.Transpose[v].x;
preimage=v.inverse.c;
check["positive_diagonal_inverse",FullSimplify[diagonal.diagonalInverse==IdentityMatrix[2]&&diagonalInverse.diagonal==IdentityMatrix[2]&&Det[diagonal]>0,s1>0&&s2>0]];
check["rank_image_contained_in_two_columns",MemberQ[{0,SymbolicZerosArray[{m,1}]},TensorReduce[reconstruction.x-u.coordinateMap,Assumptions->assumptions]]];
check["rank_every_two_coordinate_image_attained",MemberQ[{0,SymbolicZerosArray[{m,1}]},TensorReduce[reduceRelations[reconstruction.preimage]-u.c,Assumptions->assumptions]]];
check["rank_two_coordinate_uniqueness",MemberQ[{0,SymbolicZerosArray[{2,1}]},TensorReduce[reduceRelations[Transpose[u].u.c]-c,Assumptions->assumptions]]];
check["rank_column_coefficients_unique",FullSimplify[Equivalent[s1*a==0&&s2*b==0,a==0&&b==0]&&Equivalent[a-first==0&&b-second==0,a==first&&b==second],s1>0&&s2>0&&Element[{a,b,first,second},Reals]]];
check["rank_coordinate_space_dimension",MatrixRank[IdentityMatrix[2]]==2&&MatrixRank[diagonal]==2];
check["rank_zero_column_counterexample",MatrixRank[ConstantArray[0,{2,2}]]!=2];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
