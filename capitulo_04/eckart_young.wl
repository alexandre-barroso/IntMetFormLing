atom[name_,rows_,columns_]:=matrixPoly[rows,columns,{{1,{{name,rows,columns}}}}];
identity[size_]:=matrixPoly[size,size,{{1,{}}}];
zero[rows_,columns_]:=matrixPoly[rows,columns,{}];
collectTerms[terms_]:=Module[{groups=GatherBy[terms,Last],combined},combined=({Together[Total[#[[All,1]]]],#[[1,2]]}&/@groups);SortBy[Select[combined,!TrueQ[First[#]==0]&],ToString[Last[#],InputForm]&]];
add[matrices__]:=Module[{items={matrices},shape},shape=Take[First[items],2];If[!AllTrue[items,Take[#,2]===shape&],Throw["dimension","matrix"]];matrixPoly[shape[[1]],shape[[2]],collectTerms[Join@@(#[[3]]&/@items)]]];
scale[scalar_,matrix_]:=matrixPoly[matrix[[1]],matrix[[2]],collectTerms[({scalar*#[[1]],#[[2]]}&/@matrix[[3]])]];
neg[matrix_]:=scale[-1,matrix];
subtract[first_,second_]:=add[first,neg[second]];
multiply[first_,second_]:=Module[{terms},If[first[[2]]=!=second[[1]],Throw["dimension","matrix"]];terms=Flatten[Table[{a[[1]]*b[[1]],Join[a[[2]],b[[2]]]},{a,first[[3]]},{b,second[[3]]}],1];matrixPoly[first[[1]],second[[2]],collectTerms[terms]]];
product[matrices__]:=Fold[multiply,First[{matrices}],Rest[{matrices}]];
transposeName[name_]:=If[StringStartsQ[name,"T:"],StringDrop[name,2],"T:"<>name];
transpose[matrix_]:=matrixPoly[matrix[[2]],matrix[[1]],collectTerms[({#[[1]],({transposeName[#[[1]]],#[[3]],#[[2]]}&/@Reverse[#[[2]]])}&/@matrix[[3]])]];
word[matrix_]:=If[Length[matrix[[3]]]==1&&TrueQ[matrix[[3,1,1]]==1],matrix[[3,1,2]],Throw["monomial","matrix"]];
relation[left_,right_]:=If[Take[left,2]===Take[right,2],{word[left],right},Throw["relation_dimension","matrix"]];
reduceWord[original_,relations_]:=Catch[Module[{current=original,coefficient=1,changed=True,pattern,replacement,index},While[changed,changed=False;Do[pattern=rule[[1]];replacement=rule[[2]];If[Length[replacement[[3]]]!=1,Throw[False,"proof"]];Do[If[Take[current,{index,index+Length[pattern]-1}]===pattern,current=Join[Take[current,index-1],replacement[[3,1,2]],Drop[current,index+Length[pattern]-1]];coefficient*=replacement[[3,1,1]];changed=True;Break[]],{index,1,Length[current]-Length[pattern]+1}];If[changed,Break[]],{rule,relations}]];{coefficient,current}],"proof"];
reduceMatrix[matrix_,relations_]:=Module[{terms},terms=({#[[1]]*reduceWord[#[[2]],relations][[1]],reduceWord[#[[2]],relations][[2]]}&/@matrix[[3]]);matrixPoly[matrix[[1]],matrix[[2]],collectTerms[terms]]];
matrixEqual[left_,right_,relations_]:=reduceMatrix[subtract[left,right],relations][[3]]==={};
traceWord[original_,relations_,dimension_]:=Module[{choices,rotated,reduced,rows,key},If[original==={},Return[dimension]];choices=Table[rotated=RotateLeft[original,cut];rows=rotated[[1,2]];reduced=reduceWord[rotated,relations];If[reduced[[2]]==={}, {0,"",reduced[[1]]*rows},key=ToString[reduced[[2]],InputForm];{Length[reduced[[2]]],key,reduced[[1]]*formalTrace[reduced[[2]]]}],{cut,0,Length[original]-1}];SortBy[choices,Take[#,2]&][[1,3]]];
traceNormal[matrix_,relations_]:=Module[{reduced=reduceMatrix[matrix,relations]},If[matrix[[1]]=!=matrix[[2]],Throw["trace_dimension","matrix"]];Expand[Total[(#[[1]]*traceWord[#[[2]],relations,matrix[[1]]]&/@reduced[[3]])]]];
traceEqual[left_,right_,relations_]:=TrueQ[Expand[traceNormal[left,relations]-traceNormal[right,relations]]==0];
