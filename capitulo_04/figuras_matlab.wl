ClearAll["Global`*"];
results = {};
check[id_,condition_] := AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
profiles={{442,8,2},{5,1683,1670},{5,3982,3325}};
norms=Sqrt[Total[#^2]]& /@ profiles;
units=MapThread[#1/#2&,{profiles,norms}];
check["F04_all_norms_positive",And@@Thread[norms>0]];
check["F04_all_units",And@@(FullSimplify[#.#==1]& /@ units)];
c1=FullSimplify[units[[1]].units[[3]]];c2=FullSimplify[units[[2]].units[[3]]];
check["F04_exact_cosseno_cherry",FullSimplify[c1==40716/Sqrt[195432*26911974]]];
check["F04_exact_cosseno_digital",FullSimplify[c2==12254481/Sqrt[5621414*26911974]]];
check["F04_cossenos_rounding",FullSimplify[175/10000<c1<185/10000&&9955/10000<c2<9965/10000]];
check["F04_directions_preserved",FullSimplify[MapThread[#1 #2&,{units,norms}]==profiles]];
own={{40,853/10,32/10},{167/10,734/10,8},{52/10,93/10,484/10}};
use={{821/10,448/10,33/10},{695/10,519/10,101/10},{7,47/10,536/10}};
tensor=Table[{own,use}[[j,i,k]],{i,3},{j,2},{k,3}];
matrix=Table[tensor[[i,Mod[c-1,2]+1,Quotient[c-1,2]+1]],{i,3},{c,6}];
check["F05_column_bijection",Sort[Flatten[Table[2(k-1)+j,{j,2},{k,3}]]]==Range[6]];
check["F05_all_18_entries",And@@Flatten[Table[matrix[[i,2(k-1)+j]]==tensor[[i,j,k]],{i,3},{j,2},{k,3}]]];
check["F05_full_matrix",matrix=={{40,821/10,853/10,448/10,32/10,33/10},{167/10,695/10,734/10,519/10,8,101/10},{52/10,7,93/10,47/10,484/10,536/10}}];
check["F05_highlighted_entry",tensor[[3,2,3]]==matrix[[3,6]]==536/10];
check["F05_workshop_entry",tensor[[1,2,2]]==matrix[[1,4]]==448/10];
projection={{Cos[a],-Sin[a],0},{Sin[a] Sin[e],Cos[a] Sin[e],Cos[e]}};
check["F05_orthographic_projection",FullSimplify[projection.Transpose[projection]==IdentityMatrix[2],Element[{a,e},Reals]]];
report=<|"backend"->"Wolfram Language","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
