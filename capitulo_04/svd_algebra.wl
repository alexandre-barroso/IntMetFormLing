BeginPackage["SVDAlgebra`"];
results={};
check[id_,condition_,conditions_:{}]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[condition],"conditions"->conditions|>];
atom[name_,rows_,columns_]:=matrixPoly[rows,columns,{{1,{{name,rows,columns}}}}];
identity[size_]:=If[TrueQ[size==0],matrixPoly[0,0,{}],matrixPoly[size,size,{{1,{}}}]];
zero[rows_,columns_]:=matrixPoly[rows,columns,{}];
collectTerms[terms_]:=Module[{groups=GatherBy[terms,Last],combined},combined=({Together[Total[#[[All,1]]]],#[[1,2]]}&/@groups);SortBy[Select[combined,!TrueQ[First[#]==0]&],ToString[Last[#],InputForm]&]];
add[matrices__]:=Module[{items={matrices},shape},shape=Take[First[items],2];If[!AllTrue[items,Take[#,2]===shape&],Throw["dimension","matrix"]];matrixPoly[shape[[1]],shape[[2]],collectTerms[Join@@(#[[3]]&/@items)]]];
scale[scalar_,matrix_]:=matrixPoly[matrix[[1]],matrix[[2]],collectTerms[({scalar*#[[1]],#[[2]]}&/@matrix[[3]])]];
neg[matrix_]:=scale[-1,matrix];
subtract[first_,second_]:=add[first,neg[second]];
multiply[first_,second_]:=Module[{terms},If[first[[2]]=!=second[[1]],Throw["dimension","matrix"]];terms=Flatten[Table[{a[[1]]*b[[1]],Join[a[[2]],b[[2]]]},{a,first[[3]]},{b,second[[3]]}],1];matrixPoly[first[[1]],second[[2]],collectTerms[terms]]];
product[matrices__]:=Fold[multiply,First[{matrices}],Rest[{matrices}]];
transposeName[name_]:=If[StringStartsQ[name,"T:"],StringDrop[name,2],"T:"<>name];
transpose[matrix_]:=matrixPoly[matrix[[2]],matrix[[1]],collectTerms[({#[[1]],({transposeName[#[[1]]],#[[3]],#[[2]]}&/@Reverse[#[[2]]])}&/@matrix[[3]])]];
word[matrix_]:=If[Length[matrix[[3]]]==1&&TrueQ[matrix[[3,1,1]]==1],matrix[[3,1,2]],Throw["monomial","matrix"]];
relation[left_,right_]:=If[Take[left,2]===Take[right,2],{word[left],right},Throw["relation_dimension","matrix"]];
reduceWord[original_,relations_]:=Catch[Module[{current=original,coefficient=1,changed=True,pattern,replacement,index},While[changed,changed=False;Do[pattern=rule[[1]];replacement=rule[[2]];Do[If[Take[current,{index,index+Length[pattern]-1}]===pattern,If[replacement[[3]]==={},Throw[{0,{}},"proof"]];If[Length[replacement[[3]]]!=1,Throw[False,"proof"]];current=Join[Take[current,index-1],replacement[[3,1,2]],Drop[current,index+Length[pattern]-1]];coefficient*=replacement[[3,1,1]];changed=True;Break[]],{index,1,Length[current]-Length[pattern]+1}];If[changed,Break[]],{rule,relations}]];{coefficient,current}],"proof"];
reduceMatrix[matrix_,relations_]:=Module[{terms},terms=({#[[1]]*reduceWord[#[[2]],relations][[1]],reduceWord[#[[2]],relations][[2]]}&/@matrix[[3]]);matrixPoly[matrix[[1]],matrix[[2]],collectTerms[terms]]];
matrixEqual[left_,right_,relations_]:=reduceMatrix[subtract[left,right],relations][[3]]==={};
finiteSum[nil,index_,body_]:=0;
finiteSum[cons[first_,rest_],index_,body_]:=(body/.index->first)+finiteSum[rest,index,body];
base=finiteSum[nil,slot,coordinate[slot]^2];step=finiteSum[cons[head,tail],slot,coordinate[slot]^2];
check["sum_squares_nonnegative_induction",base==0&&step==coordinate[head]^2+finiteSum[tail,slot,coordinate[slot]^2]&&FullSimplify[x^2+rest>=0,Element[{x,rest},Reals]&&rest>=0],{"finite real coordinate list","induction hypothesis: tail square sum nonnegative"}];
check["sum_squares_zero_iff_all_zero_induction",base==0&&Resolve[ForAll[{x,rest},rest>=0,Equivalent[x^2+rest==0,x==0&&rest==0]],Reals],{"finite real coordinates","tail square sum nonnegative","head square plus tail sum zero","induction hypothesis: zero tail sum implies all tail coordinates zero"}];
check["reject_zero_sum_without_nonnegative_tail",1^2+(-1)==0&&1!=0,{"negative control: removing tail nonnegativity invalidates implication"}];
check["nonzero_vector_has_positive_squared_norm",Resolve[ForAll[hreal,Equivalent[hreal>=0&&hreal!=0,hreal>0]],Reals],{"sum-of-squares lemma","vector nonzero","squared norm nonnegative"}];
dimension=n+1;cc=atom["C",dimension,dimension];gg=atom["G",dimension,dimension];vv=atom["v",dimension,1];ww=atom["w",dimension,1];ee=atom["e1",dimension,1];uu=atom["u",dimension,1];i1=identity[1];ii=identity[dimension];denominator=1+t^2*h;
rayleighRelations={relation[product[transpose[vv],vv],i1],relation[product[transpose[vv],ww],zero[1,1]],relation[product[transpose[ww],vv],zero[1,1]],relation[product[transpose[ww],ww],scale[h,i1]],relation[product[transpose[vv],gg,vv],scale[lambda,i1]],relation[product[transpose[ww],gg,vv],scale[c,i1]],relation[product[transpose[vv],gg,ww],scale[c,i1]],relation[product[transpose[ww],gg,ww],scale[g,i1]],relation[transpose[gg],gg]};
curve=scale[1/Sqrt[denominator],add[vv,scale[t,ww]]];
check["irrelevant_zero_relation_preserves_identity",matrixEqual[i1,i1,rayleighRelations]&&!matrixEqual[i1,zero[1,1],rayleighRelations],{"negative control: zero replacements apply only to matching words"}];
check["gram_is_symmetric",matrixEqual[transpose[product[transpose[cc],cc]],product[transpose[cc],cc],{}],{"C real square, arbitrary finite dimension"}];
check["gram_quadratic_is_output_square_sum",matrixEqual[product[transpose[product[cc,vv]],cc,vv],product[transpose[vv],gg,vv],{relation[product[transpose[cc],cc],gg]}],{"G=C^T*C","q(v)=norm(Cv)^2"}];
check["rayleigh_value_nonnegative",And@@(Lookup[Association[(#["id"]->#["passed"]&/@results)],#,False]&/@{"gram_quadratic_is_output_square_sum","sum_squares_nonnegative_induction"}),{"lambda=q(v)","coordinates of C*v real"}];
check["rayleigh_nonnegative_zero_or_positive",FullSimplify[Equivalent[hreal==0||hreal>0,hreal>=0],Element[hreal,Reals]],{"lambda=q(v)>=0","real scalar trichotomy gives exactly the zero and strictly positive cases"}];
check["positive_denominator_order_equivalence",Resolve[ForAll[{arbitraryNumerator,arbitraryLevel,positiveDenominator},positiveDenominator>0,Equivalent[arbitraryNumerator/positiveDenominator<=arbitraryLevel,arbitraryNumerator<=arbitraryLevel*positiveDenominator]],Reals],{"denominator strictly positive","all scalar variables real"}];
check["rayleigh_curve_denominator_positive",FullSimplify[denominator>0,Element[{t,h},Reals]&&h>=0],{"t real","h=norm(w)^2 nonnegative"}];
check["rayleigh_curve_is_unit",matrixEqual[product[transpose[curve],curve],i1,rayleighRelations],{"v unit","inner(v,w)=0","h=norm(w)^2"}];
check["quadratic_cross_terms_coincide",matrixEqual[transpose[product[transpose[ww],gg,vv]],product[transpose[vv],gg,ww],{relation[transpose[gg],gg]}]&&Transpose[{{scalarEntry}}]=={{scalarEntry}},{"G symmetric","every real1x1 matrix equals its transpose","therefore v^T*G*w=w^T*G*v"}];
check["rayleigh_curve_quadratic_form",matrixEqual[product[transpose[curve],gg,curve],scale[(lambda+2*t*c+t^2*g)/denominator,i1],rayleighRelations],{"G symmetric","lambda=inner(v,Gv)","c=inner(w,Gv)","g=inner(w,Gw)"}];
check["maximum_gives_quadratic_inequality",Expand[(lambda+2*t*c+t^2*g-lambda*denominator-(2*t*c+t^2*d))/.d->g-lambda*h]==0,{"v maximizes q on the unit sphere","denominator positive","d=g-lambda*h"}];
contradictionWitness[coefficient_:1]:=Module[{witness,expression,positiveCase,negativeCase,assumptions},witness=coefficient*cnonzero/(Abs[d]+1);expression=2*witness*cnonzero+witness^2*d;assumptions=Element[{cnonzero,absGap},Reals]&&cnonzero!=0&&absGap>=0;positiveCase=FullSimplify[(expression/.d->absGap)>0,assumptions];negativeCase=FullSimplify[(expression/.d->-absGap)>0,assumptions];TrueQ[positiveCase]&&TrueQ[negativeCase]];
check["quadratic_maximum_forces_cross_term_zero",contradictionWitness[],{"2*t*c+t^2*d<=0 for every real t","c nonzero contradicts this at t=c/(abs(d)+1)","d real"}];
check["reject_opposite_contradiction_witness",!contradictionWitness[-1],{"negative control changes witness sign"}];
wDefinition=subtract[product[gg,vv],scale[lambda,vv]];residualRelations={relation[product[transpose[vv],vv],i1],relation[product[transpose[vv],gg,vv],scale[lambda,i1]],relation[transpose[gg],gg]};
check["rayleigh_residual_orthogonal",matrixEqual[product[transpose[vv],wDefinition],zero[1,1],residualRelations],{"v unit","lambda=inner(v,Gv)"}];
check["cross_term_is_residual_squared_norm",matrixEqual[product[transpose[wDefinition],gg,vv],product[transpose[wDefinition],wDefinition],residualRelations],{"G symmetric","v unit","lambda=inner(v,Gv)","w=Gv-lambda*v"}];
lookup[id_]:=Lookup[Association[(#["id"]->#["passed"]&/@results)],id,False];
check["eigenvector_from_maximum_and_zero_square_sum",And@@(lookup/@{"sum_squares_zero_iff_all_zero_induction","quadratic_maximum_forces_cross_term_zero","rayleigh_residual_orthogonal","cross_term_is_residual_squared_norm"}),{"maximum hypothesis","w=Gv-lambda*v","c=0 by witness","norm(w)^2=c","therefore w=0"}];
wrongCurve=scale[1/(1+t*h),add[vv,scale[t,ww]]];
check["reject_linear_curve_denominator",!matrixEqual[product[transpose[wrongCurve],wrongCurve],i1,rayleighRelations],{"negative control replaces square-root normalization"}];
basisAssumptions=Element[{j,k,n},Integers]&&j>=0&&k>=0&&n>=0;
rangeSum[0,index_,body_]:=0;
rangeSumStep[length_,index_,body_]:=If[TrueQ[length==0],0,If[!TrueQ[FullSimplify[length>=1,Element[{n,j,k},Integers]&&n>=0&&j>=0&&k>=0]],Throw[False,"rangeProof"]];rangeSum[length-1,index,body]+(body/.index->length-1)];
deltaBody=KroneckerDelta[index,0]^2;
sphereBase=rangeSumStep[1,index,deltaBody];
sphereStep=FullSimplify[rangeSumStep[n+2,index,deltaBody]/.rangeSum[n+1,index,deltaBody]->1,Element[n,Integers]&&n>=0];
check["first_coordinate_norm_by_range_induction",sphereBase==1&&sphereStep==1&&FullSimplify[KroneckerDelta[n+1,0]==0,Element[n,Integers]&&n>=0],{"rangeSum(m,f) sums indices0 through m-1","base m=1","step adds n+1 with delta(n+1,0)=0","n natural"}];
check["successor_sphere_has_a_unit_vector",FullSimplify[Sum[KroneckerDelta[index,0]^2,{index,0,n}]==1,basisAssumptions],{"successor dimension n+1","first coordinate basis vector"}];
basisSquare=FullSimplify[Sum[KroneckerDelta[index,j]^2,{index,0,j+k}],basisAssumptions];
zeroSumBase=finiteSum[nil,slot,0];zeroSumStep=finiteSum[cons[head,tail],slot,0]/.finiteSum[tail,slot,0]->0;
check["finite_sum_of_zero_terms_induction",zeroSumBase==0&&zeroSumStep==0,{"finite list","base empty and cons step"}];
deltaBefore=FullSimplify[KroneckerDelta[index,index+gapIndex+1],Element[{index,gapIndex},Integers]&&index>=0&&gapIndex>=0];
deltaAfter=FullSimplify[KroneckerDelta[j+k+1,j],basisAssumptions];
columnBody=Centry[row,index]*KroneckerDelta[index,j];
columnAtSelected=rangeSumStep[j+1,index,columnBody]/.rangeSum[j,index,columnBody]->0;
columnAfterSelected=FullSimplify[rangeSumStep[j+k+2,index,columnBody]/.rangeSum[j+k+1,index,columnBody]->Centry[row,j],basisAssumptions];
check["coordinate_column_sum_by_range_induction",lookup["finite_sum_of_zero_terms_induction"]&&deltaBefore==0&&deltaAfter==0&&columnAtSelected==Centry[row,j]&&columnAfterSelected==Centry[row,j],{"indices below j have zero delta, so prefix sum is zero","adding index j contributes exactly Centry(row,j)","each later index j+k+1 contributes zero","j,k natural"}];
check["every_coordinate_unit_vector_and_column",basisSquare==1&&lookup["coordinate_column_sum_by_range_induction"],{"dimension=j+k+1","j,k natural","j arbitrary valid coordinate"}];
check["zero_maximum_forces_each_column_norm_zero",Resolve[ForAll[q,Equivalent[q>=0&&q<=0,q==0]],Reals],{"lambda=0","q(e_j)<=lambda by maximum","q(e_j)>=0 by sum of squares"}];
check["zero_maximum_forces_zero_matrix",And@@(lookup/@{"every_coordinate_unit_vector_and_column","zero_maximum_forces_each_column_norm_zero","sum_squares_zero_iff_all_zero_induction"})&&matrixEqual[product[cc,ii],cc,{}],{"all coordinate columns vanish","matrix entries are their column coordinates"}];
check["zero_matrix_svd_all_dimensions",matrixEqual[product[ii,zero[dimension,dimension],transpose[ii]],zero[dimension,dimension],{}]&&matrixEqual[product[transpose[ii],ii],ii,{}],{"lambda=0 branch; C=0 already derived","sigma vector zero"}];
sigma=Sqrt[positiveLambda];positiveRelations={relation[product[transpose[cc],cc],gg],relation[product[gg,vv],scale[positiveLambda,vv]],relation[product[transpose[vv],vv],i1]};uDefinition=scale[1/sigma,product[cc,vv]];
check["positive_singular_value_is_real_nonzero",FullSimplify[sigma>0&&sigma^2==positiveLambda,Element[positiveLambda,Reals]&&positiveLambda>0],{"lambda>0","sigma=sqrt(lambda)"}];
check["left_singular_vector_is_unit",matrixEqual[product[transpose[uDefinition],uDefinition],i1,positiveRelations],{"G=C^T*C","Gv=lambda*v","v unit","lambda>0"}];
check["two_singular_vector_equations",matrixEqual[product[cc,vv],scale[sigma,uDefinition],{}]&&matrixEqual[product[transpose[cc],uDefinition],scale[sigma,vv],positiveRelations],{"u=Cv/sigma","lambda>0","Gv=lambda*v"}];
aa=subtract[ee,vv];kappa=1-normA/2;houseRelations={relation[product[transpose[ee],ee],i1],relation[product[transpose[vv],vv],i1],relation[product[transpose[ee],vv],scale[kappa,i1]],relation[product[transpose[vv],ee],scale[kappa,i1]]};
check["householder_denominator_from_unit_vectors",matrixEqual[product[transpose[aa],aa],scale[normA,i1],houseRelations],{"e and v unit","a=e-v","normA=2*(1-inner(e,v))"}];
house=subtract[ii,scale[2/normA,product[aa,transpose[aa]]]];
check["householder_symmetric",matrixEqual[transpose[house],house,{}],{"a real","normA real nonzero"}];
check["householder_orthogonal",matrixEqual[product[transpose[house],house],ii,houseRelations]&&matrixEqual[product[house,transpose[house]],ii,houseRelations],{"a=e-v","e,v unit","normA=norm(a)^2>0"}];
check["householder_maps_first_basis_to_vector",matrixEqual[product[house,ee],vv,houseRelations],{"a=e-v","e,v unit","normA>0"}];
check["householder_maps_vector_back_to_first_basis",matrixEqual[product[house,vv],ee,houseRelations],{"a=e-v","e,v unit","normA>0"}];
check["householder_zero_difference_branch",matrixEqual[product[ii,ee],ee,{}]&&matrixEqual[product[transpose[ii],ii],ii,{}],{"a=0 gives v=e","H=I, no division by zero"}];
wrongHouse=subtract[ii,scale[1/normA,product[aa,transpose[aa]]]];
check["reject_missing_householder_factor_two",!matrixEqual[product[transpose[wrongHouse],wrongHouse],ii,houseRelations]&&!matrixEqual[product[wrongHouse,ee],vv,houseRelations],{"negative control replaces 2 by 1"}];
check["householder_branches_exhaust_all_unit_vectors",Resolve[ForAll[hreal,hreal>=0,hreal==0||hreal>0],Reals],{"hreal=norm(a)^2>=0","zero squared norm iff a=0","nonzero branch has hreal>0"}];
hu=atom["Hu",dimension,dimension];hv=atom["Hv",dimension,dimension];blockRelations={relation[transpose[hu],hu],relation[transpose[hv],hv],relation[product[hu,hu],ii],relation[product[hv,hv],ii],relation[product[hv,ee],vv],relation[product[hu,ee],uu],relation[product[hu,uu],ee],relation[product[hv,vv],ee],relation[product[cc,vv],scale[svSigma,uu]],relation[product[transpose[cc],uu],scale[svSigma,vv]]};transformed=product[transpose[hu],cc,hv];
check["transformed_first_column",matrixEqual[product[transformed,ee],scale[svSigma,ee],blockRelations],{"Hu/Hv from proved Householder branches","Cv=sigma*u","C^T*u=sigma*v"}];
check["transformed_first_row",matrixEqual[product[transpose[transformed],ee],scale[svSigma,ee],blockRelations],{"Hu/Hv from proved Householder branches","Cv=sigma*u","C^T*u=sigma*v"}];
check["block_product_from_finite_sum_split",finiteSum[cons[head,tail],slot,Aentry[rowIndex,slot]*Bentry[slot,columnIndex]]==Aentry[rowIndex,head]*Bentry[head,columnIndex]+finiteSum[tail,slot,Aentry[rowIndex,slot]*Bentry[slot,columnIndex]],{"matrix product is finite sum of coordinate products","split first index from remaining n indices"}];
blockProduct[first_,second_]:=Table[add@@Table[product[first[[i,k]],second[[k,j]]],{k,Length[second]}],{i,Length[first]},{j,Length[second[[1]]]}];
blockTranspose[matrix_]:=Map[transpose,Transpose[matrix],{2}];
blockEqual[first_,second_,relations_]:=Dimensions[first]===Dimensions[second]&&And@@Flatten[MapThread[matrixEqual[#1,#2,relations]&,{first,second},2]];
dd=atom["D",n,n];rowTail=atom["rowTail",1,n];columnTail=atom["columnTail",n,1];block={{scale[alpha,i1],rowTail},{columnTail,dd}};firstBasis={{i1},{zero[n,1]}};
check["first_column_block_coordinates",blockEqual[blockProduct[block,firstBasis],{{scale[alpha,i1]},{columnTail}},{}],{"arbitrary block matrix of dimension n+1"}];
check["first_row_block_coordinates",blockEqual[blockProduct[blockTranspose[firstBasis],block],{{scale[alpha,i1],rowTail}},{}],{"arbitrary block matrix of dimension n+1"}];
check["singular_pair_forces_diagonal_block",blockEqual[block/.{alpha->svSigma,rowTail->zero[1,n],columnTail->zero[n,1]},{{scale[svSigma,i1],zero[1,n]},{zero[n,1],dd}},{}],{"first row and column equal sigma*e1","D arbitrary real nxn"}];
ud=atom["Ud",n,n];vd=atom["Vd",n,n];sd=atom["Sd",n,n];udBlock={{i1,zero[1,n]},{zero[n,1],ud}};vdBlock={{i1,zero[1,n]},{zero[n,1],vd}};sBlock={{scale[svSigma,i1],zero[1,n]},{zero[n,1],sd}};blockIdentity={{i1,zero[1,n]},{zero[n,1],identity[n]}};
childRelations={relation[product[transpose[ud],ud],identity[n]],relation[product[ud,transpose[ud]],identity[n]],relation[product[transpose[vd],vd],identity[n]],relation[product[vd,transpose[vd]],identity[n]],relation[product[ud,sd,transpose[vd]],dd]};
check["embedded_child_factors_are_orthogonal",And@@(blockEqual[#,blockIdentity,childRelations]&/@{blockProduct[blockTranspose[udBlock],udBlock],blockProduct[udBlock,blockTranspose[udBlock]],blockProduct[blockTranspose[vdBlock],vdBlock],blockProduct[vdBlock,blockTranspose[vdBlock]]}),{"induction hypothesis: Ud,Vd orthogonal nxn"}];
check["embedded_child_reconstructs_diagonal_block",blockEqual[blockProduct[blockProduct[udBlock,sBlock],blockTranspose[vdBlock]],{{scale[svSigma,i1],zero[1,n]},{zero[n,1],dd}},childRelations],{"induction hypothesis: Ud*Sd*Vd^T=D"}];
ue=atom["Ue",dimension,dimension];ve=atom["Ve",dimension,dimension];se=atom["Se",dimension,dimension];db=atom["Db",dimension,dimension];fullRelations={relation[transpose[hu],hu],relation[transpose[hv],hv],relation[product[hu,hu],ii],relation[product[hv,hv],ii],relation[product[transpose[ue],ue],ii],relation[product[ue,transpose[ue]],ii],relation[product[transpose[ve],ve],ii],relation[product[ve,transpose[ve]],ii],relation[product[ue,se,transpose[ve]],db],relation[db,product[hu,cc,hv]]};uFull=product[hu,ue];vFull=product[hv,ve];
check["successor_factors_are_orthogonal",matrixEqual[product[transpose[uFull],uFull],ii,fullRelations]&&matrixEqual[product[uFull,transpose[uFull]],ii,fullRelations]&&matrixEqual[product[transpose[vFull],vFull],ii,fullRelations]&&matrixEqual[product[vFull,transpose[vFull]],ii,fullRelations],{"embedded child factors as proved above","Hu,Hv orthogonal"}];
check["successor_reconstructs_original_matrix",matrixEqual[product[uFull,se,transpose[vFull]],cc,fullRelations],{"Ue*Se*Ve^T=diag(sigma,D)","diag(sigma,D)=Hu^T*C*Hv"}];
check["successor_diagonal_singular_values",FullSimplify[KroneckerDelta[0,0]==1&&KroneckerDelta[0,tailJ+1]==0&&KroneckerDelta[tailI+1,0]==0&&KroneckerDelta[tailI+1,tailJ+1]==KroneckerDelta[tailI,tailJ],Element[{tailI,tailJ},Integers]&&tailI>=0&&tailJ>=0],{"child Sd(i,j)=delta(i,j)*s_child(i)","head sigma and remaining child singular values","four head/tail coordinate cases identify block diagonal with diagonal of concatenated singular vector"}];
check["successor_singular_values_nonnegative",FullSimplify[svSigma>=0&&childSingular>=0,Element[{svSigma,childSingular},Reals]&&svSigma>0&&childSingular>=0],{"first singular value sigma>0","remaining values nonnegative by induction"}];
check["induction_dimension_strictly_decreases",FullSimplify[dimension-n==1&&n>=0,Element[n,Integers]&&n>=0],{"successor dimension n+1","recursive call has dimension n"}];
check["natural_successor_is_positive",FullSimplify[Element[dimension,Integers]&&dimension>0,Element[n,Integers]&&n>=0],{"n natural including zero","n+1 is a positive natural number"}];
empty={};
check["dimension_zero_svd",matrixEqual[product[transpose[identity[0]],identity[0]],identity[0],{}]&&matrixEqual[product[identity[0],zero[0,0],identity[0]],zero[0,0],{}]&&identity[0]===zero[0,0],{"unique empty matrix decomposition","orthogonality and reconstruction are equalities of functions on empty index products","no singular-value coordinates"}];
