ClearAll["Global`*"];
results={};
check[id_,value_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[value]|>];
rows={"100100000","101000000","110000000","011010000","011200000","010010000","010010000","001100000","010000001","000001110","000000111","000000011"};
m=Map[FromDigits,Map[Characters,rows],{2}];
g=Transpose[m].m;
p=x^9-31x^8+374x^7-2286x^6+7697x^5-14557x^4+15014x^3-7755x^2+1732x-124;
check["characteristic_from_source",Expand[Det[x IdentityMatrix[9]-g]-p]==0];
check["symmetric_gram",g==Transpose[g]];
check["positive_definite_gram",PositiveDefiniteMatrixQ[g]];
published={334,254,235,164,150,131,85,56,36}/100;
intervals={(#-1/200)^2,(#+1/200)^2}&/@published;
check["sign_changes",And@@((p/.x->#[[1]])*(p/.x->#[[2]])<0&/@intervals)];
check["intervals_disjoint",And@@(#[[1,2]]<#[[2,1]]||#[[2,2]]<#[[1,1]]&/@Subsets[intervals,{2}])];
counts=CountRoots[p,{x,#[[1]],#[[2]]}]&/@intervals;
check["exact_root_count",Exponent[p,x]==9&&Total[counts]==9&&counts==ConstantArray[1,9]];
check["no_other_roots",CountRoots[p,{x,-Infinity,Infinity}]==9&&CountRoots[p,{x,0,Infinity}]==9];
check["singular_value_intervals",And@@MapThread[#1[[1]]>0&&Sqrt[#1[[1]]]==#2-1/200&&Sqrt[#1[[2]]]==#2+1/200&,{intervals,published}]];
u=Array[uu,{12,2}];v=Array[vv,{9,2}];diag=DiagonalMatrix[{s0,s1}];
check["reconstruction_coordinate",Expand[(u.diag.Transpose[v])[[1,1]]-uu[1,1]s0 vv[1,1]-uu[1,2]s1 vv[1,2]]==0];
check["published_diagonal_inverse",DiagonalMatrix[{100/334,100/254}].DiagonalMatrix[{334/100,254/100}]==IdentityMatrix[2]];
check["rank_two_diagonal",FullSimplify[Det[diag]>0,s0>0&&s1>0]];
gramU={{a00,a01},{a10,a11}};gramV={{b00,b01},{b10,b11}};
orthonormal={a00->1,a01->0,a10->0,a11->1,b00->1,b01->0,b10->0,b11->1};
leftInverseCertificate=DiagonalMatrix[{1/s0,1/s1}].gramU.diag.gramV;
check["rank_two_left_inverse_under_orthonormality",FullSimplify[(leftInverseCertificate/.orthonormal)==IdentityMatrix[2],s0>0&&s1>0]];
check["positive_singular_values_nonzero",FullSimplify[Det[diag]>0,s0>0&&s1>0]];
check["rank_two_requires_column_independence",MatrixRank[ConstantArray[0,{12,2}].diag.Transpose[v]]==0];
check["source_singular_values_complete",g==Transpose[m].m&&Expand[Det[x IdentityMatrix[9]-g]-p]==0&&And@@(#[[1]]>0&/@intervals)&&counts==ConstantArray[1,9]&&Total[counts]==9&&CountRoots[p,{x,-Infinity,Infinity}]==9];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->AllTrue[results,TrueQ[#["passed"]]&],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[TrueQ[report["passed"]],0,1]];
