BeginPackage["ProcrustesProof`"];
assumptions=Element[{nn,dd},Integers]&&nn>0&&dd>0&&Element[aa,Matrices[{nn,dd},Reals]]&&Element[bb,Matrices[{nn,dd},Reals]]&&Element[cc,Matrices[{dd,nn},Reals]]&&Element[qq,Matrices[{dd,dd},Reals]]&&Element[uu,Matrices[{dd,dd},Reals]]&&Element[vv,Matrices[{dd,dd},Reals]]&&Element[rr,Matrices[{dd,dd},Reals]]&&Element[ss,Matrices[{dd,dd},Reals]]&&Element[cross,Matrices[{dd,dd},Reals]];
orthogonal={qq,uu,vv,rr};
transposeFactor[Transpose[x_,{2,1}]]:=x;
transposeFactor[x_]:=Transpose[x,{2,1}];
inversePair[pair_,allowed_]:=Or@@Table[pair==={m,Transpose[m,{2,1}]}||pair==={Transpose[m,{2,1}],m},{m,allowed}];
reduceWord[word_,allowed_]:=Module[{position},position=FirstPosition[Partition[word,2,1],pair_/;inversePair[pair,allowed],Missing["None"],{1}];If[MissingQ[position],word,reduceWord[Join[Take[word,First[position]-1],Drop[word,First[position]+1]],allowed]]];
wordOf[expr_]:=If[Head[expr]===Dot,List@@expr,{expr}];
matrixNormal[expr_,allowed_]:=Module[{value,word},value=TensorReduce[expr,Assumptions->assumptions];word=reduceWord[wordOf[value],allowed];If[word==={},IdentityMatrix[dd],If[Length[word]==1,First[word],Dot@@word]]];
canonicalTrace[expr_,allowed_]:=Module[{word,orientations,variants,reduced,best},word=wordOf[expr];orientations={word,transposeFactor/@Reverse[word]};variants=Flatten[Table[Table[reduced=reduceWord[RotateLeft[orientation,k],allowed];If[reduced==={},{},First[SortBy[Table[RotateLeft[reduced,l],{l,0,Length[reduced]-1}],ToString[#,InputForm]&]]],{k,0,Length[orientation]-1}],{orientation,orientations}],1];best=First[SortBy[variants,{Length[#],ToString[#,InputForm]}&]];If[best==={},dd,formalTrace[best]]];
tr[x_]:=TensorContract[x,{{1,2}}];
mp[x_,y_]:=TensorContract[TensorProduct[x,y],{{2,3}}];
scalarZero[expr_]:=expr/.HoldPattern[Times[0,rest___]]:>0;
traceNormal[expr_,allowed_]:=Expand[scalarZero[TensorReduce[expr,Assumptions->assumptions]]/.HoldPattern[TensorContract[value_,{{1,2}}]]:>canonicalTrace[value,allowed]];
productEntry[a_,b_,inner_,row_,column_]:=Module[{slot},Sum[a[row,slot]b[slot,column],{slot,1,inner}]];
transposeEntry[a_][row_,column_]:=a[column,row];
diagonalEntry[row_,column_]:=KroneckerDelta[row,column]sigma[row];
traceEntry[a_]:=Module[{slot},Sum[a[slot,slot],{slot,1,dd}]];
columnSquareEntry[row_,column_]:=productEntry[transposeEntry[rEntry],rEntry,dd,row,column];
traceDiagonalEntry[row_,column_]:=productEntry[transposeEntry[rEntry],diagonalEntry,dd,row,column];
canonical[expr_]:=If[!FreeQ[expr,s_Symbol/;StringStartsQ[SymbolName[s],"proofIndex"]],Throw[$Failed],canonical[expr,0]];
canonical[expr_,depth_]:=If[AtomQ[expr],expr,If[Head[expr]===Sum,If[Length[expr]!=2||Length[expr[[2]]]!=3,Throw[$Failed]];Module[{variable=expr[[2,1]],index=Symbol["proofIndex"<>ToString[depth]],lower=expr[[2,2]],upper=expr[[2,3]],body},body=expr[[1]]/.variable->index;Inactive[Sum][canonical[body,depth+1],{index,lower,upper}]],Map[canonical[#,depth]&,expr]]];
folds={weighted,total,weightedGap,squares};
terms={sig[freshHead]diag[freshHead],sig[freshHead],sig[freshHead](1-diag[freshHead]),entry[freshHead]^2};
unfold[expr_]:=expr/.Join[Thread[(#[nil]&/@folds)->0],Thread[(#[cons[freshHead,freshTail]]&/@folds)->MapThread[#1+#2[freshTail]&,{terms,folds}]]];
finiteInduction[left_,right_]:=If[!FreeQ[{left,right},freshHead|freshTail],False,Module[{base,ihLeft,ihRight,stepLeft,stepRight},base=Expand[unfold[left/.xs->nil]-unfold[right/.xs->nil]];ihLeft=left/.xs->freshTail;ihRight=right/.xs->freshTail;stepLeft=unfold[left/.xs->cons[freshHead,freshTail]];stepRight=unfold[right/.xs->cons[freshHead,freshTail]];TrueQ[base==0&&Expand[(stepLeft/.ihLeft->ihRight)-(stepRight/.ihLeft->ihRight)]==0]]];
squaresNonnegativeInduction[]:=TrueQ[unfold[squares[nil]]==0&&FullSimplify[(unfold[squares[cons[freshHead,freshTail]]]/.squares[freshTail]->tailNonnegative)>=0,Element[{entry[freshHead],tailNonnegative},Reals]&&tailNonnegative>=0]];
memberUnfold[value_,nil]:=False;
memberUnfold[value_,cons[head_,tail_]]:=(value==entry[head])||member[value,tail];
memberUnfold[value_,sequence_]:=member[value,sequence];
memberBoundInduction[sign_:1]:=Module[{expression,headCase,tailCase},expression=sign unfold[squares[cons[freshHead,freshTail]]]-selectedEntry^2;headCase=expression/.{selectedEntry->entry[freshHead],squares[freshTail]->tailNonnegative};tailCase=expression/.squares[freshTail]->selectedEntry^2+tailGap;TrueQ[squaresNonnegativeInduction[]&&memberUnfold[selectedEntry,nil]===False&&memberUnfold[selectedEntry,cons[freshHead,freshTail]]===((selectedEntry==entry[freshHead])||member[selectedEntry,freshTail])&&FullSimplify[headCase>=0,Element[{entry[freshHead],tailNonnegative},Reals]&&tailNonnegative>=0]&&FullSimplify[tailCase>=0,Element[{entry[freshHead],selectedEntry,tailGap},Reals]&&tailGap>=0]]];
weightedGapNonnegativeInduction[]:=TrueQ[unfold[weightedGap[nil]]==0&&FullSimplify[(unfold[weightedGap[cons[freshHead,freshTail]]]/.{diag[freshHead]->1-gap[freshHead],weightedGap[freshTail]->tailNonnegative})>=0,Element[{sig[freshHead],gap[freshHead],tailNonnegative},Reals]&&sig[freshHead]>=0&&gap[freshHead]>=0&&tailNonnegative>=0]];
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["dimensions",TensorDimensions[aa,Assumptions->assumptions]==={nn,dd}&&TensorDimensions[qq,Assumptions->assumptions]==={dd,dd}];
check["one_sided_determinant_identity",FullSimplify[Det[Transpose[qq].qq]==Det[qq]^2&&Det[IdentityMatrix[dd]]==1,assumptions]];
check["one_sided_determinant_nonzero",Resolve[ForAll[value,Implies[value^2==1,value!=0]],Reals]];
oneSidedSides={Transpose[qq].qq,IdentityMatrix[dd]};
canceledSides=FullSimplify[#.Inverse[qq],assumptions&&Det[qq]!=0]&/@oneSidedSides;
check["invertible_right_cancellation",FullSimplify[canceledSides[[1]]==Transpose[qq]&&canceledSides[[2]]==Inverse[qq],assumptions&&Det[qq]!=0]];
check["opposite_product_from_inverse",FullSimplify[(qq.Transpose[qq]/.Transpose[qq]->Inverse[qq])==IdentityMatrix[dd],assumptions&&Det[qq]!=0]];

check["trace_cycle_contraction_identity",scalarZero[TensorReduce[tr[mp[aa,cc]]-tr[mp[cc,aa]],Assumptions->assumptions]]===0];
check["trace_transpose_contraction_identity",TensorReduce[tr[TensorTranspose[qq,{2,1}]]-tr[qq],Assumptions->assumptions]===0];
check["column_squares_contraction",canonical[columnSquareEntry[j,j]]===canonical[Sum[rEntry[i,j]^2,{i,1,dd}]]];
check["square_sum_nonnegative_induction",squaresNonnegativeInduction[]];
check["selected_member_bound_induction",memberBoundInduction[]];
check["column_member_bounds",Resolve[ForAll[x,Implies[x^2<=1,-1<=x<=1]],Reals]];
check["orthogonal_product",matrixNormal[Transpose[Transpose[uu].qq.vv].(Transpose[uu].qq.vv),orthogonal]===IdentityMatrix[dd]&&matrixNormal[(Transpose[uu].qq.vv).Transpose[Transpose[uu].qq.vv],orthogonal]===IdentityMatrix[dd]];
frobSqEntry[a_]:=Sum[Sum[a[i,j]^2,{i,1,nn}],{j,1,dd}];
transposeProductEntry[a_][row_,column_]:=productEntry[transposeEntry[a],a,nn,row,column];
check["frob_square_trace_coordinates",canonical[traceEntry[transposeProductEntry[aEntry]]]===canonical[frobSqEntry[aEntry]]];
check["frob_coordinate_sum_order",scalarZero[TensorReduce[TensorContract[TensorProduct[aa,aa],{{1,3},{2,4}}]-TensorContract[TensorProduct[aa,aa],{{2,4},{1,3}}],Assumptions->assumptions]]===0];
actualLoss=tr[Transpose[aa.qq-bb].(aa.qq-bb)];
traceLoss=tr[Transpose[aa].aa]+tr[Transpose[bb].bb]-2tr[Transpose[qq].Transpose[aa].bb];
check["loss_trace_expansion",traceNormal[actualLoss,orthogonal]===traceNormal[traceLoss,orthogonal]];
check["svd_rotated_trace",traceNormal[tr[Transpose[qq].uu.ss.Transpose[vv]],orthogonal]===traceNormal[tr[Transpose[Transpose[uu].qq.vv].ss],orthogonal]];
deltaTerm=KroneckerDelta[k,j]rEntry[k,j]sigma[k];
deltaPulled=KroneckerDelta[k,j]rEntry[j,j]sigma[j];
siftActual[nil]:=0;
siftActual[cons[head_,tail_]]:=KroneckerDelta[head,j]rEntry[head,j]sigma[head]+siftActual[tail];
siftPulled[nil]:=0;
siftPulled[cons[head_,tail_]]:=KroneckerDelta[head,j]rEntry[j,j]sigma[j]+siftPulled[tail];
siftBase={siftActual[nil],siftPulled[nil]};
siftStep={siftActual[cons[k,xs]],siftPulled[cons[k,xs]]};
check["diagonal_summand_equal_case",FullSimplify[deltaTerm==deltaPulled,Element[{k,j},Integers]&&k==j]];
check["diagonal_summand_unequal_case",FullSimplify[deltaTerm==deltaPulled,Element[{k,j},Integers]&&k!=j]];
check["diagonal_sifting_finite_induction",siftBase[[1]]==siftBase[[2]]&&FullSimplify[(siftStep[[1]]/.siftActual[xs]->siftPulled[xs])==siftStep[[2]],Element[{k,j},Integers]&&k==j]&&FullSimplify[(siftStep[[1]]/.siftActual[xs]->siftPulled[xs])==siftStep[[2]],Element[{k,j},Integers]&&k!=j]];
check["diagonal_trace_coordinate",canonical[traceDiagonalEntry[j,j]]===canonical[Sum[deltaTerm,{k,1,dd}]]&&FullSimplify[Sum[deltaPulled,{k,1,dd}]==rEntry[j,j]sigma[j],Element[{dd,j},Integers]&&dd>0&&1<=j<=dd]];
check["diagonal_trace_contraction_definition",canonical[traceEntry[traceDiagonalEntry]]===canonical[Sum[Sum[KroneckerDelta[k,j]rEntry[k,j]sigma[k],{k,1,dd}],{j,1,dd}]]];
check["diagonal_trace_finite_sum",canonical[Sum[rEntry[j,j]sigma[j],{j,1,dd}]]===canonical[Sum[sigma[i]rEntry[i,i],{i,1,dd}]]];
check["weighted_trace_fold_instantiation",(terms[[1]]/.{sig[freshHead]->sigma[freshHead],diag[freshHead]->rEntry[freshHead,freshHead]})===sigma[freshHead]rEntry[freshHead,freshHead]];
check["column_square_fold_instantiation",(terms[[4]]/.entry[freshHead]->rEntry[freshHead,j])===rEntry[freshHead,j]^2];
check["weighted_gap_induction",finiteInduction[total[xs]-weighted[xs],weightedGap[xs]]];
check["weighted_gap_nonnegative_induction",weightedGapNonnegativeInduction[]];
check["diagonal_gap_parameterization",Resolve[ForAll[x,Implies[x<=1,1-x>=0&&x==1-(1-x)]],Reals]];
check["candidate_orthogonal",matrixNormal[Transpose[uu.Transpose[vv]].(uu.Transpose[vv]),orthogonal]===IdentityMatrix[dd]&&matrixNormal[(uu.Transpose[vv]).Transpose[uu.Transpose[vv]],orthogonal]===IdentityMatrix[dd]];
check["candidate_rotated_identity",matrixNormal[Transpose[uu].(uu.Transpose[vv]).vv,orthogonal]===IdentityMatrix[dd]];
check["candidate_attains_trace",traceNormal[tr[Transpose[uu.Transpose[vv]].uu.ss.Transpose[vv]],orthogonal]===traceNormal[tr[ss],orthogonal]];
parameterizedLoss=tr[Transpose[aa].aa]+tr[Transpose[bb].bb]-2tr[Transpose[qq].cross];
check["actual_cross_matrix_binding",traceNormal[parameterizedLoss/.cross->Transpose[aa].bb,orthogonal]===traceNormal[traceLoss,orthogonal]];
conditionalLoss=parameterizedLoss/.cross->uu.ss.Transpose[vv];
candidateLoss=conditionalLoss/.qq->uu.Transpose[vv];
check["actual_conditional_loss_gap",traceNormal[conditionalLoss-candidateLoss,orthogonal]===traceNormal[2(tr[ss]-tr[Transpose[qq].uu.ss.Transpose[vv]]),orthogonal]];
check["conditional_loss_difference",Expand[(constant-2value)-(constant-2bound)-2(bound-value)]==0];
check["conditional_loss_nonnegative",Resolve[ForAll[{constant,value,bound},Implies[value<=bound,(constant-2bound)<=(constant-2value)]],Reals]];
check["square_root_preserves_order",Resolve[ForAll[{x,y},Implies[0<=x<=y,Sqrt[x]<=Sqrt[y]]],Reals]];
check["missing_orthogonality_rejected",traceNormal[actualLoss,{}]=!=traceNormal[traceLoss,{}]];
check["wrong_svd_transpose_rejected",traceNormal[tr[Transpose[qq].uu.ss.vv],orthogonal]=!=traceNormal[tr[Transpose[Transpose[uu].qq.vv].ss],orthogonal]];
check["wrong_weighted_induction_rejected",!finiteInduction[total[xs]+weighted[xs],weightedGap[xs]]];
check["wrong_member_bound_rejected",!memberBoundInduction[-1]];
check["nonfresh_induction_rejected",!finiteInduction[total[xs],total[xs]+freshHead]];
check["negative_weight_bound_rejected",(-1)(1-0)<0];
report=<|"backend"->"Wolfram","scope"->"positive integer N,d; real matrices; one-sided orthogonality of Q yields invertibility and the opposite product; two-sided orthogonal U,V; conditional SVD of A transpose B with nonnegative diagonal; actual finite contractions, trace identities and induction over finite sums; no universal SVD-existence claim","checks"->Length[results],"passed"->True,"results"->results|>;
If[!TrueQ[$LibraryMode],Print[ExportString[report,"RawJSON"]]];
EndPackage[];
If[!TrueQ[ProcrustesProof`$LibraryMode],Exit[0]];
