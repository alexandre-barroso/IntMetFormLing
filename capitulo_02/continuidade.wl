results = {};
check[id_, value_] := AppendTo[results, <|"id" -> id, "passed" -> TrueQ[value]|>];
delta = (b - a)/n;
check["c02_p05_partition_width", Simplify[n delta == b - a]];
check["c02_p05_partition_endpoint", Simplify[a + n delta == b]];
check["c02_p05_partition_increment", Simplify[(a + j delta) - (a + (j - 1) delta) == delta]];
check["c02_p05_constant_integral", Simplify[Sum[delta, {j, 1, n}] == Integrate[1, {t, a, b}], n > 0 && Element[n, Integers]]];
check["c02_p05_uniform_error_bound", Simplify[n epsilon delta == epsilon (b - a)]];
check["c02_p05_error_limit", Limit[epsilon (b - a), epsilon -> 0] == 0];
mu = -268/100;
sigma = 59/100;
lower = 3/100;
upper = 14/100;
density[t_] := Exp[-(Log[t] - mu)^2/(2 sigma^2)]/(t sigma Sqrt[2 Pi]);
integral = NIntegrate[density[t], {t, lower, upper}, WorkingPrecision -> 50, AccuracyGoal -> 40, PrecisionGoal -> 40];
cdf[t_] := (1 + Erf[(Log[t] - mu)/(sigma Sqrt[2])])/2;
check["c02_p05_density_integral", Abs[integral - N[cdf[upper] - cdf[lower], 50]] < 10^-38];
errors = Table[Abs[N[Sum[density[lower + k (upper - lower)/count] (upper - lower)/count, {k, 1, count}], 45] - integral], {count, {16, 64, 256, 1024}}];
check["c02_p05_riemann_refinement", And @@ Thread[Rest[errors] < Most[errors]]];
check["c02_p05_riemann_precision", Last[errors] < 1/1000];
check["c02_n01_weighted_sum_linearity", Expand[w (alpha f + beta) - (alpha w f + beta w)] == 0];
report = <|"backend" -> "Wolfram", "checks" -> Length[results], "passed" -> AllTrue[results, TrueQ[#["passed"]] &], "results" -> results|>;
Print[ExportString[report, "RawJSON"]];
Exit[If[TrueQ[report["passed"]], 0, 1]];
