BeginPackage["AnalysisBridge`"];
ClearAll[AnalysisBridge`verifyCertificates];
If[!ValueQ[AnalysisBridge`$LibraryMode], AnalysisBridge`$LibraryMode=False];
Begin["`Private`"];
Block[{AnalysisProof`$LibraryMode=True}, Get[FileNameJoin[{DirectoryName[$InputFileName], "analise_geral.wl"}]]];
certificateGzipBase64 = "";
AnalysisBridge`verifyCertificates[] := Module[{report,check,results={}},
report=AnalysisProof`verifyProofGraph[ImportString[ImportByteArray[BaseDecode[certificateGzipBase64], {"GZIP", "Text"}], "RawJSON"]];
If[!TrueQ[report["passed"]],Return[report]];
check[id_,formula_,hypotheses_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[report["targets"][id]["formula"]===formula && Sort[report["targets"][id]["hypotheses"]]===Sort[hypotheses]],"formula"->formula,"hypotheses"->hypotheses|>];
check["positive_interval","|- ( A [,] B ) C_ RR+",{"|- A e. RR+","|- B e. RR"}];
check["logarithm_mean_value","|- E. x e. ( A (,) B ) ( 1 / x ) = ( ( ( log ` B ) - ( log ` A ) ) / ( B - A ) )",{"|- A < B","|- A e. RR+","|- B e. RR"}];
check["fundamental_calculus","|- S. ( A [,] B ) ( G ` x ) _d x = ( ( F ` B ) - ( F ` A ) )",{"|- ( RR _D F ) = ( G |` ( A (,) B ) )","|- A <_ B","|- A e. RR","|- B e. RR","|- F e. ( ( A [,] B ) -cn-> CC )","|- G e. ( ( A [,] B ) -cn-> CC )"}];
check["derivative_pointwise_graph","|- ( RR _D F ) = ( G |` ( A (,) B ) )",{"|- A e. RR","|- A. x e. ( A (,) B ) x ( RR _D F ) ( G ` x )","|- B e. RR","|- F e. ( ( A [,] B ) -cn-> CC )","|- G e. ( ( A [,] B ) -cn-> CC )"}];
check["fundamental_calculus_pointwise","|- S. ( A [,] B ) ( G ` x ) _d x = ( ( F ` B ) - ( F ` A ) )",{"|- A <_ B","|- A e. RR","|- A. x e. ( A (,) B ) x ( RR _D F ) ( G ` x )","|- B e. RR","|- F e. ( ( A [,] B ) -cn-> CC )","|- G e. ( ( A [,] B ) -cn-> CC )"}];
check["singleton_integral","|- ( ( x e. { A } |-> ( F ` x ) ) e. L^1 /\\ S. { A } ( F ` x ) _d x = 0 )",{"|- A e. RR","|- F : RR --> RR"}];
AssociateTo[report,{"checks"->Length[results],"results"->results,"passed"->And@@Lookup[results,"passed"]}];report];
If[!TrueQ[AnalysisBridge`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName], report=AnalysisBridge`verifyCertificates[]; Print[ExportString[KeyDrop[report,{"targets"}],"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]]];
End[];
EndPackage[];
