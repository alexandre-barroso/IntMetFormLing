ClearAll["Global`*"];
checks={};
check[name_,proposition_]:=If[TrueQ[proposition],AppendTo[checks,<|"id"->name,"passed"->True|>],Print[{name,proposition}];Exit[1]];
check["zipf_derivative",FullSimplify[D[c*x^(-alpha),x]==-alpha*c*x^(-alpha-1),x>0&&c>0&&alpha>0]];
check["zipf_derivative_negative",FullSimplify[D[c*x^(-alpha),x]<0,x>0&&c>0&&alpha>0]];
check["heaps_derivative_positive",FullSimplify[D[d*x^beta,x]>0,x>0&&d>0&&beta>0]];
heapsAssumptions=d>0&&x>0&&k>1&&beta<1&&Element[beta,Reals];
heapsNumerator=d*(k*x)^beta;
heapsDenominator=k*d*x^beta;
heapsLogRatio=FullSimplify[PowerExpand[Log[heapsNumerator/heapsDenominator],Assumptions->heapsAssumptions],heapsAssumptions];
check["heaps_positive_sides",FullSimplify[heapsNumerator>0&&heapsDenominator>0,heapsAssumptions]];
check["heaps_log_ratio",FullSimplify[heapsLogRatio==(beta-1)*Log[k],heapsAssumptions]];
heapsLogNegativeRegion=Reduce[r>0&&Log[r]<0,r,Reals];
check["heaps_log_criterion",Resolve[ForAll[r,Equivalent[heapsLogNegativeRegion,0<r<1]],Reals]];
check["heaps_positive_denominator_order",Resolve[ForAll[{a,b},b>0,Equivalent[a/b<1,a<b]],Reals]];
check["heaps_sublinear_scale",FullSimplify[heapsLogRatio<0,heapsAssumptions]];
check["fractional_power_equation",FullSimplify[(x^(63/100))^100==x^63,x>0]];
check["fractional_power_unique_inverse",FullSimplify[(z^100)^(1/100)==z&&((x^63)^(1/100)==x^(63/100)),z>0&&x>0]];
check["surprise_derivative",FullSimplify[D[-Log[p]/Log[2],p]==-1/(p*Log[2]),p>0]];
check["surprise_derivative_negative",FullSimplify[D[-Log[p]/Log[2],p]<0,p>0]];
check["inverse_duration_order",Resolve[ForAll[{u,d},u>0&&d>0,1/(u+d)<1/u],Reals]];
check["primitive_constant_cancels",Expand[(fb+c)-(fa+c)]==fb-fa];
check["normalization_scale",Resolve[ForAll[c,Equivalent[c^2==1,c==1||c==-1]],Reals]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"general symbolic derivatives, signs, powers and integral-scaling identities; arbitrary-function Newton–Leibniz theorem is formalized in Exposicao.lean","checks"->Length[checks],"passed"->True,"results"->checks|>,"RawJSON"]];
Exit[0];
