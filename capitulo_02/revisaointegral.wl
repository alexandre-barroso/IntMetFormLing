ClearAll["Global`*"];
r={};
check[name_,value_]:=AppendTo[r,<|"id"->name,"passed"->TrueQ[value]|>];
check["equation_steps",And@@((n/.First[Solve[#==0,n,Reals]])==3&/@{8 n/100-24/100,100(8 n/100)-100(24/100),8 n-24,8 n/8-24/8,n-3})];
check["reverse_order",Resolve[ForAll[{u,v},Implies[u<v,-u>-v]],Reals]];
check["negative_power",FullSimplify[x^b==1/x^(-b),x>0&&Element[b,Reals]]];
check["derivative_identity",D[x,x]==1];
check["derivative_log",D[Log[x],x]==1/x];
check["derivative_exp",D[Exp[x],x]==Exp[x]];
check["derivative_log_composition",D[Log[y[x]],x]==y'[x]/y[x]];
check["derivative_log_constant",D[Log[a],n]==0];
check["derivative_scaled_log",D[b Log[x],x]==b/x];
check["derivative_negative_linear",D[-c n,n]==-c];
check["derivative_affine",D[a+b s,s]==b];
check["numerator_rewrite",FullSimplify[b/n-c==(b-c n)/n,n!=0&&Element[{b,c,n},Reals]]];
check["numerator_increasing",Resolve[ForAll[{b,c,n1,n2},Implies[c<0&&n1<n2,b+(-c)n1<b+(-c)n2]],Reals]];
check["positive_square",Resolve[ForAll[u,Implies[u>0,u^2>0]],Reals]];
check["negative_coefficient",Resolve[ForAll[c,Equivalent[-c>0,c<0]],Reals]];
check["empirical_width",FullSimplify[(14/100-3/100)/nn==(11/100)/nn,nn>0]];
check["surprise_base",FullSimplify[-Log[2,x]==-Log[x]/Log[2],x>0]];
check["constant_recovery",Resolve[ForAll[{m,l,t},Implies[m!=0&&t==m l,t/m==(m l)/m&&(m l)/m==l&&l==t/m]],Reals]];
check["maximum_rounding",(-227/1000)/(-67/10000)==(227/1000)/(67/10000)==2270/67&&Abs[2270/67-3388/100]<1/200];
check["positive_factors",FullSimplify[aa>0&&nn^bb>0&&Exp[-cc nn]>0&&aa nn^bb Exp[-cc nn]>0,aa>0&&nn>0&&Element[{aa,nn,bb,cc},Reals]]];
check["surprise_nonnegative",FullSimplify[-Log[pp]/Log[2]>=0,0<pp<=1]];
check["maximum_integer_rounding",Abs[2270/67-34]<1/2];
Print[ExportString[<|"passed"->And@@Lookup[r,"passed"],"results"->r|>,"RawJSON"]];
If[And@@Lookup[r,"passed"],Exit[0],Exit[1]];
