results={};
check[id_,value_,hypotheses_] := AppendTo[results,<|"id"->id,"hypotheses"->hypotheses,"passed"->TrueQ[value]|>];
finiteSlope[m_,l1_,l2_] := If[l2===l1,Missing["Undefined"],Together[(m l2-m l1)/(l2-l1)]];
linearIncrement[m_,l_,h_] := If[h===0,Missing["Undefined"],Together[(m(l+h)-m l)/h]];
reciprocalIncrement[u_,h_] := If[u===0||h===0||Together[u+h]===0,Missing["Undefined"],Together[(1/(u+h)-1/u)/h]];
check["finite_slope_valid",Resolve[ForAll[{m,l1,l2},Implies[l2!=l1,(m l2-m l1)/(l2-l1)==m]],Reals],{"m,L1,L2 real","L2!=L1"}];
check["finite_slope_reject_zero",MissingQ[finiteSlope[m,l,l]],{"L2=L1"}];
check["linear_increment_valid",Resolve[ForAll[{m,l,h},Implies[h!=0,(m(l+h)-m l)/h==m]],Reals],{"m,L,h real","h!=0"}];
check["linear_increment_reject_zero",MissingQ[linearIncrement[m,l,0]],{"h=0"}];
check["reciprocal_increment_algebra",Resolve[ForAll[{u,h},Implies[u!=0&&h!=0&&u+h!=0,(1/(u+h)-1/u)/h==-1/(u(u+h))]],Reals],{"u,h real","u!=0","h!=0","u+h!=0"}];
check["reciprocal_increment_reject_u_zero",MissingQ[reciprocalIncrement[0,h]],{"u=0"}];
check["reciprocal_increment_reject_h_zero",MissingQ[reciprocalIncrement[u,0]],{"h=0"}];
check["reciprocal_increment_reject_u_plus_h_zero",MissingQ[reciprocalIncrement[u,-u]],{"u+h=0"}];
check["reciprocal_derivative_domain",Resolve[ForAll[u,Equivalent[FunctionDomain[1/u,u],u!=0]],Reals],{"domain R minus zero"}];
check["reciprocal_derivative",FullSimplify[D[1/u,u]==-1/u^2,Element[u,Reals]&&u!=0],{"u real and nonzero"}];
check["logarithm_real_domain",Resolve[ForAll[x,Equivalent[FunctionDomain[Log[x],x],x>0]],Reals],{"real logarithm x>0"}];
check["logarithm_inverse_domain",FullSimplify[Exp[Log[x]]==x,x>0],{"x positive real"}];
check["grid_inside",Resolve[ForAll[{a,b,n,k},Implies[a<=b&&n>0&&0<=k<=n,a<=a+k(b-a)/n<=b]],Reals],{"a<=b","N positive integer","0<=k<=N"}];
check["stationary_equivalence",Resolve[ForAll[{b,c,n},Implies[c!=0&&n!=0,Equivalent[b/n-c==0,n==b/c]]],Reals],{"b real","c,n nonzero real"}];
check["reciprocal_limit",FullSimplify[Limit[(1/(u+h)-1/u)/h,h->0,Assumptions->u>0]==-1/u^2,u>0],{"u>0","h tends to zero in punctured neighborhood"}];
check["logarithm_mal_chain",FullSimplify[Log[a n^b Exp[-c n]]==Log[a]+Log[n^b]+Log[Exp[-c n]]==Log[a]+b Log[n]-c n,a>0&&n>0&&Element[{b,c},Reals]],{"a,n positive real","b,c real"}];
check["integral_primitive_scaling",D[c ff[t],t]==c D[ff[t],t],{"c independent of t","ff a differentiable primitive"}];
check["integral_endpoint_scaling",Expand[c ff[tt]-c ff[0]-c(ff[tt]-ff[0])]==0,{"fundamental theorem hypotheses for ff on [0,T]","c real constant"}];
check["chain_reciprocal",D[1/y[n],n]==-y'[n]/y[n]^2,{"y differentiable at n","y[n]!=0"}];
check["logarithm_powers_sum",FullSimplify[Log[2,2^u 2^v]==u+v&&Log[2,2^u]+Log[2,2^v]==u+v,Element[{u,v},Reals]],{"u,v real","x=2^u","y=2^v"}];
check["composition_rearrangement_steps",Resolve[ForAll[{aa,cc,al,rr,ll,ell},Implies[ll!=0&&aa-ll ell==cc-al rr,-ll ell==cc-aa-al rr&&ll ell==al rr+aa-cc&&ell==(al rr+aa-cc)/ll&&(al rr+aa-cc)/ll==(al/ll)rr+(aa-cc)/ll]],Reals],{"real logarithm values aa,cc,rr","lambda nonzero"}];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And@@Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
