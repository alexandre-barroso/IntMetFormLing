ClearAll["Global`*"];
total[nil]=0;
total[cons[head_,tail_]]:=head+total[tail];
scaled[nil]=0;
scaled[cons[head_,tail_]]:=c*head+scaled[tail];
finiteSumInduction[left_,right_]:=Module[{base,hypothesisLeft,hypothesisRight,stepLeft,stepRight},If[!FreeQ[{left,right},head|tail],Return[False]];base=Expand[(left-right)/.xs->nil];hypothesisLeft=left/.xs->tail;hypothesisRight=right/.xs->tail;stepLeft=(left/.xs->cons[head,tail])/.hypothesisLeft->hypothesisRight;stepRight=right/.xs->cons[head,tail];TrueQ[base==0&&Expand[stepLeft-stepRight]==0]];
epsilonTransfer[tolerance_,margin_]:=TrueQ[FullSimplify[tolerance>0&&margin>0,Element[{epsilon,slack,m},Reals]&&epsilon>0&&slack>0&&m>=0]]&&TrueQ[Together[epsilon-m*(tolerance-slack)-margin]==0];
absoluteErrorIdentity[]:=TrueQ[FullSimplify[Abs[c*u-c*intValue]==Abs[c]*Abs[u-intValue],Element[{c,u,intValue},Reals]]];
scaleRiemannLimit[premise_,target_,tolerance_,margin_]:=Module[{integrand,interval,value},If[Length[premise]!=4||premise[[1]]!="riemann_tagged_sum_limit",Return[False]];{integrand,interval,value}=premise[[2;;4]];If[target=!={"riemann_tagged_sum_limit",{"scale",c,integrand},interval,c*value},Return[False]];finiteSumInduction[scaled[xs],c*total[xs]]&&absoluteErrorIdentity[]&&epsilonTransfer[tolerance,margin]];
source={"riemann_tagged_sum_limit",{"product","w","f_n"},{"0","T"},intValue};
target={"riemann_tagged_sum_limit",{"scale",c,{"product","w","f_n"}},{"0","T"},c*intValue};
tolerance=epsilon/(m+1);
margin=epsilon/(m+1)+m*slack;
results={};
check[name_,value_]:=If[TrueQ[value],AppendTo[results,<|"id"->name,"passed"->True|>],Print[name];Exit[1]];
check["total_nil",total[nil]==0];
check["total_cons",total[cons[head,tail]]==head+total[tail]];
check["scaled_nil",scaled[nil]==0];
check["scaled_cons",scaled[cons[head,tail]]==c*head+scaled[tail]];
check["finite_sum_linearity_induction",finiteSumInduction[scaled[xs],c*total[xs]]];
check["pointwise_scaled_product",Expand[(c*w)*f-c*(w*f)]==0];
check["tagged_contribution_scaling",Expand[((c*w)*f)*width-c*((w*f)*width)]==0];
check["absolute_error_factorization",absoluteErrorIdentity[]];
check["absolute_multiplier_nonnegative",FullSimplify[Abs[c]>=0,Element[c,Reals]]];
check["source_tolerance_positive",FullSimplify[tolerance>0,Element[{epsilon,m},Reals]&&epsilon>0&&m>=0]];
check["source_error_slack",Expand[tolerance-(tolerance-slack)-slack]==0&&FullSimplify[slack>0,Element[slack,Reals]&&slack>0]];
check["epsilon_transfer",epsilonTransfer[tolerance,margin]];
check["zero_scalar_included",Simplify[(margin/.m->0)-epsilon]==0];
check["riemann_integral_scaling",scaleRiemannLimit[source,target,tolerance,margin]];
check["wrong_sum_rejected",!finiteSumInduction[scaled[xs],total[xs]]];
check["wrong_base_rejected",!finiteSumInduction[scaled[xs],c*total[xs]+1]];
check["unscaled_tolerance_rejected",!epsilonTransfer[epsilon,epsilon-m*(epsilon-slack)]];
check["zero_tolerance_rejected",!epsilonTransfer[0,epsilon+m*slack]];
check["wrong_limit_rejected",!scaleRiemannLimit[source,{"riemann_tagged_sum_limit",target[[2]],target[[3]],intValue},tolerance,margin]];
check["changed_interval_rejected",!scaleRiemannLimit[source,{"riemann_tagged_sum_limit",target[[2]],{"0","2T"},c*intValue},tolerance,margin]];
Print[ExportString[<|"backend"->"Wolfram","scope"->"Assume g=w*f_n Riemann integrable on [0,T], T>=0: for every positive eta an appropriate mesh threshold makes |S(g)-I|<eta. Recursive finite-sum induction gives S(c*g)=c*S(g). With m=|c| and eta=epsilon/(m+1), slack=eta-|S(g)-I|>0; epsilon-|S(c*g)-c*I|=epsilon/(m+1)+m*slack>0. The same source mesh threshold proves the scaled integral by the tagged-sum limit definition, including c=0. No primitive or target linearity assumption is used.","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
