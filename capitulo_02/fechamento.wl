ClearAll["Global`*"];
results={};
check[name_,proposition_]:=If[TrueQ[proposition],AppendTo[results,<|"id"->name,"passed"->True|>],Print[{name,proposition}];Exit[1]];
check["addition_strict_order",Resolve[ForAll[{u,v,k},Implies[u<v,u+k<v+k]],Reals]];
check["addition_weak_order",Resolve[ForAll[{u,v,k},Implies[u<=v,u+k<=v+k]],Reals]];
check["positive_scaling_strict_order",Resolve[ForAll[{u,v,k},Implies[u<v&&k>0,k*u<k*v]],Reals]];
check["positive_scaling_weak_order",Resolve[ForAll[{u,v,k},Implies[u<=v&&k>0,k*u<=k*v]],Reals]];
check["negative_scaling_strict_order",Resolve[ForAll[{u,v,k},Implies[u<v&&k<0,k*v<k*u]],Reals]];
check["negative_scaling_weak_order",Resolve[ForAll[{u,v,k},Implies[u<=v&&k<0,k*v<=k*u]],Reals]];
check["decreasing_exponential_difference",FullSimplify[a*Exp[-lam*x]-a*Exp[-lam*(x+d)]==a*Exp[-lam*x]*(1-Exp[-lam*d]),Element[x,Reals]&&a>0&&lam>0&&d>0]];
check["decreasing_exponential_strict_order",And[FullSimplify[a*Exp[-lam*x]-a*Exp[-lam*(x+d)]==a*Exp[-lam*x]*(1-Exp[-lam*d]),Element[x,Reals]&&a>0&&lam>0&&d>0],FullSimplify[a*Exp[-lam*x]>0,Element[x,Reals]&&a>0&&lam>0],FullSimplify[1-Exp[-lam*d]>0,lam>0&&d>0],Resolve[ForAll[{u,v,p,q},Implies[p>0&&q>0&&u-v==p*q,v<u]],Reals]]];
check["growing_exponential_strict_order",And[FullSimplify[Exp[s*(x+d)]-Exp[s*x]==Exp[s*x]*(Exp[s*d]-1),Element[x,Reals]&&s>0&&d>0],FullSimplify[Exp[s*x]>0,Element[x,Reals]&&s>0],FullSimplify[Exp[s*d]-1>0,s>0&&d>0],Resolve[ForAll[{u,v,p,q},Implies[p>0&&q>0&&u-v==p*q,v<u]],Reals]]];
check["derivative_constant",D[c,x]==0];
check["derivative_sum",D[f[x]+g[x],x]==f'[x]+g'[x]];
check["derivative_constant_factor",D[c*f[x],x]==c*f'[x]];
check["derivative_composition",D[g[f[x]],x]==g'[f[x]]*f'[x]];
check["finite_probability_partition_bound",Resolve[ForAll[{p,q,r},Implies[p>=0&&q>=0&&r>=0&&p+q+r==1,0<=p+q<=1]],Reals]];
check["adjacent_integral_endpoint_cancellation",Expand[(fb-fa)+(fc-fb)]==fc-fa];
Print[ExportString[<|"backend"->"Wolfram","scope"->"quantified real order properties and symbolic exponential inequalities; formal differentiation identities whose analytic hypotheses are proved in Lean","checks"->Length[results],"passed"->True,"results"->results|>,"RawJSON"]];
Exit[0];
