results = {};
check[id_, condition_] := AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
keep[c_] := Piecewise[{{0,c<=5}},1];
check["keep_cases", Resolve[ForAll[c,Equivalent[keep[c]==0,c<=5]&&Equivalent[keep[c]==1,c>5]],Reals]];
check["affine_difference", Expand[m L2-m L1-m(L2-L1)]==0];
check["finite_rate", FullSimplify[(m L2-m L1)/(L2-L1)==m,L2!=L1]];
check["linear_increment_steps", FullSimplify[(m(L+h)-m L)/h==(m L+m h-m L)/h==m h/h==m,h!=0]];
check["power_product", FullSimplify[2^(u+v)==2^u*2^v,Element[{u,v},Reals]]];
check["logarithm_base_conversion", Log[2,x]==Log[x]/Log[2]];
check["logarithm_inverse", FullSimplify[2^Log[2,x]==x,x>0]];
check["logarithm_product", FullSimplify[Log[2,x*y]==Log[2,x]+Log[2,y],x>0&&y>0]];
check["logarithm_quotient", FullSimplify[Log[2,x/y]==Log[2,x]-Log[2,y],x>0&&y>0]];
check["logarithm_power", FullSimplify[Log[2,x^v]==v Log[2,x],x>0&&Element[v,Reals]]];
ratioValue=119275347/128700;
check["association_logarithm_bounds", 2^197<ratioValue^20<2^199 && 197/20<Log[2,ratioValue]<199/20];
check["association_logarithm_order", 9<Log[2,ratioValue]<10];
mal=a n^b Exp[-c n];
assumptions=a>0&&n>0&&Element[{b,c},Reals];
check["mal_logarithm", FullSimplify[Log[mal]==Log[a]+b Log[n]-c n,assumptions]];
check["mal_derivative_original", FullSimplify[D[mal,n]==mal(b/n-c),assumptions]];
check["mal_logarithmic_rate", FullSimplify[D[mal,n]/mal==b/n-c,assumptions]];
check["derivative_sign_before", Resolve[ForAll[{b,c,n},Implies[c<0&&n>0&&n<b/c,b/n-c<0]],Reals]];
check["derivative_sign_after", Resolve[ForAll[{b,c,n},Implies[c<0&&n>0&&b/c<n,0<b/n-c]],Reals]];
check["inverse_rate_sign", Resolve[ForAll[{d,y},Implies[y!=0,Equivalent[0<-d/y^2,d<0]&&Equivalent[-d/y^2<0,0<d]]],Reals]];
check["reciprocal_steps", FullSimplify[(1/(u+h)-1/u)/h==(u-(u+h))/(u(u+h)h)==-h/(u(u+h)h)==-1/(u(u+h)),u!=0&&h!=0&&u+h!=0]];
check["equal_partition_sum", FullSimplify[Sum[m L/count,{j,1,count}]==m L,count>0&&Element[count,Integers]]];
check["decreasing_reading_time", FullSimplify[-b/(p Log[2])<0,b>0&&p>0]];

check["zipf_logarithm",FullSimplify[Log[cc rr^(-aa)]==Log[cc]-aa Log[rr],cc>0&&rr>0&&Element[aa,Reals]]];
check["frequency_duration_logarithm",FullSimplify[Log[aa Exp[-ll ell]]==Log[aa]-ll ell,aa>0&&Element[{ll,ell},Reals]]];
check["frequency_duration_composition",FullSimplify[ell==(al/ll)Log[rr]+(Log[aa]-Log[cc])/ll,aa>0&&cc>0&&rr>0&&ll!=0&&Element[{al,ll,ell},Reals]&&Log[aa]-ll ell==Log[cc]-al Log[rr]]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->AllTrue[results,TrueQ[#["passed"]]&],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[TrueQ[report["passed"]],0,1]];
