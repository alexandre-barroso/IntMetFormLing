BeginPackage["Chapter02General`"];
ClearAll[Chapter02General`verifyCertificates];
If[!ValueQ[Chapter02General`$LibraryMode], Chapter02General`$LibraryMode=False];
Begin["`Private`"];
Block[{AnalysisProof`$LibraryMode=True}, Get[FileNameJoin[{DirectoryName[$InputFileName], "analise_geral.wl"}]]];
certificateGzipBase64 = "";
Chapter02General`verifyCertificates[] := Module[{report,check,results={}},
report=AnalysisProof`verifyProofGraph[ImportString[ImportByteArray[BaseDecode[certificateGzipBase64], {"GZIP", "Text"}], "RawJSON"]];
If[!TrueQ[report["passed"]],Return[report]];
check[id_,formula_,hypotheses_]:=AppendTo[results,<|"id"->id,"passed"->TrueQ[report["targets"][id]["formula"]===formula && Sort[report["targets"][id]["hypotheses"]]===Sort[hypotheses]],"formula"->formula,"hypotheses"->hypotheses|>];
check["addition_preserves_strict_order","|- ( A + C ) < ( B + C )",{"|- A < B","|- A e. RR","|- B e. RR","|- C e. RR"}];
check["addition_preserves_weak_order","|- ( A + C ) <_ ( B + C )",{"|- A <_ B","|- A e. RR","|- B e. RR","|- C e. RR"}];
check["positive_scaling_preserves_strict_order","|- ( C x. A ) < ( C x. B )",{"|- A < B","|- A e. RR","|- B e. RR","|- C e. RR+"}];
check["positive_scaling_preserves_weak_order","|- ( C x. A ) <_ ( C x. B )",{"|- A <_ B","|- A e. RR","|- B e. RR","|- C e. RR+"}];
check["negative_scaling_reverses_strict_order","|- ( C x. B ) < ( C x. A )",{"|- A < B","|- A e. RR","|- B e. RR","|- C < 0","|- C e. RR"}];
check["negative_scaling_reverses_weak_order","|- ( C x. B ) <_ ( C x. A )",{"|- A <_ B","|- A e. RR","|- B e. RR","|- C < 0","|- C e. RR"}];
check["decreasing_exponential","|- ( D x. ( exp ` -u ( C x. B ) ) ) < ( D x. ( exp ` -u ( C x. A ) ) )",{"|- A < B","|- A e. RR","|- B e. RR","|- C e. RR+","|- D e. RR+"}];
check["growing_exponential_factor","|- ( exp ` ( -u C x. A ) ) < ( exp ` ( -u C x. B ) )",{"|- A < B","|- A e. RR","|- B e. RR","|- C < 0","|- C e. RR"}];
check["negative_parameter_argument","|- 0 < ( -u C x. N )",{"|- C < 0","|- C e. RR","|- N e. RR+"}];
check["surprise_decreasing","|- ( -u ( log ` B ) / ( log ` 2 ) ) < ( -u ( log ` A ) / ( log ` 2 ) )",{"|- A < B","|- A e. RR+","|- B e. RR"}];
check["heaps_increasing","|- ( D x. ( A ^c C ) ) < ( D x. ( B ^c C ) )",{"|- 0 <_ A","|- A < B","|- A e. RR","|- B e. RR","|- C e. RR+","|- D e. RR+"}];
check["zipf_decreasing","|- ( D x. ( B ^c -u C ) ) < ( D x. ( A ^c -u C ) )",{"|- A < B","|- A e. RR+","|- B e. RR","|- C e. RR+","|- D e. RR+"}];
check["derivative_sum","|- C ( RR _D ( F oF + G ) ) ( K + L )",{"|- C ( RR _D F ) K","|- C ( RR _D G ) L","|- F : RR --> RR","|- G : RR --> RR"}];
check["derivative_composition","|- C ( RR _D ( F o. G ) ) ( K x. L )",{"|- ( G ` C ) ( RR _D F ) K","|- C ( RR _D G ) L","|- F : RR --> RR","|- G : RR --> RR"}];
check["derivative_constant","|- C ( RR _D ( RR X. { D } ) ) 0",{"|- C e. RR","|- D e. RR"}];
check["derivative_identity","|- C ( RR _D ( x e. RR |-> x ) ) 1",{"|- C e. RR"}];
check["derivative_scalar_factor","|- C ( RR _D ( ( RR X. { D } ) oF x. G ) ) ( D x. K )",{"|- C ( RR _D G ) K","|- C e. RR","|- D e. RR","|- G : RR --> RR","|- K e. RR"}];
check["heaps_sublinear_scale","|- ( D x. ( ( B x. A ) ^c C ) ) < ( B x. ( D x. ( A ^c C ) ) )",{"|- 1 < B","|- A e. RR+","|- B e. RR","|- C < 1","|- C e. RR","|- D e. RR+"}];
check["fractional_power_equation_general","|- ( ( A ^c ( M / N ) ) ^ N ) = ( A ^ M )",{"|- A e. RR+","|- M e. NN","|- N e. NN"}];
check["fractional_power_unique_general","|- Z = ( A ^c ( M / N ) )",{"|- ( Z ^ N ) = ( A ^ M )","|- A e. RR+","|- M e. NN","|- N e. NN","|- Z e. RR+"}];
AssociateTo[report,{"checks"->Length[results],"results"->results,"passed"->And@@Lookup[results,"passed"]}];report];
If[!TrueQ[Chapter02General`$LibraryMode] && Length[$ScriptCommandLine]>0 && ExpandFileName[First[$ScriptCommandLine]]===ExpandFileName[$InputFileName], report=Chapter02General`verifyCertificates[]; Print[ExportString[KeyDrop[report,{"targets"}],"RawJSON"]];Exit[If[TrueQ[report["passed"]],0,1]]];
End[];
EndPackage[];
