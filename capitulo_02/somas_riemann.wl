results={};
check[id_,condition_] := AppendTo[results,<|"id"->id,"passed"->TrueQ[condition]|>];
grid[k_] := a+k length/nn;
check["grid_start",grid[0]==a];
check["grid_finish",Together[grid[nn]-(a+length)]==0];
check["grid_step",Together[grid[k+1]-grid[k]-length/nn]==0];
check["grid_monotone",FullSimplify[length/nn>0,length>0 && nn>0]];
check["grid_inside",Resolve[ForAll[{a,length,nn,k},Implies[length>0 && nn>0 && 0<=k<=nn,a<=grid[k]<=a+length]],Reals]];
check["partition_integral_base",f0-f0==0];
check["partition_integral_step",Expand[(fn-f0)+(fn1-fn)-(fn1-f0)]==0];
check["partition_triangle",Resolve[ForAll[{x,y},Abs[x+y]<=Abs[x]+Abs[y]],Reals]];
check["partition_error_step",Expand[eta w0+eta w1-eta(w0+w1)]==0];
check["right_sum_widths",FullSimplify[Sum[length/nn,{k,1,nn}]==length,Element[nn,Integers] && nn>0]];
check["right_sum_epsilon",Together[(epsilon/(2length))*length-epsilon/2]==0];
check["right_sum_mesh",FullSimplify[delta-length/(length/delta+excess)>0,length>0 && delta>0 && excess>0]];
rightSum[f_,n_] := Sum[f[a+k length/n]length/n,{k,1,n}];
check["right_sum_definition",rightSum[f,nn]==Sum[f[a+k length/nn]length/nn,{k,1,nn}]];
check["weighted_right_sum_definition",rightSum[Function[t,w[t]f[t]],nn]==Sum[w[a+k length/nn]f[a+k length/nn]length/nn,{k,1,nn}]];
check["tagged_cell_membership",Resolve[ForAll[{a,length,nn,k,theta},Implies[length>0&&nn>0&&0<=theta<=1,grid[k]<=grid[k]+theta length/nn<=grid[k+1]]],Reals]];
check["tagged_distance",Resolve[ForAll[{length,nn,theta,phi},Implies[length>0&&nn>0&&0<=theta<=1&&0<=phi<=1,Abs[(theta-phi)length/nn]<=length/nn]],Reals]];
report=<|"backend"->"Wolfram","checks"->Length[results],"passed"->And @@ Lookup[results,"passed"],"results"->results|>;
Print[ExportString[report,"RawJSON"]];
Exit[If[report["passed"],0,1]];
